   {f:'h1',t:'t2',l:'approve',k:'person'}]}};

var WFGROUPS={Planning:{i:'◎',d:'Coverage, exceptions and what reaches a planner.'},
 Buying:{i:'⇄',d:'Requisitions, purchase orders and the vendor door.'},
 Service:{i:'☺',d:'Claims, customer promises and honest options.'},
 Policy:{i:'⚖',d:'How the numbers that judge every case are allowed to move.'}};

/* ---- AI assembler: a flow we have not drawn yet ---- */
function assembleFlow(q){
  var topic=q.replace(/^(build|make|show|draw)\s+(me\s+)?(a|the)?\s*/i,'').replace(/\bflow\b/gi,'').trim()||'this process';
  topic=topic.charAt(0).toUpperCase()+topic.slice(1);
  var id='gen-'+Date.now();
  WFS[id]={name:topic,group:'Assembled',owner:'assembled by the agent',generated:true,
   sub:'Assembled from the steps, gates and authorities already in your policy — not yet a drawn flow',
   nodes:[
    {id:'s0',x:376,y:16,k:'start',t:'Signal arrives',d:'Whatever starts '+topic.toLowerCase()+' — a document, a threshold breach, or a customer message.'},
    {id:'a1',x:376,y:130,k:'ai',t:'Assess against the record',d:'The owning agent reads the systems it is scoped to and separates verified facts from assumptions.',meta:'gen.assess',
     auth:'Read scopes only. Nothing is written at this step.',
     qs:['Which systems would it read?','What would it treat as an assumption?']},
    {id:'g1',x:376,y:300,k:'gate',t:'Inside every limit?',d:'The same three tests every flow uses: value, movement size, and the confidence floor.',
     badge:'CONF_FLOOR',expr:'value ≤ limit\n  AND movement ≤ band\n  AND confidence ≥ CONF_FLOOR',
     auth:'Read live from Governance — this flow inherits the same numbers as the rest.',
     qs:['Which limit would bind first here?','Who owns that number?']},
    {id:'t1',x:44,y:470,k:'term',t:'→ Executes and verifies',d:'Written to the system of record and only counted once it confirms.',
     auth:'Inside the owning agent’s scope.'},
    {id:'h1',x:700,y:470,k:'human',t:'A person decides',d:'A bounded packet: the recommendation, the alternatives, and the cost of waiting.',badge:'Owner',
     auth:'Whoever owns the limit that was crossed.',
     qs:['Who would that be for this flow?','What does the packet contain?']},
    {id:'t2',x:376,y:672,k:'term',t:'→ Outcome and reason logged',d:'The result, and any human reason, chain into the audit trail and feed learning.',
     auth:'Automatic. Reasons are mandatory on override and reject.'}],
   edges:[{f:'s0',t:'a1',k:'expr'},{f:'a1',t:'g1',k:'llm'},
    {f:'g1',t:'t1',l:'inside',k:'expr'},{f:'g1',t:'h1',l:'outside',k:'expr'},
    {f:'t1',t:'t2',k:'expr'},{f:'h1',t:'t2',l:'decided',k:'person'}]};
  return id;
}

/* ---- entry ---- */
function renderWFEntry(){
  var counts={};Object.keys(WFS).forEach(function(k){var g=WFS[k].group;counts[g]=(counts[g]||0)+1});
  $('wfGroups').innerHTML=Object.keys(WFGROUPS).map(function(g){
    var n=counts[g]||0;
    return '<button class="gcard" onclick="wfBoard(\''+g+'\')"><div class="gi">'+WFGROUPS[g].i+'</div>'+
      '<h4>'+g+'</h4><p>'+WFGROUPS[g].d+'</p>'+
      '<div class="gf"><span class="pill nu">'+n+' flow'+(n===1?'':'s')+'</span></div></button>';
  }).join('');
}
function wfHome(){$('w-entry').classList.add('on');$('w-board').classList.remove('on')}
function wfBoard(group){
  $('w-entry').classList.remove('on');$('w-board').classList.add('on');
  if(group){var f=Object.keys(WFS).filter(function(k){return WFS[k].group===group})[0];if(f)S.wf=f}
  renderWF();requestAnimationFrame(function(){wfFit()});
}
function wfAskEx(q){$('wfAsk').value=q;$('wfq').value=q;wfAskGo()}
function wfAskGo(){
  var q=(($('wfAsk').value||$('wfq').value)||'').toLowerCase().trim();
  if(!q){toast('Describe the flow you want to see.');return}
  var hit=null;
  Object.keys(WFS).forEach(function(k){
    if(hit)return;
    var hay=(WFS[k].name+' '+WFS[k].sub+' '+WFS[k].group+' '+WFS[k].owner).toLowerCase();
    var words=q.split(/\s+/).filter(function(w){return w.length>3});
    if(words.some(function(w){return hay.indexOf(w)>-1}))hit=k;
  });
  if(!hit&&/never|alone|without a person/.test(q))hit='threshold';
  var note=$('wfNote');
  if(hit){
    S.wf=hit;note.hidden=false;
    note.textContent='Closest drawn flow: '+WFS[hit].name+'.';
  }else{
    S.wf=assembleFlow(q);note.hidden=false;
    note.textContent='No drawn flow matched — the agent assembled one from your existing steps, gates and authorities. Nothing here is invented policy.';
  }
  $('wfq').value=q;
  wfBoard();
}

/* ---- library ---- */
function renderWFLib(){
  var q=($('wfq').value||'').toLowerCase().trim();
  var keys=Object.keys(WFS).filter(function(k){
    if(!q)return true;
    return (WFS[k].name+' '+WFS[k].sub+' '+WFS[k].group).toLowerCase().indexOf(q)>-1||k===S.wf;
  });
  var groups={};keys.forEach(function(k){(groups[WFS[k].group]=groups[WFS[k].group]||[]).push(k)});
  $('wfLib').innerHTML=Object.keys(groups).map(function(g){
    return '<div class="lib-group">'+g+'</div>'+groups[g].map(function(k){
      var w=WFS[k];
      var ai=w.nodes.filter(function(n){return n.k==='ai'}).length;
      var hu=w.nodes.filter(function(n){return n.k==='human'}).length;
      return '<button class="lib-item'+(S.wf===k?' on':'')+(w.generated?' gen':'')+'" onclick="pickWF(\''+k+'\')">'+
        '<span class="lib-name">'+esc(w.name)+'</span>'+
        '<span class="lib-meta">'+esc(w.owner)+' · '+ai+' AI · '+hu+' human</span></button>';
    }).join('');
  }).join('')||'<div class="lib-group">Nothing matched</div>';
}
function pickWF(k){S.wf=k;S.wfSel=null;renderWF();wfFit()}

/* ---- graph ---- */
function renderWF(){
  renderWFLib();
  var w=WFS[S.wf];if(!w)return;
  $('cvTitle').textContent=w.name;
  $('cvSub').textContent=w.sub;
  var ai=w.nodes.filter(function(n){return n.k==='ai'}).length;
  var hu=w.nodes.filter(function(n){return n.k==='human'}).length;
  var ex=w.edges.filter(function(e){return e.k==='expr'}).length;
  var lm=w.edges.filter(function(e){return e.k==='llm'}).length;
  var au=w.nodes.filter(function(n){return n.auth}).length;
  $('cvStats').innerHTML=[[ai,'AI steps'],[hu,'human gates'],[ex,'expression edges'],[lm,'agent judgement'],[au,'authorities']]
    .map(function(s){return '<div><div class="stat-v">'+s[0]+'</div><div class="stat-l">'+s[1]+'</div></div>'}).join('');
  $('wfNodes').innerHTML=w.nodes.map(function(n){
    var cls='wnode '+(n.k==='human'?'human':n.k==='ai'?'ai':n.k==='term'?'term':n.k==='start'?'term':'')+(S.wfSel===n.id?' sel':'');
    var ico=n.k==='gate'?'◇':n.k==='human'?'⚑':n.k==='ai'?'✦':n.k==='start'?'▶':n.k==='term'?'⊖':'▪';
    if(n.k==='term'||n.k==='start'){
      return '<button class="'+cls+'" style="left:'+n.x+'px;top:'+n.y+'px" data-n="'+n.id+'" onclick="selWF(\''+n.id+'\')">'+
        '<span class="ni">'+ico+'</span><span class="nt">'+esc(n.t)+'</span></button>';
    }
    return '<button class="'+cls+'" style="left:'+n.x+'px;top:'+n.y+'px" data-n="'+n.id+'" onclick="selWF(\''+n.id+'\')">'+
      '<span class="nh"><span class="ni">'+ico+'</span><span class="nt">'+esc(n.t)+'</span></span>'+
      (n.d?'<span class="nd">'+esc(n.d)+'</span>':'')+
      ((n.badge||n.meta)?'<span class="nf">'+(n.badge?'<span class="nbadge'+(n.k==='human'?' hot':'')+'">'+esc(n.badge)+'</span>':'')+
        (n.meta?'<span class="nmeta">'+esc(n.meta)+'</span>':'')+'</span>':'')+
      '</button>';
  }).join('');
  requestAnimationFrame(drawWFWires);
  if(S.wfSel)renderWFInsp(S.wfSel);else renderWFEmpty();
  renderWFAsk();
}
function drawWFWires(){
  var stage=$('wfStage'),svg=$('wfWires');if(!stage||!svg)return;
  var w=WFS[S.wf];if(!w)return;
  stage.querySelectorAll('.elabel').forEach(function(e){e.remove()});
  var box={};
  w.nodes.forEach(function(n){
    var el=stage.querySelector('[data-n="'+n.id+'"]');
    if(el)box[n.id]={x:n.x,y:n.y,w:el.offsetWidth,h:el.offsetHeight};
  });
  var d='',labels=[];
  w.edges.forEach(function(e){
    var a=box[e.f],b=box[e.t];if(!a||!b)return;
    var x1,y1,x2,y2,path;
    if(e.k==='loop'){
      x1=a.x+a.w;y1=a.y+a.h/2;x2=b.x+b.w;y2=b.y+b.h/2;
      var off=Math.max(a.x+a.w,b.x+b.w)+64;
      path='M'+x1+' '+y1+' C'+off+' '+y1+', '+off+' '+y2+', '+x2+' '+y2;
      labels.push({x:off-6,y:(y1+y2)/2,l:e.l,k:e.k});
    }else if(Math.abs((a.x+a.w/2)-(b.x+b.w/2))<30){
      x1=a.x+a.w/2;y1=a.y+a.h;x2=b.x+b.w/2;y2=b.y;
      var k=Math.max(14,(y2-y1)*.45);
      path='M'+x1+' '+y1+' C'+x1+' '+(y1+k)+', '+x2+' '+(y2-k)+', '+x2+' '+y2;
      if(e.l)labels.push({x:(x1+x2)/2,y:(y1+y2)/2,l:e.l,k:e.k});
    }else{
      x1=a.x+a.w/2;y1=a.y+a.h;x2=b.x+b.w/2;y2=b.y;
      var mid=y1+Math.max(26,(y2-y1)*.45);
      path='M'+x1+' '+y1+' C'+x1+' '+mid+', '+x2+' '+(y2-(y2-mid)*.6)+', '+x2+' '+y2;
      if(e.l)labels.push({x:(x1+x2)/2,y:y1+(y2-y1)*.42,l:e.l,k:e.k});
    }
    d+='<path class="'+(e.k==='person'?'person':e.k==='llm'?'llm':e.k==='loop'?'loop':'')+'" d="'+path+'"/>';
  });
  svg.innerHTML=d;
  labels.forEach(function(l){
    if(!l.l)return;
    var e=document.createElement('span');
    e.className='elabel '+(l.k==='person'||l.k==='loop'?'person':l.k==='llm'?'llm':'');
    e.textContent=l.l;e.style.left=l.x+'px';e.style.top=l.y+'px';
    stage.appendChild(e);
  });
}
function selWF(id){
  S.wfSel=id;
  document.querySelectorAll('#wfNodes .wnode').forEach(function(n){n.classList.toggle('sel',n.dataset.n===id)});
  renderWFInsp(id);rpTab('det');
}
function renderWFEmpty(){
  var w=WFS[S.wf];
  $('rp-det').innerHTML='<div class="i-title">'+esc(w.name)+'</div>'+
    '<div class="i-desc">'+esc(w.sub)+'.</div>'+
    (w.generated?'<div class="i-lab">Assembled, not drawn</div><div class="i-auth">The agent built this from steps, gates and authorities that already exist in your policy. Every number still comes from Governance — nothing here is invented.</div>':'')+
    '<div class="i-lab">How to read it</div>'+
    '<div class="i-empty">Select a node to see <b>its condition</b>, <b>the authority that permits it</b>, and <b>the questions it answers</b>. '+
    'Grey edges are expressions, blue edges are a person deciding, amber edges are agent judgement.</div>';
}
function renderWFInsp(id){
  var w=WFS[S.wf];
  var n=w.nodes.filter(function(x){return x.id===id})[0];if(!n)return;
  var kind={gate:'Gate · a rule people set',ai:'Agent judgement',human:'A person decides',
    term:'Where it ends up',start:'Where it starts',step:'Executed step'}[n.k]||'Step';
  var h='<div class="i-title">'+esc(n.t)+'</div>'+
    '<div class="i-desc">'+esc(n.d||'')+'</div>'+
    '<div class="i-lab">'+kind+'</div>';
  if(n.expr){
    h+='<div class="i-lab" style="margin-top:8px">The condition</div><code class="i-expr">'+esc(n.expr)+'</code>';
    if(n.badge)h+='<div class="i-src">'+esc(n.badge)+' · read live from Governance '+GOV.ver.split(' ')[0]+'</div>';
  }
  if(n.auth)h+='<div class="i-lab">The authority that permits it</div><div class="i-auth">'+esc(n.auth)+'</div>';
  var outs=w.edges.filter(function(e){return e.f===id});
  if(outs.length){
    h+='<div class="i-lab">Where it can go</div>'+outs.map(function(e){
      var to=w.nodes.filter(function(x){return x.id===e.t})[0];
      var kn=e.k==='person'?'person decides':e.k==='llm'?'agent judgement':e.k==='loop'?'returns here':'expression';
      return '<div class="i-branch '+(e.k==='person'||e.k==='loop'?'person':e.k==='llm'?'llm':'')+'">'+
        '<div class="i-btop"><span class="i-blabel">'+esc(e.l||'continues')+'</span>'+
        '<span class="i-bkind">'+kn+'</span></div>'+
        '<div style="font-size:11.5px;color:var(--muted-foreground);line-height:1.45">→ '+esc(to?to.t:e.t)+'</div></div>';
    }).join('');
  }
  if(n.qs&&n.qs.length){
    h+='<div class="i-lab">Questions it answers</div>'+n.qs.map(function(q){
      return '<div class="i-q">'+esc(q)+'</div>'}).join('');
  }
  if(n.badge&&n.expr){
    h+='<div style="margin-top:14px"><button class="btn w" onclick="nav(\'govern\');gvTab(\'auth\')">Open this number in Governance →</button></div>';
  }
  $('rp-det').innerHTML=h;
}
function renderWFAsk(){
  $('rp-ask').innerHTML='<div class="i-desc" style="margin-top:0">Ask about this flow — every answer comes from the records this flow is drawn from.</div>'+
    ['Where do cases stall most?','Who can change these gates?','What never runs unattended?','How often does each gate hold something?']
    .map(function(q){return '<button class="btn w" style="margin-top:8px;justify-content:flex-start;text-align:left" onclick="wfAnswer(\''+q.replace(/'/g,"\\'")+'\')">'+q+'</button>'}).join('');
}
function wfAnswer(q){
  var a=/stall/.test(q)?'The human steps hold the clock: the planner decision runs a median 2h 08m and the customer choice 19h. Every agent step on this flow completes in seconds.'
    :/change/.test(q)?'Only the policy owner. Any gate change is replayed against 90 days in Governance, gets a version number, and cascades on the next run — never mid-flight.'
    :/unattended/.test(q)?'Three doors never open on their own: customer credit above the claim limit, vendor termination, and product substitution — the customer decides that one. No threshold opens them.'
    :'Across the last 90 days the PR limit held 19 requisitions, the vendor gate held 4, and the confidence floor held 11. The confidence floor is the one that rarely binds — value is what usually stops a case.';
  openDrawer('<div class="dr-k">'+esc(WFS[S.wf].name)+'</div><div class="dr-t">'+esc(q)+'</div><div class="dr-s">'+a+'</div>'+
    '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap"><button class="btn" onclick="closeAll();nav(\'govern\')">Open Governance</button>'+
    '<button class="btn" onclick="closeAll();nav(\'audit\')">See the records</button></div>');
}
function rpTab(r){
  document.querySelectorAll('.rp-tab').forEach(function(t){t.classList.toggle('on',t.dataset.r===r)});
  ['det','ask'].forEach(function(k){$('rp-'+k).classList.toggle('on',k===r)});
}
/* ---- pan + zoom ---- */
function wfApply(){
  var st=$('wfStage');if(!st)return;
  st.style.transform='translate('+S.wfx+'px,'+S.wfy+'px) scale('+S.wfz+')';
  var c=$('wfCanvas');if(c)c.style.backgroundPosition=S.wfx+'px '+S.wfy+'px';
  var z=$('wfzv');if(z)z.textContent=Math.round(S.wfz*100)+'%';
}
function wfZoom(dir,cx,cy){
  var c=$('wfCanvas');if(!c)return;
  var old=S.wfz,nz=Math.min(1.8,Math.max(.35,old*(dir>0?1.12:1/1.12)));
  var r=c.getBoundingClientRect();
  cx=(cx==null?r.width/2:cx);cy=(cy==null?r.height/2:cy);
  S.wfx=cx-(cx-S.wfx)*(nz/old);S.wfy=cy-(cy-S.wfy)*(nz/old);S.wfz=nz;wfApply();
}
function wfFit(){
  var c=$('wfCanvas');if(!c||!c.clientWidth)return;
  var w=WFS[S.wf];if(!w)return;
  var maxX=0;
  w.nodes.forEach(function(n){maxX=Math.max(maxX,n.x+(n.k==='term'||n.k==='start'?220:280))});
  /* fit the width like a board — you pan down for the rest */
  var z=Math.min(1,Math.max(.55,(c.clientWidth-48)/maxX));
  S.wfz=z;S.wfx=Math.max(12,(c.clientWidth-maxX*z)/2);S.wfy=14;wfApply();
}
function wfLibToggle(){var s=$('wfShell');if(!s)return;s.classList.toggle('no-lib');
  setTimeout(function(){wfFit()},200)}
function wfInspToggle(){var s=$('wfShell');if(!s)return;s.classList.toggle('no-insp');
  setTimeout(function(){wfFit()},200)}
(function(){
  var c=$('wfCanvas');if(!c)return;
  var drag=null;
  c.addEventListener('pointerdown',function(e){
    if(e.target.closest('.wnode,.zstack'))return;
    drag={x:e.clientX,y:e.clientY,bx:S.wfx,by:S.wfy};
    c.classList.add('grabbing');try{c.setPointerCapture(e.pointerId)}catch(_){}
  });
  c.addEventListener('pointermove',function(e){if(!drag)return;
    S.wfx=drag.bx+(e.clientX-drag.x);S.wfy=drag.by+(e.clientY-drag.y);wfApply()});
  function end(){drag=null;c.classList.remove('grabbing')}
  c.addEventListener('pointerup',end);c.addEventListener('pointercancel',end);
  c.addEventListener('wheel',function(e){e.preventDefault();
    var r=c.getBoundingClientRect();
    if(e.ctrlKey){ // trackpad pinch (macOS) / ctrl+scroll → zoom at cursor
      var f=Math.exp(-e.deltaY*0.01),old=S.wfz,nz=Math.min(1.8,Math.max(.35,old*f));
      var cx=e.clientX-r.left,cy=e.clientY-r.top;
      S.wfx=cx-(cx-S.wfx)*(nz/old);S.wfy=cy-(cy-S.wfy)*(nz/old);S.wfz=nz;wfApply();
    }else{ // two-finger scroll → pan the board, like Figma
      S.wfx-=e.deltaX;S.wfy-=e.deltaY;wfApply();
    }},{passive:false});
})();

