<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Navanta Agent Experience</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
<style>
/* ===== Navanta Design System tokens (@navanta-ai/design-system) ===== */
:root{
  --background:#ffffff; --foreground:#09090b; --card:#ffffff;
  --primary:#232122; --primary-foreground:#ffffff;
  --secondary:#f4f4f5; --muted-foreground:#4b5563;
  --destructive:#dc2626; --success:#16a34a; --warning:#f59e0b; --info:#0ea5e9;
  --border:#e4e4e7; --input:#d4d4d8; --ring:#c4c4c8;
  --radius-md:.375rem; --radius-xl:.75rem;
  --brand:#6440b6; --brand-deep:#3b0764;
  --surface-grey:#fafafa; --surface-hover:#f4f4f5;
  --surface-accent:color-mix(in oklab,#6440b6 10%,#fff);
  --text-neutral:#6b7280; --text-link:#005b89;
  --border-light:#f1f3f5; --border-strong:#71717b;
  --switch-on:#0087ce; --switch-off:rgba(60,60,67,.3);
  --pill-info-bg:#eff6ff; --pill-info-fg:#1e40af;
  --pill-danger-bg:#fff1f2; --pill-danger-fg:#a7000f;
  --pill-warning-bg:#fffbeb; --pill-warning-fg:#92400e;
  --pill-neutral-bg:#f4f4f5; --pill-neutral-fg:#18181b;
  --pill-success-bg:#f0fdf4; --pill-success-fg:#166534;
  --shadow-card:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);
  --shadow-menu:0 4px 6px -1px rgb(0 0 0/.1),0 2px 4px -2px rgb(0 0 0/.1);
  --shadow-modal:0 20px 25px -5px rgb(0 0 0/.1),0 8px 10px -6px rgb(0 0 0/.1);
  --gradient-brand:linear-gradient(135deg,#6440b6 0%,#3b0764 100%);
  --gradient-christy:linear-gradient(154.42deg,#1d4a86 1.66%,#3d348b 83.4%);
  --progress-track:#e4e4e7;
  --gp-blue:linear-gradient(90deg,#89a9e5 0%,#89a9e5 54%,#234687 100%);
  --gp-green:linear-gradient(90deg,#86efac 0%,#86efac 54%,#166534 100%);
  --mercer:#6440b6; --iris:#00648f; --christy:#3d348b;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#f4f4f5}
body{font-family:'Geist',-apple-system,BlinkMacSystemFont,sans-serif;color:var(--foreground);
  font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
.mono{font-family:'Geist Mono',ui-monospace,monospace}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--ring);outline-offset:2px;border-radius:var(--radius-md)}

/* ===== shell ===== */
.app{max-width:1560px;margin:0 auto;min-height:100vh;background:var(--background);
  box-shadow:0 0 0 1px var(--border);display:flex;flex-direction:column}
.top{background:var(--background);border-bottom:1px solid var(--border);padding:0 26px;
  display:flex;align-items:center;gap:20px;position:sticky;top:0;z-index:40}
.brand{display:flex;align-items:center;gap:11px;padding:13px 0}
.mk{width:30px;height:30px;border-radius:8px;background:var(--gradient-brand);
  color:#fff;font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center}
.bt{font-size:15px;font-weight:600;letter-spacing:-.01em;line-height:1.2}
.bs{font-size:11px;color:var(--muted-foreground)}
.ptabs{display:flex;gap:18px;margin-left:16px;align-self:stretch}
.ptab{border:0;background:none;font-size:13.5px;font-weight:500;color:var(--muted-foreground);
  padding:0 2px;position:relative;display:flex;align-items:center}
.ptab::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:3px;border-radius:3px 3px 0 0;background:transparent}
.ptab:hover{color:var(--foreground)}
.ptab.on{color:var(--foreground);font-weight:600}
.ptab.on::after{background:var(--primary)}
.top-r{margin-left:auto;display:flex;align-items:center;gap:14px}
.live{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted-foreground)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.pol{font-family:'Geist Mono',monospace;font-size:11px;color:var(--muted-foreground);
  background:var(--secondary);padding:3px 9px;border-radius:5px;border:0;cursor:pointer}
.pol:hover{background:var(--surface-hover);color:var(--foreground)}
.view{display:none}.view.on{display:block;animation:fade .18s ease}
@keyframes fade{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
.body{padding:20px 26px 44px;flex:1}

/* ===== primitives ===== */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);box-shadow:var(--shadow-card)}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;
  padding:2px 9px;border-radius:9999px;white-space:nowrap}
.pill.warn{background:var(--pill-warning-bg);color:var(--pill-warning-fg)}
.pill.dng{background:var(--pill-danger-bg);color:var(--pill-danger-fg)}
.pill.ok{background:var(--pill-success-bg);color:var(--pill-success-fg)}
.pill.info{background:var(--pill-info-bg);color:var(--pill-info-fg)}
.pill.nu{background:var(--pill-neutral-bg);color:var(--pill-neutral-fg)}
.pill.br{background:var(--surface-accent);color:var(--brand)}
.btn{border:1px solid var(--border);background:var(--background);color:var(--foreground);
  font-size:12.5px;font-weight:500;height:32px;padding:0 14px;border-radius:var(--radius-md);
  display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap}
.btn:hover{background:var(--surface-hover)}
.btn.pr{background:var(--primary);border-color:var(--primary);color:var(--primary-foreground)}
.btn.pr:hover{background:#000}
.btn.dng{border-color:#fecaca;color:var(--destructive)}
.btn.dng:hover{background:var(--pill-danger-bg)}
.btn.sm{height:26px;padding:0 10px;font-size:11.5px}
.btn.w{width:100%}
.btn:disabled{opacity:.55;cursor:default}
.lab{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:10px}
.kv{display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.kv:last-child{border-bottom:0}
.kv span{color:var(--muted-foreground)}
.kv b{font-family:'Geist Mono',monospace;font-weight:500;text-align:right;font-size:12px;font-variant-numeric:tabular-nums}
.seg{display:flex;background:var(--secondary);border-radius:9px;padding:3px}
.seg button{border:0;background:none;font-size:12.5px;font-weight:500;color:var(--muted-foreground);padding:6px 16px;border-radius:7px}
.seg button.on{background:var(--background);color:var(--foreground);font-weight:600;box-shadow:var(--shadow-card)}
.tabsrow{display:flex;gap:18px;border-bottom:1px solid var(--border);margin-bottom:16px}
.tabsrow button{border:0;background:none;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  color:var(--text-neutral);padding:0 2px 10px;position:relative}
.tabsrow button::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:transparent}
.tabsrow button.on{color:var(--foreground)}
.tabsrow button.on::after{background:var(--primary)}
.tpane{display:none}.tpane.on{display:block;animation:fade .18s ease}
.av{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;
  font-weight:600;font-size:13px;color:#fff;flex:0 0 auto}
.note{font-size:11.5px;line-height:1.55;color:var(--muted-foreground);
  background:var(--surface-grey);border:1px solid var(--border-light);border-radius:8px;padding:11px 13px}
.note b{color:var(--foreground)}
.warncard{font-size:11.5px;line-height:1.55;color:var(--pill-warning-fg);
  background:var(--pill-warning-bg);border:1px solid #f0dcae;border-radius:8px;padding:11px 13px}
.linky{border:0;background:none;font-size:11.5px;font-weight:500;color:var(--text-link);padding:0;cursor:pointer}
.linky:hover{text-decoration:underline}
.hash{font-family:'Geist Mono',monospace;font-size:10px;color:var(--text-neutral);
  background:var(--secondary);border-radius:4px;padding:1px 6px}

/* ===== tower · today ===== */
.subbar{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.statusstrip{display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--muted-foreground)}
.statusstrip .sd{display:flex;align-items:center;gap:7px}
.statusstrip .sd i{width:7px;height:7px;border-radius:50%;background:var(--success)}
.statusstrip .sd.w i{background:var(--warning)}
.statusstrip .sd.f i{background:var(--input)}
.statusstrip b{font-weight:600;color:var(--foreground)}
.statusstrip .div{width:1px;height:14px;background:var(--border)}
.tower-split{display:grid;grid-template-columns:minmax(0,1fr) 344px;gap:16px;align-items:start}
.askpanel{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:16px 18px;box-shadow:var(--shadow-card);margin-bottom:18px}
.askpanel .ah{display:flex;align-items:center;gap:9px;margin-bottom:12px}
.askpanel .ah .sp{width:22px;height:22px;border-radius:7px;background:var(--gradient-brand);color:#fff;
  display:flex;align-items:center;justify-content:center;font-size:12px}
.askpanel .ah h3{font-size:15px;font-weight:600;letter-spacing:-.01em}
.askpanel .ai{display:flex;gap:9px}
.askpanel input{flex:1;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;
  font-size:13.5px;padding:10px 13px;color:var(--foreground);min-width:0}
.askpanel input:focus{outline:none;border-color:var(--brand)}
.askpanel .ac{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.askpanel .ac button{border:1px solid var(--border);background:var(--surface-grey);border-radius:9999px;
  font-size:11.5px;padding:5px 12px;color:var(--muted-foreground)}
.askpanel .ac button:hover{border-color:var(--brand);color:var(--brand)}
.workband{border:1px solid var(--border);border-radius:var(--radius-xl);padding:14px;background:var(--surface-grey);margin-bottom:18px}
.workband .wl{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:11px}
.agcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(212px,1fr));gap:11px}
.agc{background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-card);
  overflow:hidden;text-align:left;width:100%;font-family:inherit;color:inherit;display:flex;flex-direction:column;cursor:pointer}
.agc:hover{border-color:var(--border-strong)}
.agc .tab{background:var(--ac);color:#fff;font-size:10.5px;font-weight:600;padding:4px 11px;
  border-radius:0 0 9px 0;align-self:flex-start}
.agc .cb{padding:11px 13px 12px;display:flex;flex-direction:column;flex:1}
.agc h4{font-size:13.5px;font-weight:600;line-height:1.3;margin-bottom:7px;letter-spacing:-.005em}
.agc .stpill{align-self:flex-start;margin-bottom:10px}
.agc .mini{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:6px}
.agc .mrow{display:flex;gap:14px;margin-bottom:10px}
.agc .mrow b{display:block;font-family:'Geist Mono',monospace;font-size:17px;font-weight:500;line-height:1.15;font-variant-numeric:tabular-nums}
.agc .mrow span{font-size:9.5px;color:var(--text-neutral)}
.agc .hbar{height:5px;border-radius:3px;background:var(--progress-track);overflow:hidden;margin-bottom:9px}
.agc .hbar i{display:block;height:100%;border-radius:3px;background:var(--gp-blue)}
.agc .ft{margin-top:auto;padding-top:10px;border-top:1px solid var(--border-light);
  display:flex;align-items:center;gap:8px;font-size:10.5px;color:var(--text-neutral)}
.agc .ft .lk{margin-left:auto;color:var(--text-link);font-weight:600;font-size:11.5px}
.agc.paused{background:var(--surface-grey)}
.agc.paused .tab{background:var(--input)}
.sw{position:relative;width:36px;height:21px;border-radius:9999px;background:var(--switch-on);border:0;flex:0 0 auto}
.sw::after{content:'';position:absolute;top:2px;left:17px;width:17px;height:17px;border-radius:50%;background:#fff;
  box-shadow:0 1px 2px rgba(0,0,0,.25);transition:left .2s}
.sw.off{background:var(--switch-off)}
.sw.off::after{left:2px}
.nrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:13px 18px;border-bottom:1px solid var(--border-light)}
.nrow:last-child{border-bottom:0}
.nrow:hover{background:var(--surface-grey)}
.nr-t{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:2px}
.nr-id{font-family:'Geist Mono',monospace;font-size:12px;font-weight:500;color:var(--text-link)}
.nr-name{font-size:13.5px;font-weight:600}
.nr-s{font-size:12px;color:var(--muted-foreground)}
.nr-a{display:flex;gap:8px}
.sys{display:flex;gap:8px;flex-wrap:wrap}
.sysc{display:flex;align-items:center;gap:7px;font-size:12px;background:var(--surface-grey);
  border:1px solid var(--border-light);border-radius:7px;padding:5px 11px;font-family:inherit;color:inherit}
.sysc b{font-weight:600;font-size:12px}
.sysc .st{width:7px;height:7px;border-radius:50%;background:var(--success)}
.sysc.warn{cursor:pointer}
.sysc.warn .st{background:var(--warning);animation:pulse 1.4s infinite}
.ov{font-size:12.5px;padding:8px 0;border-bottom:1px solid var(--border-light);line-height:1.5}
.ov:last-child{border-bottom:0}
.ov .why{color:var(--muted-foreground);font-style:italic}
.ov .fed{font-size:11.5px;color:var(--brand);margin-top:2px}
.rail{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:16px 18px;box-shadow:var(--shadow-card);position:sticky;top:73px}
.rail .rd{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:6px}
.rail h3{font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1.3;margin-bottom:9px}
.rail .tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.rail .tags span{font-size:11px;border:1px solid var(--border);border-radius:7px;padding:3px 9px;
  color:var(--muted-foreground);background:var(--surface-grey)}
.rl{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin:16px 0 8px}
.finding{border:1px solid #f5d78a;background:var(--pill-warning-bg);border-radius:11px;padding:12px 14px}
.finding.okc{border-color:#bbe7c9;background:var(--pill-success-bg)}
.finding .fh{font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  color:var(--pill-warning-fg);margin-bottom:7px}
.finding.okc .fh{color:var(--pill-success-fg)}
.finding ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.finding li{font-size:12px;line-height:1.45;color:var(--foreground);padding-left:13px;position:relative}
.finding li::before{content:'\25AA';position:absolute;left:0;color:var(--pill-warning-fg)}
.finding.okc li::before{color:var(--pill-success-fg)}
.finding .ff{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid #f0dcae;font-size:11px;color:var(--muted-foreground)}
.pstep{display:flex;gap:11px;padding-bottom:14px;position:relative}
.pstep:last-child{padding-bottom:0}
.pstep::before{content:'';position:absolute;left:13px;top:28px;bottom:0;width:1px;background:var(--border)}
.pstep:last-child::before{display:none}
.pstep .pn{width:27px;height:27px;border-radius:8px;background:var(--secondary);color:var(--muted-foreground);
  display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto;z-index:1}
.pstep.now .pn{background:var(--brand);color:#fff}
.pstep .pw{font-size:10.5px;color:var(--text-neutral);margin-bottom:2px}
.pstep .pb{border:1px solid var(--border);background:var(--surface-grey);border-radius:9px;padding:9px 11px}
.pstep .pb b{display:block;font-size:12.5px;font-weight:600;line-height:1.3;margin-bottom:2px}
.pstep .pb span{font-size:11.5px;color:var(--muted-foreground);line-height:1.4;display:block}
.execbtn{width:100%;margin-top:14px;height:40px;font-size:13.5px;font-weight:600}
.val{display:flex;gap:22px;flex-wrap:wrap}
.val div b{display:block;font-family:'Geist Mono',monospace;font-size:19px;font-weight:500;font-variant-numeric:tabular-nums}
.val div span{font-size:11px;color:var(--muted-foreground)}
@media(max-width:1180px){.tower-split{grid-template-columns:1fr}.rail{position:static}}

/* ===== tower · agent page (flow on top, data below) ===== */
.agp-head{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.agp-head .back{border:1px solid var(--border);background:var(--background);border-radius:8px;
  width:32px;height:32px;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--muted-foreground)}
.agp-head .back:hover{background:var(--surface-hover)}
.agp-name{font-size:17px;font-weight:600;letter-spacing:-.01em;line-height:1.2}
.agp-role{font-size:11px;color:var(--text-neutral);text-transform:uppercase;letter-spacing:.06em}
.agp-head .right{margin-left:auto;display:flex;align-items:center;gap:10px}
.agp-switch{display:flex;align-items:center;gap:6px;margin-left:14px;padding-left:14px;border-left:1px solid var(--border)}
.agp-switch .asw{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--background);
  border-radius:9999px;padding:4px 11px 4px 4px;font-family:inherit;font-size:12px;font-weight:500;color:var(--muted-foreground)}
.agp-switch .asw:hover{border-color:var(--border-strong);color:var(--foreground)}
.agp-switch .asw.on{border-color:var(--foreground);color:var(--foreground);font-weight:600;box-shadow:var(--shadow-card)}
.agp-switch .asw .aav{width:22px;height:22px;border-radius:50%;color:#fff;font-size:10px;font-weight:600;
  display:flex;align-items:center;justify-content:center;flex:0 0 auto}
@media(max-width:760px){.agp-switch{margin-left:0;padding-left:0;border-left:0;width:100%;order:3}}
/* UiPath-style stage plan */
.plan-wrap{background:#fbfbfc;background-image:radial-gradient(#e2e5ea 1px,transparent 1px);background-size:20px 20px;
  border:1px solid var(--border);border-radius:var(--radius-xl);padding:22px 20px 14px;margin-bottom:16px;overflow-x:auto}
.plan-row{display:flex;align-items:flex-start;gap:0;min-width:min-content;padding-bottom:8px}
.stgcard{width:212px;flex:0 0 auto;background:var(--card);border:1px solid var(--border);border-radius:12px;
  box-shadow:var(--shadow-card);overflow:hidden;transition:box-shadow .15s,border-color .15s}
.stgcard.simon{border-color:var(--brand);box-shadow:0 0 0 3px var(--surface-accent),var(--shadow-card)}
.stgcard.simheld{border-color:#f5d78a;box-shadow:0 0 0 3px var(--pill-warning-bg),var(--shadow-card)}
.stg-h{padding:9px 12px;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:8px}
.stg-h b{font-size:12.5px;font-weight:600}
.stg-h .gatemark{color:var(--pill-warning-fg);font-size:11px}
.stg-h .cnt{margin-left:auto;font-family:'Geist Mono',monospace;font-size:10px;color:var(--text-neutral)}
.stg-b{padding:8px 9px 10px;display:flex;flex-direction:column;gap:5px;min-height:96px}
.task{border:1px solid var(--border);background:var(--background);border-radius:7px;padding:6px 9px;
  font-size:11px;line-height:1.35;display:flex;gap:7px;align-items:flex-start;text-align:left;width:100%;
  font-family:inherit;color:inherit}
.task:hover{border-color:var(--border-strong)}
.task .ti{width:15px;height:15px;border-radius:4px;background:var(--secondary);color:var(--muted-foreground);
  font-size:9px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px}
.task span{color:var(--muted-foreground)}
.task b{font-weight:600;display:block;color:var(--foreground)}
.task.live{border-color:#b7dcf0;background:#f2f9fd}
.task.live .ti{background:var(--iris);color:#fff}
.task.gate{border-color:#f0dcae;background:var(--pill-warning-bg)}
.task.okr{border-color:#bbe7c9;background:var(--pill-success-bg)}
.task.simfail{border-color:#f5d78a;background:var(--pill-warning-bg)}
.task.simpass{border-color:#bbe7c9;background:var(--pill-success-bg)}
.plan-arrow{flex:0 0 auto;width:30px;display:flex;align-items:center;justify-content:center;
  color:var(--input);font-size:15px;padding-top:56px}
.plan-loop{margin:2px 0 0 12px;font-size:10.5px;color:var(--text-neutral);display:flex;align-items:center;gap:7px}
.plan-loop i{display:inline-block;width:60px;border-top:1.5px dashed var(--input)}
/* data zone under the flow */
.agp-grid{display:grid;grid-template-columns:1fr 1fr 1.15fr;gap:14px;align-items:start}
.vt-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:13px}
.vt-tile{background:var(--secondary);border-radius:8px;padding:9px 11px}
.vt-tile dt{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-foreground)}
.vt-tile dd{font-size:16px;font-weight:600;font-variant-numeric:tabular-nums;margin-top:2px}
.vb-row{display:grid;grid-template-columns:86px 1fr 56px;align-items:center;gap:9px;padding:4px 0}
.vb-row .vn{font-size:12.5px;font-weight:500;display:flex;align-items:center;gap:7px}
.vb-row .vn i{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
.vb-row .trk{height:8px;border-radius:9999px;background:var(--secondary);overflow:hidden}
.vb-row .trk i{display:block;height:100%;border-radius:9999px}
.vb-row .vv{text-align:right;font-size:12px;font-weight:500;font-variant-numeric:tabular-nums}
.vc-row{display:grid;grid-template-columns:auto 1fr auto;gap:10px;font-size:12px;padding:6px 0;border-bottom:1px solid var(--border-light);align-items:baseline}
.vc-row:last-child{border-bottom:0}
.vc-row .linky{font-family:'Geist Mono',monospace;font-size:11px}
.vc-row .vv{font-weight:600;font-variant-numeric:tabular-nums}
.vc-row .vd{color:var(--muted-foreground);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.auth-row{padding:10px 0;border-bottom:1px solid var(--border-light)}
.auth-row:last-child{border-bottom:0}
.auth-h{display:flex;align-items:baseline;gap:8px}
.auth-n{font-size:12.5px;font-weight:600}
.auth-v{margin-left:auto;font-family:'Geist Mono',monospace;font-size:12.5px;font-weight:500;font-variant-numeric:tabular-nums}
.auth-track{height:5px;border-radius:9999px;background:var(--progress-track);margin-top:8px;position:relative}
.auth-track i{display:block;height:100%;border-radius:9999px;background:var(--gp-blue)}
.auth-src{font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--text-neutral);margin-top:5px}
/* run-a-case */
.sim-card{border:1.5px solid var(--brand);box-shadow:0 0 0 4px var(--surface-accent),var(--shadow-card)}
.sim-presets{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px}
.sim-presets button{border:1px solid var(--border);background:var(--surface-grey);border-radius:9999px;
  font-size:11.5px;padding:5px 12px;color:var(--muted-foreground)}
.sim-presets button:hover{border-color:var(--brand);color:var(--brand)}
.sim-presets button.on{border-color:var(--brand);background:var(--surface-accent);color:var(--brand);font-weight:600}
.sim-custom{display:flex;gap:8px;margin-bottom:12px}
.sim-custom input{flex:1;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;
  font-size:12.5px;padding:8px 11px;min-width:0}
.sim-custom input:focus{outline:none;border-color:var(--brand)}
.sim-out{border-radius:10px;border:1px solid var(--border);background:var(--surface-grey);padding:11px 13px;font-size:12px;line-height:1.5}
.sim-out.hold{border-color:#f5d78a;background:var(--pill-warning-bg)}
.sim-out.pass{border-color:#bbe7c9;background:var(--pill-success-bg)}
.sim-out b{font-weight:600}
.sim-steps{margin-top:9px;display:flex;flex-direction:column;gap:5px}
.sim-step{display:flex;gap:8px;font-size:11.5px;align-items:baseline}
.sim-step .sv{font-family:'Geist Mono',monospace;font-size:10.5px;margin-left:auto;white-space:nowrap}
.sim-step.pass .sv{color:var(--pill-success-fg)}
.sim-step.fail .sv{color:var(--pill-warning-fg)}
@media(max-width:1100px){.agp-grid{grid-template-columns:1fr}}

/* ===== governance ===== */
.gv-head h1{font-size:21px;font-weight:600;letter-spacing:-.02em}
.gv-head p{font-size:13px;color:var(--muted-foreground);margin-top:5px;max-width:76ch;line-height:1.5}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:start}
.card-h{padding:13px 16px;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:10px}
.card-t{font-size:13.5px;font-weight:600}
.card-sub{font-size:11.5px;color:var(--muted-foreground);margin-top:2px}
.card-b{padding:14px 16px}
.ver{margin-left:auto;font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--muted-foreground);
  background:var(--surface-grey);border:1px solid var(--border);border-radius:6px;padding:3px 7px;white-space:nowrap}
.thr{padding:13px 0;border-bottom:1px solid var(--border-light)}
.thr:first-child{padding-top:2px}
.thr:last-child{border-bottom:0;padding-bottom:2px}
.thr-h{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.thr-n{font-size:13px;font-weight:600}
.thr-v{margin-left:auto;font-family:'Geist Mono',monospace;font-size:13px;font-weight:500;font-variant-numeric:tabular-nums}
.thr-d{font-size:11.5px;color:var(--muted-foreground);margin-top:4px;line-height:1.45}
.thr-src{font-size:10px;color:var(--text-neutral);margin-top:6px;font-family:'Geist Mono',monospace}
.track{height:6px;border-radius:9999px;background:var(--progress-track);margin-top:10px;position:relative}
.track-f{height:100%;border-radius:9999px;background:var(--gp-blue)}
.track-k{position:absolute;top:-4px;width:14px;height:14px;border-radius:9999px;
  background:#fff;border:2px solid var(--brand);transform:translateX(-7px)}
.scale{display:flex;justify-content:space-between;font-size:10px;color:var(--text-neutral);margin-top:5px}
.dev{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;border-radius:9999px;padding:2px 8px}
.dev.hot{background:var(--pill-warning-bg);color:var(--pill-warning-fg);border:1px solid #f0dcae}
.dev.okd{background:var(--pill-success-bg);color:var(--pill-success-fg);border:1px solid #bbe7c9}
.locked{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:600;
  color:var(--muted-foreground);background:var(--surface-grey);border:1px solid var(--border);
  border-radius:9999px;padding:2px 8px}
.simbox{background:var(--surface-accent);border:1px solid #ddd0f2;border-radius:10px;padding:13px 14px}
.simbox .sb-t{font-size:12.5px;font-weight:600;color:var(--brand-deep)}
.simbox .sb-row{display:flex;gap:20px;margin-top:11px;flex-wrap:wrap}
.simbox .sb-i{min-width:110px}
.simbox .sb-v{font-size:19px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.simbox .sb-l{font-size:10.5px;color:var(--muted-foreground);margin-top:2px;line-height:1.35}
.simbox .sb-note{font-size:11.5px;line-height:1.5;color:var(--muted-foreground);margin-top:11px}
.growc{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--border-light)}
.growc:last-child{border-bottom:0}
.growc .gm{flex:1;min-width:0}
.growc .gt{font-size:12.5px;font-weight:500;line-height:1.35}
.growc .gs{font-size:11px;color:var(--muted-foreground);margin-top:3px;line-height:1.45}
.growc .gr{flex-shrink:0;text-align:right}
.growc .gv{font-size:12.5px;font-weight:600;font-variant-numeric:tabular-nums}
.growc .gw{font-size:10.5px;color:var(--text-neutral);margin-top:2px}
/* proposal cards */
.prop{border:1px solid var(--border);border-left:3px solid var(--brand);border-radius:0 11px 11px 0;padding:13px 15px;margin-bottom:11px}
.prop .ph{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:5px}
.prop .pt{font-size:13.5px;font-weight:600}
.prop .pd{font-size:12px;color:var(--muted-foreground);line-height:1.5}
.prop .pf{display:flex;gap:8px;margin-top:11px;flex-wrap:wrap;align-items:center}
.verrow{display:grid;grid-template-columns:74px 1fr auto;gap:12px;font-size:12px;padding:9px 0;border-bottom:1px solid var(--border-light);align-items:baseline}
.verrow:last-child{border-bottom:0}
.verrow .vv{font-family:'Geist Mono',monospace;font-weight:500}
.verrow .vw{color:var(--text-neutral);font-size:11px;text-align:right;white-space:nowrap}
@media(max-width:1100px){.grid2,.grid3{grid-template-columns:1fr}}

/* ===== workflows ===== */
/* entry */
.wf-entry{max-width:1000px;margin:0 auto;padding:34px 0 50px}
.wf-entry h1{font-size:29px;font-weight:600;letter-spacing:-.02em;line-height:1.15;margin-bottom:8px;text-align:center}
.wf-entry .sub{font-size:14.5px;color:var(--muted-foreground);text-align:center;margin-bottom:28px}
.askbox{border:1.5px solid var(--brand);border-radius:14px;padding:14px 16px;background:var(--background);
  box-shadow:0 0 0 4px var(--surface-accent);margin-bottom:8px}
.askbox .al{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--brand);
  margin-bottom:9px;display:flex;align-items:center;gap:7px}
.askbox .al i{width:14px;height:14px;border-radius:4px;background:var(--gradient-brand);display:inline-block}
.askrow{display:flex;gap:9px;align-items:center}
.askrow input{flex:1;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;
  font-size:14px;padding:10px 13px;color:var(--foreground);min-width:0}
.askrow input:focus{outline:none;border-color:var(--brand)}
.askrow .btn{height:40px}
.exq{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.exq button{border:1px solid var(--border);background:var(--surface-grey);border-radius:9999px;
  font-size:11.5px;padding:5px 12px;color:var(--muted-foreground)}
.exq button:hover{border-color:var(--brand);color:var(--brand)}
.ordiv{display:flex;align-items:center;gap:14px;margin:26px 0 16px;color:var(--text-neutral);font-size:11px;
  font-weight:600;letter-spacing:.09em;text-transform:uppercase}
.ordiv::before,.ordiv::after{content:'';flex:1;height:1px;background:var(--border)}
.gcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px}
.gcard{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:16px 17px;
  box-shadow:var(--shadow-card);text-align:left;width:100%;font-family:inherit;color:inherit}
.gcard:hover{border-color:var(--brand);box-shadow:var(--shadow-menu)}
.gcard .gi{width:32px;height:32px;border-radius:9px;background:var(--secondary);color:var(--brand);
  display:flex;align-items:center;justify-content:center;font-size:15px;margin-bottom:10px}
.gcard h4{font-size:14.5px;font-weight:600;letter-spacing:-.01em;margin-bottom:3px}
.gcard p{font-size:12px;color:var(--muted-foreground);line-height:1.45;min-height:34px}
.gcard .gf{margin-top:10px;padding-top:9px;border-top:1px solid var(--border-light);display:flex;gap:6px;flex-wrap:wrap}
.entryfoot{display:flex;justify-content:center;margin-top:22px}
/* board shell */
.wf-shell{display:grid;grid-template-columns:var(--wf-lib,262px) minmax(0,1fr) var(--wf-insp,344px);gap:14px;
  align-items:stretch;height:calc(100vh - 118px);min-height:560px;transition:grid-template-columns .18s}
.wf-shell.no-lib{--wf-lib:0px;gap:0 14px}
.wf-shell.no-lib>aside.wf-pane:first-of-type{opacity:0;pointer-events:none;overflow:hidden}
.wf-shell.no-insp{--wf-insp:0px;gap:0 14px}
.wf-shell.no-insp>aside.wf-pane:last-of-type{opacity:0;pointer-events:none;overflow:hidden}
.wf-shell.no-lib.no-insp{gap:0}
.wf-pane{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  box-shadow:var(--shadow-card);display:flex;flex-direction:column;overflow:hidden;min-height:0}
.lib-search{padding:12px;border-bottom:1px solid var(--border-light)}
.lib-input{width:100%;font-family:inherit;font-size:12.5px;color:var(--foreground);
  padding:8px 11px;border:1px solid var(--input);border-radius:7px;outline:none}
.lib-input:focus{border-color:var(--brand)}
.libchips{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
.libchips button{border:1px solid var(--border);background:var(--surface-grey);border-radius:9999px;
  font-size:10.5px;padding:3px 9px;color:var(--muted-foreground)}
.libchips button:hover{border-color:var(--brand);color:var(--brand)}
.reveal-note{margin-top:8px;font-size:11px;line-height:1.45;color:var(--brand);
  background:var(--surface-accent);border:1px solid #ddd0f2;border-radius:7px;padding:7px 9px}
.lib-list{flex:1;overflow-y:auto;padding:8px}
.lib-group{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral);padding:11px 10px 5px}
.lib-item{width:100%;text-align:left;padding:9px 10px;border-radius:8px;margin-bottom:3px;
  background:transparent;border:1px solid transparent;font-family:inherit;color:inherit;display:block}
.lib-item:hover{background:var(--surface-grey)}
.lib-item.on{background:var(--surface-accent);border-color:#ddd0f2}
.lib-name{display:block;font-size:12.5px;font-weight:600}
.lib-meta{display:block;font-size:10.5px;color:var(--muted-foreground);margin-top:2px}
.lib-item.gen .lib-name::after{content:'assembled';font-size:9px;font-weight:600;letter-spacing:.05em;
  text-transform:uppercase;background:var(--surface-accent);color:var(--brand);border-radius:9999px;padding:1px 7px;margin-left:7px}
/* canvas head */
.cv-head{padding:11px 16px;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:16px;flex:0 0 auto}
.cv-back{border:1px solid var(--border);background:var(--background);border-radius:7px;width:28px;height:28px;
  display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted-foreground);flex:0 0 auto}
.cv-back:hover{background:var(--surface-hover)}
.cv-title{font-size:14px;font-weight:600}
.cv-sub{font-size:11.5px;color:var(--muted-foreground);margin-top:2px;max-width:52ch;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cv-stats{display:flex;gap:17px;margin-left:auto;flex-shrink:0}
.stat-v{font-size:15px;font-weight:600;line-height:1.2;font-variant-numeric:tabular-nums;text-align:center}
.stat-l{font-size:10px;color:var(--muted-foreground);text-align:center}
.cv-key{flex:0 0 auto;display:flex;align-items:center;gap:16px;padding:8px 16px;border-bottom:1px solid var(--border-light);flex-wrap:wrap}
.lg-row{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;color:var(--muted-foreground)}
.lg-line{width:16px;height:0;border-top:2px solid}
.cv-hint{margin-left:auto;font-size:10.5px;color:var(--text-neutral)}
/* graph canvas */
.wfcanvas{position:relative;flex:1;min-height:0;overflow:hidden;cursor:grab;touch-action:none;
  background:#fbfbfc;background-image:radial-gradient(#e2e5ea 1px,transparent 1px);background-size:18px 18px}
.wfcanvas.grabbing{cursor:grabbing}
.wfstage{position:absolute;top:0;left:0;transform-origin:0 0;width:1020px;height:900px}
.wfwires{position:absolute;inset:0;width:1020px;height:900px;pointer-events:none;overflow:visible}
.wfwires path{fill:none;stroke:#a1a1aa;stroke-width:1.6}
.wfwires path.person{stroke:#005b89;stroke-width:2}
.wfwires path.llm{stroke:#b45309;stroke-width:2}
.wfwires path.loop{stroke:#005b89;stroke-dasharray:5 4;stroke-width:1.6}
.wnode{position:absolute;width:268px;background:var(--card);border:1px solid var(--border);border-radius:12px;
  padding:12px 14px;box-shadow:0 1px 2px rgba(24,24,27,.05);text-align:left;font-family:inherit;color:inherit}
.wnode:hover{box-shadow:0 3px 12px rgba(24,24,27,.10);border-color:var(--border-strong)}
.wnode.sel{border-color:var(--brand);box-shadow:0 0 0 3px var(--surface-accent)}
.wnode .nh{display:flex;align-items:center;gap:8px}
.wnode .ni{flex-shrink:0;font-size:13px;width:17px;text-align:center}
.wnode .nt{font-size:13.5px;font-weight:600;line-height:1.3;letter-spacing:-.005em}
.wnode .nd{margin-top:6px;font-size:11.5px;line-height:1.45;color:var(--muted-foreground);
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.wnode .nf{margin-top:9px;padding-top:8px;border-top:1px solid var(--border-light);
  display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.nbadge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:500;
  color:var(--muted-foreground);background:var(--surface-grey);border-radius:5px;padding:2px 6px}
.nbadge.hot{color:var(--brand);background:var(--surface-accent);border:1px solid #ddd0f2;font-weight:600}
.nmeta{font-size:10px;color:var(--text-neutral);margin-left:auto;font-family:'Geist Mono',monospace}
.wnode.human{background:linear-gradient(180deg,var(--surface-accent),var(--card) 62%);border-color:#ddd0f2}
.wnode.human:hover{border-color:var(--brand)}
.wnode.ai .nt{color:var(--brand-deep)}
.wnode.term{width:auto;min-width:0;padding:0 14px;height:36px;border-radius:9999px;display:flex;
  align-items:center;gap:7px;background:var(--surface-grey)}
.wnode.term .nt{font-size:12.5px}
.elabel{position:absolute;display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:500;
  color:#fff;background:var(--primary);padding:3px 10px;border-radius:9999px;white-space:nowrap;
  transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 1px 3px rgba(24,24,27,.16);z-index:3}
.elabel.person{background:#005b89}
.elabel.llm{background:#b45309}
/* inspector */
.rp-tabs{flex:0 0 auto;display:flex;gap:2px;padding:8px 10px 0;border-bottom:1px solid var(--border-light)}
.rp-tab{font-size:12.5px;font-weight:500;color:var(--muted-foreground);background:none;border:0;
  border-bottom:2px solid transparent;padding:6px 11px 8px}
.rp-tab:hover{color:var(--foreground)}
.rp-tab.on{color:var(--foreground);font-weight:600;border-bottom-color:var(--brand)}
.rp-panel{display:none;flex:1;min-height:0;overflow-y:auto;padding:17px}
.rp-panel.on{display:block}
.i-title{font-size:15px;font-weight:600;line-height:1.3}
.i-desc{margin-top:6px;font-size:12.5px;line-height:1.5;color:var(--muted-foreground)}
.i-lab{font-size:10px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--text-neutral);margin:17px 0 7px}
.i-expr{display:block;font-family:'Geist Mono',monospace;font-size:11px;line-height:1.55;
  background:var(--surface-grey);border:1px solid var(--border);border-radius:7px;padding:8px 10px;word-break:break-word}
.i-auth{font-size:12.5px;line-height:1.5;background:var(--surface-grey);border:1px solid var(--border);
  border-radius:8px;padding:9px 11px}
.i-auth b{font-weight:600}
.i-src{margin-top:6px;font-size:10px;color:var(--text-neutral);font-family:'Geist Mono',monospace}
.i-q{display:flex;gap:7px;font-size:12px;line-height:1.5;color:var(--muted-foreground);margin-bottom:7px}
.i-q::before{content:'?';flex-shrink:0;width:15px;height:15px;border-radius:50%;background:var(--secondary);
  color:var(--muted-foreground);font-size:9.5px;font-weight:700;display:flex;align-items:center;justify-content:center;margin-top:2px}
.i-branch{border:1px solid var(--border);border-left:3px solid var(--border-strong);border-radius:0 8px 8px 0;
  padding:9px 11px;margin-bottom:8px}
.i-branch.person{border-left-color:#005b89}
.i-branch.llm{border-left-color:#b45309}
.i-btop{display:flex;align-items:center;gap:7px;margin-bottom:5px;flex-wrap:wrap}
.i-blabel{font-size:12.5px;font-weight:600}
.i-bkind{font-size:9.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--text-neutral)}
.i-empty{font-size:12.5px;line-height:1.55;color:var(--muted-foreground)}
@media(max-width:1200px){.wf-shell{grid-template-columns:1fr;height:auto}.wf-pane{min-height:320px}}
/* ===== case thread ===== */
.ct-shell{display:grid;grid-template-rows:auto minmax(0,1fr);height:calc(100vh - 74px);min-height:600px;
  border:1px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-card);background:var(--card)}
.ct-head{display:flex;align-items:center;gap:11px;padding:9px 14px;border-bottom:1px solid var(--border);flex-wrap:wrap;background:var(--background)}
.ct-head .cid{font-family:'Geist Mono',monospace;font-size:12px;color:var(--muted-foreground)}
.ct-head h2{font-size:14px;font-weight:600;letter-spacing:-.005em}
.ct-facts{display:flex;align-items:center;gap:10px;font-size:11.5px;color:var(--muted-foreground);flex-wrap:wrap;min-width:0}
.ct-facts b{font-weight:600;color:var(--foreground)}
.ct-facts .sep{color:var(--input)}
.ct-head .right{margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.ct-body{display:grid;grid-template-columns:auto minmax(0,1fr) auto;min-height:0}
/* rail */
.ct-rail{width:272px;border-right:1px solid var(--border);display:flex;flex-direction:column;min-height:0;background:var(--surface-grey);transition:width .18s}
.ct-rail.min{width:0;border-right:0;overflow:hidden}
.railtabs{display:flex;gap:2px;padding:9px 10px 0;border-bottom:1px solid var(--border);background:var(--background)}
.railtabs button{flex:1;font-size:12.5px;font-weight:500;color:var(--muted-foreground);background:none;border:0;
  border-bottom:2px solid transparent;padding:6px 4px 9px}
.railtabs button.on{color:var(--foreground);font-weight:600;border-bottom-color:var(--brand)}
.rail-b{flex:1;overflow-y:auto;padding:11px}
.needsbar{display:flex;align-items:center;gap:9px;width:100%;border:1px solid #f0dcae;background:var(--pill-warning-bg);
  border-radius:9px;padding:9px 11px;margin-bottom:11px;text-align:left;font-family:inherit;color:inherit}
.needsbar:hover{border-color:var(--warning)}
.needsbar .ni{width:17px;height:17px;border-radius:50%;background:var(--warning);color:#fff;font-size:10px;
  display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.needsbar b{display:block;font-size:12.5px;font-weight:600}
.needsbar span{font-size:11px;color:var(--pill-warning-fg)}
.needsbar .ch{margin-left:auto;color:var(--pill-warning-fg);font-size:13px}
.railsearch{width:100%;font-family:inherit;font-size:12.5px;padding:8px 11px;border:1px solid var(--input);
  border-radius:8px;outline:none;margin-bottom:9px;background:var(--background)}
.railsearch:focus{border-color:var(--brand)}
.railchips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.railchips button{border:1px solid var(--border);background:var(--background);border-radius:9999px;
  font-size:11.5px;padding:4px 11px;color:var(--muted-foreground);display:inline-flex;align-items:center;gap:6px}
.railchips button:hover{border-color:var(--border-strong)}
.railchips button.on{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
.railchips button .n{font-variant-numeric:tabular-nums;opacity:.75}
.raillab{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-neutral);
  margin:4px 0 8px;display:flex;align-items:center;gap:8px}
.raillab .n{margin-left:auto;font-variant-numeric:tabular-nums}
.ccard{display:block;width:100%;border:1px solid var(--border);background:var(--background);border-radius:10px;
  padding:11px 12px;text-align:left;margin-bottom:8px;font-family:inherit;color:inherit;box-shadow:var(--shadow-card)}
.ccard:hover{border-color:var(--border-strong)}
.ccard.on{border-color:var(--foreground);border-left:3px solid var(--foreground);box-shadow:var(--shadow-menu)}
.ccard .ct1{display:flex;align-items:baseline;gap:8px;margin-bottom:3px}
.ccard .cid2{font-family:'Geist Mono',monospace;font-size:11px;color:var(--muted-foreground)}
.ccard .cval{margin-left:auto;font-family:'Geist Mono',monospace;font-size:11.5px;font-weight:600;font-variant-numeric:tabular-nums}
.ccard .cnm{font-size:13px;font-weight:600;line-height:1.3;display:block;margin-bottom:7px}
.ccard .cft{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.ccard .ctime{margin-left:auto;font-size:10.5px;color:var(--text-neutral);font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;gap:4px}
.ccard .cwait{font-size:11px;color:var(--muted-foreground);margin-top:8px;padding-top:7px;border-top:1px solid var(--border-light);
  display:flex;align-items:center;gap:6px}
.ccard .cwait b{font-weight:600;color:var(--foreground)}
/* canvas */
.ct-canvas{position:relative;overflow:hidden;min-height:0;background:#fbfbfc;
  background-image:radial-gradient(#e2e5ea 1.1px,transparent 1.1px);background-size:20px 20px;cursor:grab;touch-action:none}
.ct-canvas.grabbing{cursor:grabbing}
.ct-canvas.sim{background:#fffdf5;background-image:radial-gradient(#ecdcae 1.1px,transparent 1.1px);
  box-shadow:inset 0 0 0 2px var(--warning)}
.ct-stage{position:absolute;top:0;left:0;transform-origin:0 0;width:1000px}
.ct-wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
.ct-wires path{fill:none;stroke:#9aa3ae;stroke-width:1.5}
.ct-wires path.side{stroke:#c3cad3}
.ct-wires marker path{stroke:none}
.ct-rows{position:relative;padding:22px 0 30px}
.ct-row{position:relative;margin-bottom:34px}
.snode{position:absolute;width:296px;background:var(--card);border:1px solid var(--border);border-radius:11px;
  padding:11px 13px;box-shadow:0 1px 2px rgba(24,24,27,.05);text-align:left;font-family:inherit;color:inherit}
.snode:hover{box-shadow:0 3px 12px rgba(24,24,27,.1);border-color:var(--border-strong)}
.snode.sel{border-color:var(--foreground);box-shadow:0 0 0 3px rgba(9,9,11,.07)}
.snode.trigger{background:var(--surface-grey)}
.snode.agent{border-left:3px solid var(--ac)}
.snode.human{background:linear-gradient(180deg,var(--pill-warning-bg),var(--card) 70%);border-color:#f0dcae}
.snode .sh{display:flex;align-items:center;gap:7px;margin-bottom:6px}
.snode .sag{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ac,var(--text-neutral));
  display:inline-flex;align-items:center;gap:5px}
.snode .sag i{width:6px;height:6px;border-radius:50%;background:var(--ac,var(--text-neutral))}
.snode .sst{margin-left:auto;font-size:10.5px;font-weight:500;display:inline-flex;align-items:center;gap:4px;color:var(--pill-success-fg)}
.snode .sst.pend{color:var(--text-neutral)}
.snode .sst.nowst{color:var(--brand);font-weight:600}
.snode .sst.heldst{color:var(--pill-warning-fg);font-weight:600}
.snode .stt{font-size:13.5px;font-weight:600;line-height:1.3;letter-spacing:-.005em}
.snode .sdd{margin-top:5px;font-size:11.5px;line-height:1.45;color:var(--muted-foreground);
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.snode .sfm{margin-top:8px;padding-top:7px;border-top:1px solid var(--border-light);display:flex;align-items:center;gap:11px;
  font-size:10.5px;color:var(--text-neutral);font-variant-numeric:tabular-nums}
.snode.dim{opacity:.24}
.sidenode{position:absolute;width:262px;background:var(--surface-grey);border:1px solid var(--border);border-radius:9px;
  padding:9px 11px;text-align:left;font-family:inherit;color:inherit}
.sidenode:hover{border-color:var(--border-strong);background:var(--background)}
.sidenode .syshead{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.sidenode .sysl{font-size:9.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral)}
.sidenode .ok{margin-left:auto;font-size:10px;font-weight:500;color:var(--pill-success-fg);
  display:inline-flex;align-items:center;gap:3px;white-space:nowrap}
.sidenode .ok.pend{color:var(--text-neutral)}
.sidenode .sysd{font-size:11.5px;color:var(--foreground);line-height:1.4;display:block}
.sidenode.dim{opacity:.24}
.simbanner{position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:7;background:var(--pill-warning-bg);
  border:1px solid var(--warning);color:var(--pill-warning-fg);border-radius:9999px;font-size:11.5px;font-weight:600;
  padding:6px 15px;box-shadow:var(--shadow-card);display:none;white-space:nowrap}
.ct-canvas.sim .simbanner{display:block}
.fitbtn{position:absolute;right:14px;top:12px;z-index:6;border:1px solid var(--border);background:var(--card);
  border-radius:8px;font-size:11.5px;font-weight:500;color:var(--muted-foreground);padding:6px 12px;
  display:inline-flex;align-items:center;gap:6px;box-shadow:var(--shadow-card)}
.fitbtn:hover{background:var(--surface-hover);color:var(--foreground)}
.zstack{position:absolute;left:14px;bottom:52px;z-index:6;display:flex;flex-direction:column;gap:0;
  border:1px solid var(--border);border-radius:9px;overflow:hidden;background:var(--card);box-shadow:var(--shadow-card)}
.zstack button{width:32px;height:31px;border:0;background:none;font-size:14px;color:var(--muted-foreground);
  display:flex;align-items:center;justify-content:center;border-bottom:1px solid var(--border-light)}
.zstack button:last-child{border-bottom:0;font-size:11px}
.zstack button:hover{background:var(--surface-hover);color:var(--foreground)}
.zstack .zv{font-size:10px;font-weight:600;color:var(--text-neutral);text-align:center;padding:4px 0 5px;
  border-top:1px solid var(--border-light);font-variant-numeric:tabular-nums;background:var(--surface-grey)}
.minimap{position:absolute;right:14px;bottom:52px;width:104px;height:82px;z-index:6;border:1px solid var(--border);
  border-radius:8px;background:rgba(255,255,255,.9);overflow:hidden;box-shadow:var(--shadow-card)}
.minimap i{position:absolute;border-radius:2px;background:#c9cfd8;display:block}
.minimap i.ag{background:#a9b4e8}
.minimap i.hu{background:#f0c86a}
.minimap .vp{position:absolute;border:1.5px solid var(--brand);border-radius:3px;background:rgba(100,64,182,.07)}
.replaybar{position:absolute;left:0;right:0;bottom:0;z-index:6;display:flex;align-items:center;gap:12px;
  padding:8px 14px;background:var(--background);border-top:1px solid var(--border);flex-wrap:wrap}
.rb-ctrls{display:flex;gap:2px}
.rb-ctrls button{width:28px;height:28px;border:0;background:none;border-radius:7px;font-size:12px;
  color:var(--muted-foreground);display:flex;align-items:center;justify-content:center}
.rb-ctrls button:hover{background:var(--surface-hover);color:var(--foreground)}
.rb-ctrls button:disabled{opacity:.35}
.rb-live{font-size:11.5px;color:var(--muted-foreground);display:inline-flex;align-items:center;gap:6px;
  border:1px solid var(--border);border-radius:9999px;padding:3px 11px}
.rb-live.on{border-color:var(--success);color:var(--pill-success-fg)}
.rb-dots{display:flex;gap:4px;align-items:center}
.rb-dot{width:18px;height:20px;border-radius:4px;border:0;background:var(--secondary);font-size:9px;
  color:var(--text-neutral);display:flex;align-items:center;justify-content:center}
.rb-dot:hover{background:var(--border)}
.rb-dot.done{background:#d6ead9;color:var(--pill-success-fg)}
.rb-dot.now{background:var(--brand);color:#fff}
.rb-dot.held{background:#f6dfa8;color:var(--pill-warning-fg)}
.rb-sum{margin-left:auto;font-size:11px;color:var(--muted-foreground);font-variant-numeric:tabular-nums}
/* inspector */
.ct-insp{width:340px;border-left:1px solid var(--border);display:flex;flex-direction:column;min-height:0;background:var(--background);transition:width .18s}
.ct-insp.min{width:0;border-left:0;overflow:hidden}
.insp-h{display:flex;align-items:center;gap:9px;padding:12px 16px;border-bottom:1px solid var(--border-light)}
.insp-h .il{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral)}
.insp-b{flex:1;overflow-y:auto;padding:16px}
.insp-t{font-size:15.5px;font-weight:600;line-height:1.3;letter-spacing:-.01em}
.insp-who{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap;font-size:12.5px}
.insp-who .wn{font-weight:600;display:inline-flex;align-items:center;gap:6px}
.insp-who .wn i{width:7px;height:7px;border-radius:50%;background:var(--ac,var(--text-neutral))}
.insp-lab{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral);margin:18px 0 7px}
.insp-p{font-size:12.5px;line-height:1.55;color:var(--foreground)}
.insp-ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.insp-ul li{font-size:12px;line-height:1.5;color:var(--muted-foreground);padding-left:13px;position:relative}
.insp-ul li::before{content:'';position:absolute;left:0;top:8px;width:4px;height:4px;border-radius:50%;background:var(--border-strong)}
.chiprow{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}
.mchip{font-size:11px;background:var(--secondary);border-radius:6px;padding:3px 9px;color:var(--muted-foreground);font-variant-numeric:tabular-nums}
.actbox{border:1px solid var(--border);border-radius:10px;overflow:hidden}
.actbox .ab-h{display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--surface-grey);border-bottom:1px solid var(--border-light)}
.actbox .ab-h b{font-size:12.5px;font-weight:600}
.actbox .ab-b{padding:11px 12px}
.actbox .ab-d{font-size:12px;line-height:1.5;color:var(--muted-foreground)}
.ladder{margin-top:12px;padding-top:11px;border-top:1px solid var(--border-light)}
.ladder .ll{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:8px}
.lrow{display:flex;align-items:center;gap:8px;font-size:12px;padding:4px 0}
.lrow .lic{width:15px;text-align:center;color:var(--muted-foreground);font-size:11px}
.lrow .lt{color:var(--foreground)}
.lrow .lw{margin-left:auto;font-size:10.5px;color:var(--text-neutral);font-variant-numeric:tabular-nums}
.lrow.done .lic{color:var(--pill-success-fg)}
.nextline{display:flex;align-items:center;gap:8px;margin-top:18px;padding-top:13px;border-top:1px solid var(--border-light);
  font-size:12px;color:var(--muted-foreground)}
.nextline b{font-weight:600;color:var(--foreground)}
/* simulate panel */
.simslider{border:1px solid var(--border);border-radius:10px;padding:12px 13px;margin:12px 0}
.simslider .sl-t{font-size:13px;font-weight:600;margin-bottom:9px}
.simslider input{width:100%;accent-color:var(--brand)}
.simslider .sl-n{font-size:11px;color:var(--muted-foreground);margin-top:7px;line-height:1.45}
.cmp{width:100%;border-collapse:collapse;margin-top:6px}
.cmp th{font-size:9.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--text-neutral);
  text-align:right;padding:6px 0 8px}
.cmp th:first-child{text-align:left}
.cmp td{font-size:12px;padding:7px 0;border-top:1px solid var(--border-light);text-align:right;vertical-align:top}
.cmp td:first-child{text-align:left;color:var(--muted-foreground)}
.cmp td.simv{color:var(--brand);font-weight:600}
.tradeoff{border:1px solid #f0dcae;background:var(--pill-warning-bg);border-radius:10px;padding:12px 13px;margin-top:16px}
.tradeoff b{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--pill-warning-fg);margin-bottom:7px}
.tradeoff p{font-size:11.5px;line-height:1.55;color:var(--pill-warning-fg)}
.simacts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}

.sysc .vend{font-weight:400;color:var(--text-neutral);font-size:10.5px}
/* ledger surface */
.led-top{display:flex;align-items:center;gap:11px;margin-bottom:16px;flex-wrap:wrap}
.led-top .right{margin-left:auto;display:flex;align-items:center;gap:8px}
.kpis4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
@media(max-width:900px){.kpis4{grid-template-columns:repeat(2,minmax(0,1fr))}}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  box-shadow:var(--shadow-card);padding:14px 16px}
.kpi-l{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--text-neutral)}
.kpi-v{font-size:25px;font-weight:600;letter-spacing:-.02em;margin:7px 0 3px;font-variant-numeric:tabular-nums;
  font-family:'Geist Mono',ui-monospace,monospace}
.kpi-s{font-size:11.5px;color:var(--muted-foreground);line-height:1.45}
.abar{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--border-light);flex-wrap:wrap}
.asearch{flex:1 1 240px;min-width:190px}
.asearch input{width:100%;font-family:inherit;font-size:12.5px;padding:8px 12px;border:1px solid var(--input);
  border-radius:8px;outline:none;background:var(--background);color:inherit}
.asearch input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(100,64,182,.12)}
.fchip{border:1px solid var(--border);background:var(--background);border-radius:9999px;font-family:inherit;
  font-size:11.5px;padding:5px 13px;color:var(--muted-foreground)}
.fchip:hover{border-color:var(--border-strong);color:var(--foreground)}
.fchip.on{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
.acount{margin-left:auto;font-size:11px;color:var(--text-neutral);font-variant-numeric:tabular-nums;white-space:nowrap}
.tfoot{padding:11px 16px;border-top:1px solid var(--border-light);font-size:11.5px;color:var(--muted-foreground);
  background:var(--surface-grey);border-radius:0 0 var(--radius-xl) var(--radius-xl)}
.chainok{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;line-height:1.5;color:var(--foreground);
  border:1px solid #cfe6d4;background:#f2f9f4;border-radius:10px;padding:11px 13px}
.chainok:before{content:'';width:8px;height:8px;border-radius:50%;background:var(--success,#2f8f52);
  flex:0 0 auto;margin-top:5px;box-shadow:0 0 0 3px rgba(47,143,82,.16)}
.ledger thead th{position:sticky;top:0;background:var(--surface-grey);z-index:1}
/* ledger */
.ledwrap{overflow-x:auto}
.ledger{width:100%;border-collapse:collapse;min-width:920px}
.ledger th{font-size:11px;font-weight:600;color:var(--muted-foreground);text-align:left;padding:11px 14px;
  border-bottom:1px solid var(--border);white-space:nowrap}
.ledger td{font-size:12.5px;padding:13px 14px;border-bottom:1px solid var(--border-light);vertical-align:top}
.ledger tr:last-child td{border-bottom:0}
.ledger tbody tr{cursor:pointer}
.ledger tbody tr:hover{background:var(--surface-grey)}
.led-when{font-family:'Geist Mono',monospace;font-size:11px;color:var(--muted-foreground);white-space:nowrap;line-height:1.5}
.led-act b{display:block;font-size:12.5px;font-weight:600;line-height:1.35;margin-bottom:3px}
.led-act span{font-size:11.5px;color:var(--muted-foreground);line-height:1.5}
.led-act .mono{font-family:'Geist Mono',monospace;font-size:11px}
.led-who{display:flex;align-items:center;gap:8px;white-space:nowrap}
.led-av{width:22px;height:22px;border-radius:6px;color:#fff;font-size:9.5px;font-weight:600;
  display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.led-ref{font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--text-link);white-space:nowrap}
.led-hash{font-family:'Geist Mono',monospace;font-size:10px;color:var(--text-neutral)}
.led-cause{font-size:11.5px;color:var(--muted-foreground)}
@media(max-width:1200px){.ct-rail{position:absolute;z-index:20;height:100%}.ct-insp{position:absolute;right:0;z-index:20;height:100%}}
/* ===== drawer / modal / toast ===== */
.scrim{position:fixed;inset:0;background:rgba(9,9,11,.35);z-index:50;display:none}
.scrim.on{display:block}
.drawer{position:fixed;top:0;right:-440px;width:420px;max-width:94vw;height:100vh;background:var(--background);
  border-left:1px solid var(--border);box-shadow:var(--shadow-modal);z-index:60;transition:right .22s ease;
  padding:22px 24px;overflow:auto}
.drawer.on{right:0}
.dr-k{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:8px}
.dr-t{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-bottom:4px}
.dr-s{font-size:12.5px;color:var(--muted-foreground);margin-bottom:14px;line-height:1.5}
.dr-x{position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--background);font-size:14px}
.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-46%) scale(.98);width:560px;max-width:94vw;
  max-height:88vh;overflow:auto;background:var(--background);border:1px solid var(--border);border-radius:14px;
  box-shadow:var(--shadow-modal);z-index:70;padding:24px 26px;display:none}
.modal.on{display:block;animation:pop .18s ease forwards}
@keyframes pop{to{transform:translate(-50%,-50%) scale(1)}}
.m-t{font-size:16px;font-weight:600;margin-bottom:2px}
.m-s{font-size:12px;color:var(--muted-foreground);margin-bottom:14px}
.opt{border:1px solid var(--border);border-radius:10px;padding:11px 14px;margin-bottom:9px}
.opt.rec{border-color:var(--brand);background:var(--surface-accent)}
.opt h6{font-size:12.5px;font-weight:600;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.opt p{font-size:11.5px;color:var(--muted-foreground);margin-top:2px;line-height:1.45}
.m-f{display:flex;gap:9px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap}
.rzn{width:100%;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;font-size:12.5px;
  padding:9px 11px;min-height:64px;resize:vertical;display:none;margin-top:4px}
.rzn.on{display:block}
.rz-err{display:none;font-size:11.5px;color:var(--destructive);margin-top:4px}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(70px);background:#18181b;
  color:#fafafa;font-size:12.5px;padding:10px 18px;border-radius:9px;z-index:90;transition:transform .22s ease;
  box-shadow:var(--shadow-modal);max-width:90vw}
.toast.on{transform:translateX(-50%) translateY(0)}
@media(max-width:900px){.nrow{grid-template-columns:1fr}}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <div class="brand"><div class="mk">N</div>
      <div><div class="bt">Navanta Lens</div><div class="bs">Agent operations</div></div></div>
    <div class="ptabs">
      <button class="ptab on" data-p="tower" onclick="nav('tower')">Control Tower</button>
      <button class="ptab" data-p="govern" onclick="nav('govern')">Governance</button>
      <button class="ptab" data-p="workflows" onclick="nav('workflows')">Workflows</button>
      <button class="ptab" data-p="audit" onclick="nav('audit')">Case Thread</button>
    </div>
    <div class="top-r">
      <button class="pol" id="polBtn" onclick="nav('govern')">policy v4.2</button>
      <div class="live"><span class="dot"></span> live</div>
    </div>
  </div>

  <!-- ================= CONTROL TOWER ================= -->
  <div class="view on" id="p-tower">
   <div class="body">

    <!-- ---- Today ---- -->
    <div class="view on" id="t-today">
      <div class="subbar">
        <div class="statusstrip">
          <span class="sd"><i></i><b id="ss-run">3</b> agents running</span>
          <span class="div"></span>
          <span class="sd w"><i></i><b id="ss-held">1</b> waiting on you</span>
          <span class="div"></span>
          <span class="sd f"><i></i><b>0</b> faults</span>
          <span class="div"></span>
          <span>$339k at risk · 5 open cases</span>
        </div>
      </div>

      <div class="tower-split">
        <div>
          <div class="askpanel">
            <div class="ah"><span class="sp">✦</span><h3>Work with your agents</h3></div>
            <div class="ai">
              <input id="towerAsk" placeholder="What do you want to get done?" onkeydown="if(event.key==='Enter')towerAskGo()">
              <button class="btn pr" onclick="towerAskGo()">Go</button>
            </div>
            <div class="ac">
              <button onclick="towerAskEx('what needs my attention?')">What needs my attention?</button>
              <button onclick="towerAskEx('why was the $214k held?')">Why was the $214k held?</button>
              <button onclick="towerAskEx('show me the buying flow')">Show me the buying flow</button>
              <button onclick="towerAskEx('what did we recover today?')">What did we recover today?</button>
            </div>
          </div>

          <div class="workband">
            <div class="wl">Working for you today — click an agent to see how it works</div>
            <div class="agcards" id="agCards"></div>
          </div>

          <div class="tabsrow">
            <button class="on" data-t="activity" onclick="towerTab('activity')">Recent activity</button>
            <button data-t="systems" onclick="towerTab('systems')">Systems</button>
            <button data-t="overrides" onclick="towerTab('overrides')">Overrides</button>
            <button data-t="value" onclick="towerTab('value')">Value</button>
          </div>

          <div class="tpane on" id="tp-activity">
            <div class="card">
              <div class="nrow">
                <div>
                  <div class="nr-t"><span class="nr-id">EX-4472</span><span class="nr-name">Coverage gap, 6 DCs</span>
                    <span class="pill warn" id="p-4472">held · $214,000</span></div>
                  <div class="nr-s" id="s-4472">Iris raised 3 requisitions — two auto-ran, the third is above your $150k limit. Waiting on you 2h 11m · delay costs ≈ $1.8k/day.</div>
                </div>
                <div class="nr-a" id="a-4472">
                  <button class="btn pr" onclick="openPacket()">Open packet</button>
                  <button class="btn" onclick="openCase('EX-4472')">Case flow</button>
                </div>
              </div>
              <div class="nrow">
                <div>
                  <div class="nr-t"><span class="nr-id">EX-4474</span><span class="nr-name">Damaged delivery claim · SO-48219</span>
                    <span class="pill info" id="p-4474">credit issuing · customer confirming</span></div>
                  <div class="nr-s">Christy validated the claim from the POD and photos. The $8,400 credit is issuing; alternate stock soft-held 48h — 17h left.</div>
                </div>
                <div class="nr-a">
                  <button class="btn" id="nudge-4474" onclick="nudge4474()">Nudge customer</button>
                  <button class="btn" onclick="openCase('EX-4474')">Case flow</button>
                </div>
              </div>
              <div class="nrow">
                <div>
                  <div class="nr-t"><span class="nr-id">EX-4468</span><span class="nr-name">Phase-out cover — overridden</span>
                    <span class="pill br">learning proposed</span></div>
                  <div class="nr-s">Dana R. rejected with a reason. Proposed change: read the phase-out flag before any cover recommendation.</div>
                </div>
                <div class="nr-a"><button class="btn" onclick="nav('govern');gvTab('learn')">Review in Governance</button></div>
              </div>
              <div class="nrow">
                <div>
                  <div class="nr-t"><span class="nr-id">EX-4471</span><span class="nr-name">Vendor lead time +10 days</span>
                    <span class="pill ok">resolved · verified</span></div>
                  <div class="nr-s">7 writes confirmed by the target systems. Case closed in 6.1s of agent time; customer re-committed.</div>
                </div>
                <div class="nr-a"><button class="btn" onclick="openCase('EX-4471')">Case thread</button></div>
              </div>
            </div>
          </div>

          <div class="tpane" id="tp-systems">
            <div class="card" style="padding:16px 18px">
              <div class="sys">
                <span class="sysc"><span class="st"></span><b>ERP</b> <span class="vend">Oracle Fusion</span> 214r · 41w ✓</span>
                <button class="sysc warn" onclick="openRetry()"><span class="st"></span><b>Planning</b> <span class="vend">OMP</span> 96r · 3w · 1 retrying</button>
                <span class="sysc"><span class="st"></span><b>Warehouse</b> <span class="vend">Manhattan</span> 61r · 2w ✓</span>
                <span class="sysc"><span class="st"></span><b>Transport visibility</b> <span class="vend">project44</span> read-only</span>
                <span class="sysc"><span class="st"></span><b>Product master</b> <span class="vend">PIM</span> 44r</span>
                <span class="sysc"><span class="st"></span><b>Data platform</b> <span class="vend">Databricks</span> 213w ✓</span>
              </div>
              <div class="nr-s" style="margin-top:12px">Every write is confirmed by the target system before a case closes. Scopes and recovery rules live in <button class="linky" onclick="nav('govern');gvTab('sys')">Governance → Systems &amp; recovery</button>.</div>
            </div>
          </div>

          <div class="tpane" id="tp-overrides">
            <div class="card" style="padding:16px 18px">
              <div id="ovfeed">
                <div class="ov"><b>14:22 · Dana R. rejected EX-4468</b> — <span class="why">"SKU 44-2213 phases out in Q4 — don't build cover we'll write off."</span>
                  <div class="fed">↻ fed back: phase-out check proposed — review it in Governance</div></div>
                <div class="ov"><b>11:07 · Marcus O. adjusted EX-4455</b> — <span class="why">"Delay only hits the imported range — applied to 40 of 61 SKUs."</span>
                  <div class="fed">↻ fed back: lead-time updates now scoped by source origin</div></div>
              </div>
            </div>
          </div>

          <div class="tpane" id="tp-value">
            <div class="card" style="padding:16px 18px">
              <div class="val">
                <div><b>$129k</b><span>protected today</span></div>
                <div><b>$41k</b><span>Mercer · service</span></div>
                <div><b>$52k</b><span>Iris · stock-outs</span></div>
                <div><b>$36k</b><span>Christy · promises</span></div>
                <div><b>38h</b><span>planner hours saved</span></div>
              </div>
              <div class="nr-s" style="margin-top:12px">Median resolution 74m vs a 38h manual baseline — measured, not claimed.</div>
            </div>
          </div>
        </div>

        <aside class="rail" id="towerRail"></aside>
      </div>
    </div>

    <!-- ---- Agent page: flow on top, data below ---- -->
    <div class="view" id="t-agent">
      <div class="agp-head">
        <button class="back" onclick="towerHome()" aria-label="Back to Control Tower">←</button>
        <div class="av" id="agp-av">I</div>
        <div><div class="agp-name" id="agp-name">Iris</div><div class="agp-role" id="agp-role">Planning agent</div></div>
        <div class="agp-switch" id="agp-switch" role="tablist" aria-label="Switch agent"></div>
        <div class="right">
          <span class="pill" id="agp-pill">running</span>
          <button class="btn" onclick="nav('govern');gvTab('auth')">Modify in Governance</button>
          <button class="sw" id="agp-sw" role="switch" aria-checked="true" aria-label="Agent active" onclick="agpPause()"></button>
        </div>
      </div>

      <div class="lab">How this agent works — its operating plan, live</div>
      <div class="plan-wrap">
        <div class="plan-row" id="planRow"></div>
        <div class="plan-loop"><i></i><span id="planLoop">overrides feed the next recommendation — governed in Learning</span></div>
      </div>

      <div class="agp-grid">
        <div class="card" style="padding:15px 17px">
          <div class="lab" id="agp-vtl">Iris today</div>
          <dl class="vt-tiles" id="agp-tiles"></dl>
          <div class="lab" style="margin-top:4px">Value by case</div>
          <div id="agp-cases"></div>
        </div>
        <div class="card" style="padding:15px 17px">
          <div class="lab">Authority — read live from Governance</div>
          <div id="agp-auth"></div>
          <div class="note" style="margin-top:12px">These numbers are the same ones the simulator on the right uses. Change them in Governance and the same case runs differently here.</div>
        </div>
        <div class="card sim-card" style="padding:15px 17px">
          <div class="lab" style="color:var(--brand)">▶ Run a case through this agent</div>
          <div class="nr-s" style="margin-bottom:10px">A simulation against current policy — nothing is written anywhere.</div>
          <div class="sim-presets" id="simPresets"></div>
          <div class="sim-custom">
            <input id="simAmt" inputmode="numeric" placeholder="or type an amount, e.g. 180000">
            <button class="btn pr" onclick="runSim()">Run</button>
          </div>
          <div id="simOut"></div>
        </div>
      </div>
    </div>
   </div>
  </div>

  <!-- ================= GOVERNANCE ================= -->
  <div class="view" id="p-govern">
   <div class="body">
    <div class="gv-head">
      <h1>What the agents are allowed to decide</h1>
      <p>Every gate in <button class="linky" onclick="nav('workflows')">Workflows</button> and every hold in a case reads its number from here.
        Nothing is edited in two places, nothing changes mid-run, and no threshold moves without a simulation
        showing what it would have done to the last ninety days.</p>
    </div>
    <div class="tabsrow" style="margin-top:16px">
      <button class="on" data-g="auth" onclick="gvTab('auth')">Agent authority</button>
      <button data-g="learn" onclick="gvTab('learn')">Learning governance</button>
      <button data-g="sys" onclick="gvTab('sys')">Systems &amp; recovery</button>
    </div>

    <div class="tpane on" id="gp-auth">
      <div class="grid3" id="authCards"></div>
      <div class="card" style="margin-top:14px">
        <div class="card-h">
          <div><div class="card-t">Never acts alone</div>
            <div class="card-sub">The doors no threshold can open. These hold at any confidence, any amount.</div></div>
          <span class="ver" id="verChip">v4.2 · 12 Aug 2026</span>
        </div>
        <div class="card-b">
          <div class="growc"><div class="gm"><div class="gt">Customer credit beyond the claim limit</div>
            <div class="gs">Christy can issue ≤ $10k against evidence; anything above is a person's call, always.</div></div>
            <div class="gr"><div class="gv">Service lead</div><div class="gw">Christy</div></div></div>
          <div class="growc"><div class="gm"><div class="gt">Vendor termination or suspension</div>
            <div class="gs">Mercer scores vendors and flags risk; ending a relationship is never automated.</div></div>
            <div class="gr"><div class="gv">Category manager</div><div class="gw">Mercer</div></div></div>
          <div class="growc"><div class="gm"><div class="gt">Product substitution</div>
            <div class="gs">The customer decides between an alternate and waiting — the agent only frames the choice.</div></div>
            <div class="gr"><div class="gv">Customer</div><div class="gw">Christy</div></div></div>
          <div class="growc"><div class="gm"><div class="gt">Threshold changes need the policy owner</div>
            <div class="gs">Blast radius is every future case — so it is not whoever noticed the deviation.</div></div>
            <div class="gr"><div class="gv">Policy owner</div><div class="gw">any agent</div></div></div>
          <div class="note" style="margin-top:12px"><b>Read the asymmetry:</b> approving one requisition is one click.
            Changing the rule that judges every future requisition takes a simulation, a named owner and a version
            number. Confirmation weight scales with blast radius.</div>
        </div>
      </div>
    </div>

    <div class="tpane" id="gp-learn">
      <div class="grid2">
        <div>
          <div class="lab">Proposals — born from overrides, tested before live</div>
          <div id="propList"></div>
        </div>
        <div class="card" style="align-self:start">
          <div class="card-h"><div><div class="card-t">Policy version history</div>
            <div class="card-sub">Every change versioned; cascades on the next run, never mid-flight</div></div></div>
          <div class="card-b" id="verHist"></div>
        </div>
      </div>
    </div>

    <div class="tpane" id="gp-sys">
      <div class="grid2">
        <div class="card">
          <div class="card-h"><div><div class="card-t">What the agents can reach</div>
            <div class="card-sub">Scopes are per system and per direction</div></div></div>
          <div class="card-b">
            <div class="growc"><div class="gm"><div class="gt">Oracle Fusion — orders &amp; requisitions</div>
              <div class="gs"><span class="mono">read + write</span> · POs, promise dates, requisitions on cleared vendors, credits ≤ limit</div></div>
              <div class="gr"><span class="pill warn">Write</span></div></div>
            <div class="growc"><div class="gm"><div class="gt">OMP — coverage &amp; safety stock</div>
              <div class="gs"><span class="mono">read + write</span> · coverage by DC, stock moves inside the 25% band</div></div>
              <div class="gr"><span class="pill warn">Write</span></div></div>
            <div class="growc"><div class="gm"><div class="gt">Manhattan — warehouse</div>
              <div class="gs"><span class="mono">read + write</span> · on-hand, soft holds, delivery booking</div></div>
              <div class="gr"><span class="pill warn">Write</span></div></div>
            <div class="growc"><div class="gm"><div class="gt">Transport visibility · Product master</div>
              <div class="gs"><span class="mono">read</span> · tracking, phase-out flags, supersessions, MOQ</div></div>
              <div class="gr"><span class="pill nu">Read only</span></div></div>
            <div class="growc"><div class="gm"><div class="gt">Purchase orders to vendors</div>
              <div class="gs">No scope. A requisition becomes a PO only after a buyer sends it.</div></div>
              <div class="gr"><span class="pill ok">None</span></div></div>
            <div class="warncard" style="margin-top:12px">The agents can draft and raise, but they cannot commit spend
              to a vendor. Every outbound PO is a buyer's action.</div>
          </div>
        </div>
        <div>
          <div class="card">
            <div class="card-h"><div><div class="card-t">Recovery rules</div>
              <div class="card-sub">Every action is a promise — held open until the target system confirms</div></div></div>
            <div class="card-b">
              <div class="growc"><div class="gm"><div class="gt">Retry with backoff</div>
                <div class="gs">Failed writes retry 5× with growing gaps; a duplicate guard means a retry can never double-raise.</div></div>
                <div class="gr"><div class="gv">automatic</div></div></div>
              <div class="growc"><div class="gm"><div class="gt">Classify before retrying</div>
                <div class="gs">System down → retry. Payload rejected → stop and diagnose; never resend a bad request.</div></div>
                <div class="gr"><div class="gv">automatic</div></div></div>
              <div class="growc"><div class="gm"><div class="gt">Undo is first-class</div>
                <div class="gs">Every write stores its inverse; rolling a case back walks them in order, across systems.</div></div>
                <div class="gr"><div class="gv">on demand</div></div></div>
              <div class="growc"><div class="gm"><div class="gt">No dead ends</div>
                <div class="gs">After the retry budget, the case reaches a person with a diagnosis attached — not a mystery.</div></div>
                <div class="gr"><div class="gv">escalates</div></div></div>
            </div>
          </div>
          <div class="card" style="margin-top:14px">
            <div class="card-h"><div><div class="card-t">Live connection health</div>
              <div class="card-sub">One OMP write is retrying right now</div></div></div>
            <div class="card-b">
              <div class="sys">
                <span class="sysc"><span class="st"></span><b>ERP</b> <span class="vend">Oracle Fusion</span> ok</span>
                <button class="sysc warn" onclick="openRetry()"><span class="st"></span><b>Planning</b> <span class="vend">OMP</span> retry 2 of 5</button>
                <span class="sysc"><span class="st"></span><b>Warehouse</b> <span class="vend">Manhattan</span> ok</span>
                <span class="sysc"><span class="st"></span><b>Transport visibility</b> <span class="vend">project44</span> ok</span>
                <span class="sysc"><span class="st"></span><b>Data platform</b> <span class="vend">Databricks</span> ok</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
   </div>
  </div>

  <!-- ================= WORKFLOWS ================= -->
  <div class="view" id="p-workflows">
   <div class="body">

    <!-- entry -->
    <div class="view on" id="w-entry">
      <div class="wf-entry">
        <h1>What flow do you need to see?</h1>
        <p class="sub">Ask in your own words — the agent assembles it if we haven’t drawn it yet.</p>
        <div class="askbox">
          <div class="al"><i></i>Ask for a flow</div>
          <div class="askrow">
            <input id="wfAsk" placeholder="e.g. how does a credit note get approved?" onkeydown="if(event.key==='Enter')wfAskGo()">
            <button class="btn pr" onclick="wfAskGo()">Show me</button>
          </div>
          <div class="exq">
            <button onclick="wfAskEx('why does a requisition get held?')">why does a requisition get held?</button>
            <button onclick="wfAskEx('how does a damage claim clear?')">how does a damage claim clear?</button>
            <button onclick="wfAskEx('what never runs without a person?')">what never runs without a person?</button>
            <button onclick="wfAskEx('build me a returns flow')">build me a returns flow</button>
          </div>
        </div>
        <div class="ordiv">or pick a starting point</div>
        <div class="gcards" id="wfGroups"></div>
        <div class="entryfoot"><button class="btn" onclick="wfBoard()">Open the full board →</button></div>
      </div>
    </div>

    <!-- board -->
    <div class="view" id="w-board">
      <div class="wf-shell" id="wfShell">
        <aside class="wf-pane">
          <div class="lib-search">
            <input class="lib-input" id="wfq" placeholder="Search or ask…" autocomplete="off">
            <div class="libchips">
              <button onclick="wfAskEx('why does a requisition get held?')">why held?</button>
              <button onclick="wfAskEx('how does a damage claim clear?')">claims</button>
              <button onclick="wfAskEx('what never runs without a person?')">never alone</button>
              <button onclick="wfAskEx('build me a returns flow')">returns</button>
            </div>
            <div class="reveal-note" id="wfNote" hidden></div>
          </div>
          <div class="lib-list" id="wfLib"></div>
        </aside>
        <section class="wf-pane">
          <header class="cv-head">
            <button class="icobtn" onclick="wfLibToggle()" aria-label="Toggle flow library" title="Toggle flow library"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M9 4v16"></path><rect x="3" y="4" width="6" height="16" rx="2" fill="currentColor" stroke="none"></rect></svg></button>
            <button class="cv-back" onclick="wfHome()" aria-label="Back to start">←</button>
            <div style="min-width:0">
              <div class="cv-title" id="cvTitle"></div>
              <div class="cv-sub" id="cvSub"></div>
            </div>
            <div class="cv-stats" id="cvStats"></div>
            <button class="icobtn" onclick="wfInspToggle()" aria-label="Toggle details panel" title="Toggle details panel"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M15 4v16"></path><rect x="15" y="4" width="6" height="16" rx="2" fill="currentColor" stroke="none"></rect></svg></button>
          </header>
          <div class="cv-key">
            <span class="lg-row"><span class="lg-line" style="border-color:#a1a1aa"></span>expression</span>
            <span class="lg-row"><span class="lg-line" style="border-color:#005b89"></span>person decides</span>
            <span class="lg-row"><span class="lg-line" style="border-color:#b45309"></span>agent judgement</span>
            <span class="cv-hint">drag to pan · scroll to zoom · click any node</span>
          </div>
          <div class="wfcanvas" id="wfCanvas">
            <div class="wfstage" id="wfStage">
              <svg class="wfwires" id="wfWires"></svg>
              <div id="wfNodes"></div>
            </div>
            <div class="zstack">
              <button onclick="wfZoom(1)" aria-label="Zoom in">+</button>
              <button onclick="wfZoom(-1)" aria-label="Zoom out">−</button>
              <button onclick="wfFit()" aria-label="Fit">⤢</button>
              <span class="zv" id="wfzv" aria-live="polite">100%</span>
            </div>
          </div>
        </section>
        <aside class="wf-pane">
          <div class="rp-tabs">
            <button class="rp-tab on" data-r="det" onclick="rpTab('det')">Details</button>
            <button class="rp-tab" data-r="ask" onclick="rpTab('ask')">Ask</button>
          </div>
          <div class="rp-panel on" id="rp-det"></div>
          <div class="rp-panel" id="rp-ask"></div>
        </aside>
      </div>
    </div>
   </div>
  </div>

  <!-- ================= CASE THREAD ================= -->
  <div class="view" id="p-audit">
   <div class="body" style="padding:14px 18px 18px">

    <!-- case board -->
    <div class="view on" id="a-board">
      <div class="ct-shell">
        <div class="ct-head">
          <button class="icobtn" onclick="ctRail()" aria-label="Toggle case list" title="Toggle case list"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><rect x="3" y="4" width="6" height="16" rx="2" fill="currentColor" stroke="none"/></svg></button>
          <span class="cid" id="ct-id">EX-4472</span>
          <h2 id="ct-title">Coverage gap across 6 DCs</h2>
          <span class="pill warn" id="ct-pill">held for decision</span>
          <div class="ct-facts" id="ct-facts"></div>
          <div class="right">
            <span class="live"><span class="dot"></span> live</span>
            <div class="seg">
              <button class="on" data-m="route" onclick="ctMode('route')">Live route</button>
              <button data-m="explain" onclick="ctMode('explain')">Explain</button>
              <button data-m="simulate" onclick="ctMode('simulate')">Simulate</button>
              <button data-m="ledger" onclick="ctMode('ledger')">Ledger</button>
            </div>
            <button class="icobtn" onclick="ctInsp()" aria-label="Toggle inspector" title="Toggle inspector"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/><rect x="15" y="4" width="6" height="16" rx="2" fill="currentColor" stroke="none"/></svg></button>
          </div>
        </div>
        <div class="ct-body">
          <aside class="ct-rail" id="ctRailEl">
            <div class="railtabs">
              <button class="on" data-rt="cases" onclick="ctRailTab('cases')">Cases</button>
              <button data-rt="ask" onclick="ctRailTab('ask')">Ask</button>
              <button data-rt="activity" onclick="ctRailTab('activity')">Activity</button>
            </div>
            <div class="rail-b" id="ctRailBody"></div>
          </aside>
          <div class="ct-canvas" id="ctCanvas">
            <div class="ct-stage" id="ctStage">
              <svg class="ct-wires" id="ctWires"></svg>
              <div class="ct-rows" id="ctRows"></div>
            </div>
            <div class="simbanner">⚗ Simulated — production state unchanged</div>
            <button class="fitbtn" onclick="ctFit()">⤢ Fit to route</button>
            <div class="zstack">
              <button onclick="ctZoom(1)" aria-label="Zoom in">+</button>
              <button onclick="ctZoom(-1)" aria-label="Zoom out">−</button>
              <button onclick="ctFit()" aria-label="Fit">⤢</button>
            </div>
            <div class="minimap" id="ctMap"></div>
            <div class="replaybar">
              <div class="rb-ctrls">
                <button onclick="ctReplay(0)" aria-label="Jump to start">⏮</button>
                <button onclick="ctPlay()" id="ctPlayBtn" aria-label="Play">▶</button>
                <button onclick="ctReplay(999)" aria-label="Jump to now">⏭</button>
              </div>
              <span class="rb-live on" id="ctLive">((•)) Live</span>
              <div class="rb-dots" id="ctDots"></div>
              <span class="rb-sum" id="ctSum"></span>
            </div>
          </div>
          <aside class="ct-insp" id="ctInspEl">
            <div class="insp-h"><span class="il" id="ctInspLab">Step inspector</span>
              <button class="icobtn" style="margin-left:auto;width:24px;height:24px" onclick="ctInsp()" aria-label="Close">✕</button></div>
            <div class="insp-b" id="ctInspBody"></div>
          </aside>
        </div>
      </div>
    </div>

    <!-- ledger -->
    <div class="view" id="a-list">
      <div class="led-top">
        <div class="gv-head" style="flex:1;min-width:0">
          <h1>Every action, in the order it happened</h1>
          <p>One record per step, agent or human, hash-chained so an edited or deleted row breaks the chain rather than
            disappearing quietly. Open any record to jump to its case thread.</p>
        </div>
        <div class="right">
          <span class="live"><span class="dot"></span> live</span>
          <div class="seg">
            <button data-m="route" onclick="ctMode('route')">Live route</button>
            <button data-m="explain" onclick="ctMode('explain')">Explain</button>
            <button data-m="simulate" onclick="ctMode('simulate')">Simulate</button>
            <button data-m="ledger" class="on" onclick="ctMode('ledger')">Ledger</button>
          </div>
        </div>
      </div>
      <div class="kpis4">
        <div class="kpi"><div class="kpi-l">Records today</div><div class="kpi-v">43,120</div><div class="kpi-s">agent and human actions across 49 nodes</div></div>
        <div class="kpi"><div class="kpi-l">Taken by an agent</div><div class="kpi-v">99.7%</div><div class="kpi-s">42,981 cleared with no human touch</div></div>
        <div class="kpi"><div class="kpi-l">Reached a person</div><div class="kpi-v" id="kpiReach">139</div><div class="kpi-s">across four seats</div></div>
        <div class="kpi"><div class="kpi-l">Reason captured</div><div class="kpi-v">100%</div><div class="kpi-s">on every override and reject</div></div>
      </div>
      <div class="card">
        <div class="abar">
          <div class="asearch"><input id="aq" placeholder="Search by case, agent, reason, hash…" autocomplete="off"></div>
          <button class="fchip on" data-f="all">All</button>
          <button class="fchip" data-f="agent">Agent</button>
          <button class="fchip" data-f="human">Human</button>
          <button class="fchip" data-f="hold">Held</button>
          <button class="fchip" data-f="override">Overrides</button>
          <button class="fchip" data-f="policy">Policy</button>
          <span class="acount" id="aCount"></span>
        </div>
        <div class="note" id="refBanner" hidden style="margin:10px 16px 0"></div>
        <div class="ledwrap">
          <table class="ledger">
            <thead><tr><th>When</th><th>Action</th><th>Who</th><th>Intent</th><th>Cause</th><th>Reference</th><th>Record</th></tr></thead>
            <tbody id="auditList"></tbody>
          </table>
        </div>
        <div class="tfoot">Showing the most recent records · <button class="linky" onclick="copyCSV()">export as CSV</button>
          · <button class="linky" onclick="ctMode('route')">back to the case board</button></div>
      </div>
      <div class="card" style="margin-top:14px">
        <div class="card-h"><div><div class="card-t">Chain integrity</div>
          <div class="card-sub">Checked on load, not on request</div></div></div>
        <div class="card-b">
          <div class="chainok" id="chainState"></div>
          <div class="note" style="margin-top:12px"><b>One record, four views.</b> The thread is the log itself.
            <button class="linky" onclick="nav('govern')">Governance</button> is <span class="mono">policy.verdict</span> grouped by gate;
            <button class="linky" onclick="nav('workflows')">Workflows</button> is the template these records move through;
            the Control Tower rail is the ones that need you. Get the record right and every view comes free.</div>
        </div>
      </div>
    </div>

    <!-- record trail -->
    <div class="view" id="a-trail">
      <button class="backbtn" onclick="ctMode('ledger')">← Back to the ledger</button>
      <div id="trailBody"></div>
    </div>
   </div>
  </div>
</div>

<!-- overlays -->
<div class="scrim" id="scrim" onclick="closeAll()"></div>
<div class="drawer" id="drawer"><button class="dr-x" onclick="closeAll()" aria-label="Close">✕</button><div id="drbody"></div></div>
<div class="modal" id="modal">
  <div class="m-t">Decision packet — EX-4472</div>
  <div class="m-s">One bounded question. The investigation is attached, not re-opened.</div>
  <div class="opt rec"><h6>Iris recommends <span class="pill br">conf 0.88 · floor 0.85</span></h6>
    <p>Raise cover on 3 SKUs — the $214,000 PR. Unprotected: ~4.1% service loss on affected lines. Two smaller PRs already executed and verified.</p></div>
  <div class="opt"><h6>Alternative — partial cover</h6><p>Raise Dalton + Cartersville only (~$128k). Covers the two DCs that break first, leaves tail exposure.</p></div>
  <div class="opt"><h6>Alternative — do nothing</h6><p>Accept the service risk. Costs ≈ $1.8k/day in expedites if the window holds.</p></div>
  <div class="kv"><span>Policy check</span><b>$214k &gt; $150k limit — the only reason you're asked</b></div>
  <textarea class="rzn" id="rzn" placeholder="Reason (required to reject) — this trains the system"></textarea>
  <div class="rz-err" id="rzerr">A reason is required — it's what the system learns from.</div>
  <div class="m-f">
    <button class="btn dng" onclick="decide('reject')">Reject with reason</button>
    <button class="btn" onclick="closeAll()">Later</button>
    <button class="btn pr" onclick="decide('approve')">Approve PR · $214,000</button>
  </div>
</div>
<div class="toast" id="toastEl" role="status"></div>

<script>
/* ============ helpers & state ============ */
var $=function(id){return document.getElementById(id)};
function esc(s){return String(s).replace(/[&<>"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}
var S={p:'tower',tower:'today',agent:null,gv:'auth',held:true,paused:{},nudged4474:false,
       wf:'exception-triage',wfSel:null,wfx:0,wfy:14,wfz:1,audit:'board',aFilter:'all',aQ:'',aRef:null,caseId:'EX-4472',
       ctMode:'route',ctStep:null,ctRailTab:'cases',ctFilter:'all',ctQ:'',ctReplay:null,
       ctx:0,cty:8,ctz:1,simLimit:250000,simPreset:null,pendingProps:[]};

var AG={
 mercer:{n:'Mercer',r:'Buying agent',av:'M',bg:'var(--gradient-brand)',c:'var(--mercer)',health:94,
   d:'Owns the supplier lane: lead times, promise dates, vendor data.'},
 iris:{n:'Iris',r:'Planning agent',av:'I',bg:'var(--iris)',c:'var(--iris)',health:88,
   d:'Owns coverage and requisitions: replans DCs, raises PRs inside limits, holds the rest.'},
 christy:{n:'Christy',r:'Service agent',av:'C',bg:'var(--gradient-christy)',c:'var(--christy)',health:91,
   d:'Owns the customer promise: honest options, claims from records already held.'}};

/* ---- Governance: the single source every surface reads ---- */
var GOV={
 ver:'v4.2 · 12 Aug 2026',
 mercer:{thr:[
   {k:'LT_UPDATE_MAX',n:'Lead-time update window',v:15,min:0,max:30,fmt:'d',dev:'4%',hot:false,
    d:'Mercer updates vendor lead times inside this range on its own. The +10 day change cleared it.'},
   {k:'EXPOSURE_ALONE',n:'Exposure to act alone',v:50000,min:0,max:200000,fmt:'$',dev:'6%',hot:false,
    d:'Above this the update is drafted and a person confirms before it lands.'},
   {k:'CONF_FLOOR',n:'Confidence floor',v:0.85,min:.5,max:1,fmt:'c',lock:'Shared floor',
    d:'Below this it recommends but never executes, whatever the value.'}],
  never:'Vendor termination · category manager only'},
 iris:{thr:[
   {k:'PR_AUTO_LIMIT',n:'Auto-raise purchase requisitions',v:150000,min:0,max:500000,fmt:'$',dev:'18%',hot:true,
    d:'Above this the PR is drafted but held for the planner. Today: 19 held, 1 still open.'},
   {k:'SS_MOVE_MAX',n:'Safety stock adjustment',v:25,min:0,max:100,fmt:'%',dev:'3%',hot:false,
    d:'Larger moves need a person, even when confidence is high.'},
   {k:'CONF_FLOOR',n:'Confidence floor',v:0.85,min:.5,max:1,fmt:'c',lock:'Shared floor',
    d:'Below this it recommends but never executes.'}],
  never:'Customer credit · service lead only'},
 christy:{thr:[
   {k:'ABSORB_MAX',n:'Price difference absorbed',v:5,min:0,max:15,fmt:'%',dev:'2%',hot:false,
    d:'An alternate product inside this gap is offered with the difference absorbed.'},
   {k:'CREDIT_LIMIT',n:'Claim credit alone',v:10000,min:0,max:50000,fmt:'$',dev:'5%',hot:false,
    d:'A validated claim inside this issues without asking anyone.'},
   {k:'CONF_FLOOR',n:'Confidence floor',v:0.85,min:.5,max:1,fmt:'c',lock:'Shared floor',
    d:'Below this it recommends but never executes.'}],
  never:'Product substitution · the customer decides'}};
function fmtV(t){
  if(t.fmt==='$')return '$'+t.v.toLocaleString();
  if(t.fmt==='%')return t.v+'%';
  if(t.fmt==='d')return t.v+' days';
  return t.v.toFixed(2);
}

/* ---- agent operating plans (UiPath-style stages) ---- */
var PLANS={
 mercer:{loop:'outcomes vs baseline tune the next detection — logged to Databricks',
  stages:[
   {n:'Detect',tasks:[{b:'Watch supplier feeds',s:'EDI 824 · promise dates',live:'EX-4479 · 3 signals'},{b:'Watch PO slippage',s:'47 open orders'}]},
   {n:'Assess',tasks:[{b:'Which orders slip',s:'new LT vs promise dates',live:'EX-4479 · 31 of 47'},{b:'Float check',s:'orders that absorb the delay'}]},
   {n:'Impact',tasks:[{b:'Trace to customers',s:'install dates inside the slip'},{b:'Size the exposure',s:'dollars at risk per order'}]},
   {n:'Recommend',tasks:[{b:'Cost three options',s:'expedite · re-source · absorb'}]},
   {n:'Decide',gate:true,tasks:[{b:'LT window',s:'gate',gk:'LT_UPDATE_MAX'},{b:'Exposure cap',s:'gate',gk:'EXPOSURE_ALONE'},{b:'Confidence floor',s:'gate',gk:'CONF_FLOOR'}]},
   {n:'Act',tasks:[{b:'Write lead time + PO dates',s:'Fusion · verified',ok:true},{b:'Hand off to Iris',s:'HO-8831 · replan cover'}]},
   {n:'Learn',tasks:[{b:'Log outcome vs baseline',s:'6.1s vs 3.5 days'}]}]},
 iris:{loop:'override reasons reshape the next recommendation — governed in Learning',
  stages:[
   {n:'Detect',tasks:[{b:'Pick up handoffs',s:'HO-8831 accepted 08:14:09'},{b:'Coverage signals',s:'service targets by DC'}]},
   {n:'Assess',tasks:[{b:'Where cover breaks',s:'6 DCs vs the longer lead time',live:'EX-4480 · running'}]},
   {n:'Impact',tasks:[{b:'Cost both sides',s:'service loss vs working capital',live:'EX-4480 · trade-off'}]},
   {n:'Recommend',tasks:[{b:'Safety stock + PRs',s:'+18% on 3 SKUs · 3 PRs drafted'}]},
   {n:'Decide',gate:true,tasks:[{b:'PR limit',s:'gate',gk:'PR_AUTO_LIMIT'},{b:'Stock move band',s:'gate',gk:'SS_MOVE_MAX'},{b:'Confidence floor',s:'gate',gk:'CONF_FLOOR'}]},
   {n:'Act',tasks:[{b:'Write stock + PRs',s:'OMP + Fusion · verified',ok:true},{b:'Queue the held one',s:'full reasoning attached',held:true}]},
   {n:'Learn',tasks:[{b:'Capture override reasons',s:'fed to Learning governance'}]}]},
 christy:{loop:'which offers customers actually take reshapes how options are ordered',
  stages:[
   {n:'Detect',tasks:[{b:'Promises vs revised dates',s:'from the order record'},{b:'Claims from evidence',s:'POD + photos',live:'CL-2210 · waiting'}]},
   {n:'Assess',tasks:[{b:'Real alternative?',s:'stock, spec, price checked'}]},
   {n:'Impact',tasks:[{b:'Cost to the customer',s:'a booked crew, not freight'}]},
   {n:'Recommend',tasks:[{b:'Two honest options',s:'both costed against the promise'}]},
   {n:'Decide',gate:true,tasks:[{b:'Absorb band',s:'gate',gk:'ABSORB_MAX'},{b:'Credit limit',s:'gate',gk:'CREDIT_LIMIT'},{b:'Product choice',s:'never alone — customer decides'}]},
   {n:'Act',tasks:[{b:'Re-commit dates, issue credits',s:'Fusion · verified',ok:true},{b:'Soft-hold stock',s:'48h so the choice stays real'}]},
   {n:'Learn',tasks:[{b:'Log choice patterns',s:'by offer type and segment'}]}]}};

var AGDATA={
 mercer:{tiles:[['Handled','89'],['Held','7'],['Value','$41k']],
  cases:[['EX-4471','Lead time written · 41 POs verified','$38.2k'],['EX-4479','Assessing 3 new signals','—']],
  presets:[{l:'LT +8 days · $32k',days:8,amt:32000},{l:'LT +22 days · $18k',days:22,amt:18000},{l:'LT +10 days · $80k',days:10,amt:80000}],
  head:'Watching 47 open orders on VN-2210',pill:'<span class="pill ok">on it</span>',bar:86,barl:'autonomy L2 · 86% to L3',ft:'started 4 min ago'},
 iris:{tiles:[['Handled','64'],['Held','19'],['Value','$52k']],
  cases:[['EX-4472','2 PRs executed · 1 held for you','$122k'],['EX-4480','Coverage check running','—']],
  presets:[{l:'$95k coverage gap',amt:95000},{l:'$230k coverage gap',amt:230000},{l:'$150k exactly',amt:150000}],
  head:'A $214,000 requisition needs you',pill:'<span class="pill warn">input needed</span>',bar:52,barl:'autonomy L2 · holding',ft:'ready since 08:14'},
 christy:{tiles:[['Handled','60'],['Held','8'],['Value','$36k']],
  cases:[['EX-4474','Claim validated · credit issuing','$8.4k'],['CL-2210','Waiting on customer photos','—']],
  presets:[{l:'$6,200 damage claim',amt:6200},{l:'$14,500 damage claim',amt:14500},{l:'alternate at 4% gap',amt:4,pct:true}],
  head:'Credit issued, customer confirming',pill:'<span class="pill info">on track</span>',bar:74,barl:'autonomy L3 · widest limits',ft:'updated 34s ago'}};

/* ============ nav ============ */
function nav(p){
  S.p=p;
  document.querySelectorAll('.ptab').forEach(function(t){t.classList.toggle('on',t.dataset.p===p)});
  ['tower','govern','workflows','audit'].forEach(function(k){$('p-'+k).classList.toggle('on',k===p)});
  if(p==='workflows'){renderWFEntry();if($('w-board').classList.contains('on')){renderWF();requestAnimationFrame(wfFit)}}
  if(p==='govern')renderGov();
  if(p==='audit')renderAudit();
}
function towerHome(){S.tower='today';$('t-today').classList.add('on');$('t-agent').classList.remove('on')}
function towerTab(t){
  document.querySelectorAll('#t-today .tabsrow button').forEach(function(b){b.classList.toggle('on',b.dataset.t===t)});
  ['activity','systems','overrides','value'].forEach(function(k){$('tp-'+k).classList.toggle('on',k===t)});
}
function gvTab(g){
  S.gv=g;
  document.querySelectorAll('#p-govern .tabsrow button').forEach(function(b){b.classList.toggle('on',b.dataset.g===g)});
  ['auth','learn','sys'].forEach(function(k){$('gp-'+k).classList.toggle('on',k===g)});
  renderGov();
}
</script>
<script>
/* ============ tower · today ============ */
function renderAgCards(){
  var el=$('agCards');if(!el)return;
  el.innerHTML=['mercer','iris','christy'].map(function(k){
    var g=AG[k],w=AGDATA[k],p=S.paused[k];
    var head=p?'Paused — finishing in-flight work':(k==='iris'&&!S.held?'All requisitions cleared':w.head);
    var pill=p?'<span class="pill nu">paused</span>':(k==='iris'&&!S.held?'<span class="pill ok">on it</span>':w.pill);
    var held=k==='iris'&&!S.held?String(+w.tiles[1][1]-1):w.tiles[1][1];
    return '<button class="agc'+(p?' paused':'')+'" style="--ac:'+g.c+'" onclick="openAgent(\''+k+'\')">'+
      '<span class="tab">'+g.n+' · '+g.r.split(' ')[0]+'</span>'+
      '<div class="cb"><h4>'+head+'</h4><span class="stpill">'+pill+'</span>'+
      '<div class="mini">Today</div>'+
      '<div class="mrow"><div><b>'+w.tiles[0][1]+'</b><span>handled</span></div>'+
      '<div><b>'+held+'</b><span>held</span></div><div><b>'+w.tiles[2][1]+'</b><span>value</span></div></div>'+
      '<div class="hbar"><i style="width:'+w.bar+'%'+(k==='christy'?';background:var(--gp-green)':'')+'"></i></div>'+
      '<div style="font-size:10.5px;color:var(--text-neutral);margin-bottom:2px">'+w.barl+'</div>'+
      '<div class="ft">'+(p?'paused':w.ft)+'<span class="lk">How it works →</span></div></div></button>';
  }).join('');
}
function renderRail(){
  var el=$('towerRail');if(!el)return;
  var d=new Date();
  var stamp=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()]+' '+d.getDate()+' '+
    ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()];
  if(S.held){
    el.innerHTML='<div class="rd">Today · '+stamp+'</div><h3>Coverage gap across 6 DCs</h3>'+
    '<div class="tags"><span>EX-4472</span><span>Iris · planning</span><span>parent EX-4471</span></div>'+
    '<div class="rl">Findings</div>'+
    '<div class="finding"><div class="fh">⚠ Held — needs your decision</div><ul>'+
    '<li>Cover breaks on 3 SKUs across 6 DCs from day 12</li>'+
    '<li>The $214,000 requisition sits above your $150,000 limit</li>'+
    '<li>Two smaller requisitions already ran and were verified</li>'+
    '<li>Confidence 0.88 cleared the 0.85 floor — authority stopped it, not doubt</li></ul>'+
    '<div class="ff">Waiting 2h 11m<span class="pill warn" style="margin-left:auto">$1.8k/day</span></div></div>'+
    '<div class="rl">Recommended plan</div>'+
    '<div class="pstep now"><div class="pn">1</div><div><div class="pw">Now · waiting on you</div>'+
    '<div class="pb"><b>Approve the $214,000 requisition</b><span>Raises cover on 3 SKUs before the window closes</span></div></div></div>'+
    '<div class="pstep"><div class="pn">2</div><div><div class="pw">Immediately after</div>'+
    '<div class="pb"><b>Iris writes to Fusion and OMP</b><span>Closes only once both systems confirm</span></div></div></div>'+
    '<div class="pstep"><div class="pn">3</div><div><div class="pw">Ongoing</div>'+
    '<div class="pb"><b>Outcome logged against the baseline</b><span>Feeds the next coverage recommendation</span></div></div></div>'+
    '<button class="btn pr execbtn" onclick="openPacket()">Open the decision packet</button>'+
    railCases();
  }else{
    el.innerHTML='<div class="rd">Today · '+stamp+'</div><h3>Nothing is waiting on you</h3>'+
    '<div class="tags"><span>all cases inside limits</span><span>or waiting on someone outside</span></div>'+
    '<div class="rl">Findings</div>'+
    '<div class="finding okc"><div class="fh">✓ Clear — agents acting inside their limits</div><ul>'+
    '<li>EX-4472 answered — the outcome is in the Audit Trail</li>'+
    '<li>EX-4474 credit issued and verified; customer confirming</li>'+
    '<li>One OMP write retrying with a duplicate guard</li></ul></div>'+
    '<div class="rl">Worth a look</div>'+
    '<div class="pstep now"><div class="pn">1</div><div><div class="pw">Proposed</div>'+
    '<div class="pb"><b>Phase-out check before cover</b><span>From Dana R.’s override · 3 repeats suppressed in backtest</span></div></div></div>'+
    '<div class="pstep"><div class="pn">2</div><div><div class="pw">Optional</div>'+
    '<div class="pb"><b>Revisit the $150,000 limit</b><span>5 requisitions were above the line this month</span></div></div></div>'+
    '<button class="btn execbtn" onclick="nav(\'govern\');gvTab(\'learn\')">Review in Governance</button>'+
    railCases();
  }
}
function railCases(){
  var rank={held:0,waiting:1,active:2,overridden:3,done:4};
  var list=CTORDER.slice().sort(function(a,b){
    var ra=rank[CASES[a].status],rb=rank[CASES[b].status];
    if(!S.held&&a==='EX-4472')ra=4;if(!S.held&&b==='EX-4472')rb=4;
    return ra-rb;
  }).slice(0,4);
  return '<div class="rl">Cases worth watching</div>'+list.map(function(k){
    var c=CASES[k],held=k==='EX-4472'&&!S.held,pill=held?['ok','decided']:c.pill;
    return '<button class="ccard" style="margin-bottom:7px" onclick="openCase(\''+k+'\')">'+
      '<div class="ct1"><span class="cid2">'+k+'</span><span class="cval">'+c.val+'</span></div>'+
      '<span class="cnm">'+esc(c.title)+'</span>'+
      '<span class="cft"><span class="pill '+pill[0]+'">'+pill[1]+'</span>'+
      '<span class="ctime">⏱ '+c.elapsed+'</span></span></button>';
  }).join('')+'<button class="linky" style="margin-top:4px" onclick="nav(\'audit\')">Open the full case thread →</button>';
}
function towerAskEx(q){$('towerAsk').value=q;towerAskGo()}
function towerAskGo(){
  var q=($('towerAsk').value||'').toLowerCase().trim();
  if(!q){toast('Tell the agents what you need, or tap a suggestion.');return}
  if(/attention|need|waiting/.test(q)){if(S.held){openPacket()}else{toast('Nothing is waiting on you right now.')}return}
  if(/214|held|why/.test(q)){nav('audit');openCase('EX-4472');return}
  if(/buying|flow|po|requisition|claim|opportunit/.test(q)){nav('workflows');wfAskEx(q);return}
  if(/recover|value|saved|today/.test(q)){towerTab('value');toast('$129k protected today — median 74m vs a 38h manual baseline.');return}
  nav('workflows');wfAskEx(q);
}

/* ============ tower · agent page ============ */
var SIMRES=null;
function openAgent(k){
  S.agent=k;S.tower='agent';S.simPreset=null;SIMRES=null;
  $('t-today').classList.remove('on');$('t-agent').classList.add('on');
  var g=AG[k],w=AGDATA[k];
  $('agp-av').textContent=g.av;$('agp-av').style.background=g.bg;
  $('agp-name').textContent=g.n;$('agp-role').textContent=g.r;
  $('agp-switch').innerHTML=Object.keys(AG).map(function(x){var a=AG[x];
    return '<button class="asw'+(x===k?' on':'')+'" role="tab" aria-selected="'+(x===k)+'" onclick="openAgent(\''+x+'\')">'+
      '<span class="aav" style="background:'+a.bg+'">'+a.av+'</span>'+a.n+'</button>'}).join('');
  $('agp-pill').className='pill '+(S.paused[k]?'nu':'ok');
  $('agp-pill').textContent=S.paused[k]?'paused':'running';
  $('agp-sw').classList.toggle('off',!!S.paused[k]);
  $('agp-sw').setAttribute('aria-checked',String(!S.paused[k]));
  $('agp-vtl').textContent=g.n+' today';
  $('planLoop').textContent=PLANS[k].loop;
  $('agp-tiles').innerHTML=w.tiles.map(function(t){
    return '<div class="vt-tile"><dt>'+t[0]+'</dt><dd>'+t[1]+'</dd></div>'}).join('');
  $('agp-cases').innerHTML=w.cases.map(function(c){
    return '<div class="vc-row"><button class="linky" onclick="openCase(\''+c[0]+'\')">'+c[0]+'</button>'+
      '<span class="vd">'+c[1]+'</span><span class="vv">'+c[2]+'</span></div>'}).join('');
  renderAuthMini(k);renderPlan(k,null);renderSimPresets(k);
  $('simOut').innerHTML='<div class="note">Pick a sample case or type an amount, then Run — the plan above lights up with what would happen under policy '+GOV.ver.split(' ')[0]+'.</div>';
  $('simAmt').value='';
}
function agpPause(){
  var k=S.agent;S.paused[k]=!S.paused[k];
  openAgent(k);renderAgCards();
  var run=$('ss-run');if(run)run.textContent=3-Object.keys(S.paused).filter(function(x){return S.paused[x]}).length;
  toast(S.paused[k]?AG[k].n+' paused — no new cases; in-flight work finishes safely.':AG[k].n+' active again.');
}
function renderAuthMini(k){
  $('agp-auth').innerHTML=GOV[k].thr.map(function(t){
    var pct=t.fmt==='c'?(t.v-t.min)/(t.max-t.min)*100:t.v/t.max*100;
    return '<div class="auth-row"><div class="auth-h"><span class="auth-n">'+t.n+'</span>'+
      '<span class="auth-v">'+fmtV(t)+'</span></div>'+
      '<div class="auth-track"><i style="width:'+pct+'%"></i></div>'+
      '<div class="auth-src">'+t.k+' · '+GOV.ver+'</div></div>';
  }).join('')+'<div class="auth-row"><div class="auth-h"><span class="auth-n">Never alone</span>'+
    '<span style="font-size:11.5px;color:var(--muted-foreground)">'+GOV[k].never+'</span></div></div>';
}
function renderPlan(k,sim){
  var row=$('planRow');
  row.innerHTML=PLANS[k].stages.map(function(st,i){
    var simcls='';
    if(sim){
      if(sim.stage>i)simcls=' simon';
      if(sim.stage===i)simcls=sim.held?' simheld':' simon';
    }
    var tasks=st.tasks.map(function(t){
      var cls='task';
      if(t.gk&&sim&&sim.stage>=4){
        var gp=sim.gates[t.gk];
        if(gp===true)cls+=' simpass';else if(gp===false)cls+=' simfail';
      }else{
        if(t.gk)cls+=' gate';
        if(t.live)cls+=' live';
        if(t.ok)cls+=' okr';
        if(t.held&&S.held)cls+=' gate';
      }
      var sub=t.gk?gateLabel(k,t.gk,sim):(t.live||t.s);
      return '<button class="'+cls+'" onclick="taskDrawer(\''+k+'\','+i+',\''+esc(t.b).replace(/'/g,"\\'")+'\')">'+
        '<span class="ti">'+(t.gk?'◇':(i+1))+'</span><span><b>'+t.b+'</b><span>'+sub+'</span></span></button>';
    }).join('');
    return (i>0?'<div class="plan-arrow">›</div>':'')+
      '<div class="stgcard'+simcls+'"><div class="stg-h">'+(st.gate?'<span class="gatemark">◇</span>':'')+
      '<b>'+st.n+'</b><span class="cnt">'+st.tasks.length+'</span></div>'+
      '<div class="stg-b">'+tasks+'</div></div>';
  }).join('');
}
function gateLabel(k,gk,sim){
  var t=GOV[k].thr.filter(function(x){return x.k===gk})[0];
  if(!t)return '';
  if(sim&&sim.vals&&sim.vals[gk]!==undefined){
    return sim.vals[gk]+' vs '+fmtV(t)+(sim.gates[gk]?' ✓':' ✗ holds');
  }
  return 'limit '+fmtV(t);
}
function taskDrawer(k,i,b){
  var st=PLANS[k].stages[i];
  openDrawer('<div class="dr-k">'+AG[k].n+' · '+st.n+'</div><div class="dr-t">'+esc(b)+'</div>'+
    '<div class="dr-s">One step of the operating plan. Gates read their numbers live from Governance; live chips are real instances sitting at this step now.</div>'+
    '<div class="kv"><span>Stage</span><b>'+st.n+'</b></div>'+
    '<div class="kv"><span>Agent</span><b>'+AG[k].n+'</b></div>'+
    (st.gate?'<div class="kv"><span>Policy version</span><b>'+GOV.ver+'</b></div>':'')+
    '<div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">'+
    (st.gate?'<button class="btn" onclick="closeAll();nav(\'govern\');gvTab(\'auth\')">Open in Governance</button>':'')+
    '<button class="btn" onclick="closeAll();nav(\'workflows\')">See it in a workflow</button></div>');
}
function renderSimPresets(k){
  $('simPresets').innerHTML=AGDATA[k].presets.map(function(p,i){
    return '<button class="'+(S.simPreset===i?'on':'')+'" onclick="pickPreset('+i+')">'+p.l+'</button>';
  }).join('');
}
function pickPreset(i){S.simPreset=i;$('simAmt').value='';renderSimPresets(S.agent);runSim()}
function runSim(){
  var k=S.agent,g=GOV[k],p=null;
  var amt=parseInt(($('simAmt').value||'').replace(/[^0-9]/g,''),10);
  if(S.simPreset!==null&&!amt)p=AGDATA[k].presets[S.simPreset];
  else if(amt){p={amt:amt,days:10}}
  else{toast('Pick a sample case or type an amount first.');return}
  if($('simAmt').value)S.simPreset=null,renderSimPresets(k);
  var gates={},vals={},held=false,lines=[];
  g.thr.forEach(function(t){
    var pass=true,val='';
    if(t.k==='PR_AUTO_LIMIT'||t.k==='EXPOSURE_ALONE'||t.k==='CREDIT_LIMIT'){val='$'+(p.amt||0).toLocaleString();pass=(p.amt||0)<=t.v}
    else if(t.k==='LT_UPDATE_MAX'){val=(p.days||10)+' days';pass=(p.days||10)<=t.v}
    else if(t.k==='SS_MOVE_MAX'){val='18%';pass=18<=t.v}
    else if(t.k==='ABSORB_MAX'){val=(p.pct?p.amt:4)+'%';pass=(p.pct?p.amt:4)<=t.v}
    else if(t.k==='CONF_FLOOR'){val='0.90';pass=true}
    gates[t.k]=pass;vals[t.k]=val;
    if(!pass)held=true;
    lines.push({n:t.n,val:val,lim:fmtV(t),pass:pass});
  });
  SIMRES={stage:6,held:held,gates:gates,vals:vals};
  renderPlan(k,{stage:4,held:false,gates:{},vals:{}});
  var step=4;
  var iv=setInterval(function(){
    step++;
    renderPlan(k,{stage:step,held:held&&step>=4,gates:gates,vals:vals});
    if(step>=6)clearInterval(iv);
  },420);
  $('simOut').innerHTML='<div class="sim-out '+(held?'hold':'pass')+'">'+
    (held?'<b>It would stop.</b> The safe parts run; the rest is drafted and held for a person — exactly like EX-4472.':
    '<b>It would run end to end.</b> Every gate passes; writes execute and verify without a person.')+
    '<div class="sim-steps">'+lines.map(function(l){
      return '<div class="sim-step '+(l.pass?'pass':'fail')+'"><span>'+l.n+'</span>'+
        '<span class="sv">'+l.val+' vs '+l.lim+' '+(l.pass?'✓':'✗ holds')+'</span></div>';
    }).join('')+'</div>'+
    '<div style="margin-top:9px;font-size:11px;color:var(--muted-foreground)">Simulated against '+GOV.ver+' — change a limit in Governance and this same case answers differently.</div></div>';
}
</script>
<script>
/* ============ governance ============ */
function renderGov(){
  if(S.gv==='auth')renderAuthCards();
  if(S.gv==='learn')renderProps();
}
function renderAuthCards(){
  $('authCards').innerHTML=['mercer','iris','christy'].map(function(k){
    var g=AG[k];
    return '<div class="card"><div class="card-h">'+
      '<div class="av" style="width:26px;height:26px;border-radius:7px;font-size:11px;background:'+g.bg+'">'+g.av+'</div>'+
      '<div><div class="card-t">'+g.n+' — '+g.r.toLowerCase()+'</div>'+
      '<div class="card-sub">read by its Decide gate on every case</div></div>'+
      '<span class="ver">'+GOV.ver+'</span></div>'+
      '<div class="card-b">'+GOV[k].thr.map(function(t){
        var pct=t.fmt==='c'?(t.v-t.min)/(t.max-t.min)*100:t.v/t.max*100;
        return '<div class="thr"><div class="thr-h"><span class="thr-n">'+t.n+'</span>'+
          (t.lock?'<span class="locked">'+t.lock+'</span>':'<span class="dev '+(t.hot?'hot':'okd')+'">'+t.dev+' deviation</span>')+
          '<span class="thr-v">'+fmtV(t)+'</span></div>'+
          '<p class="thr-d">'+t.d+'</p>'+
          '<div class="track"><div class="track-f" style="width:'+pct+'%"></div><div class="track-k" style="left:'+pct+'%"></div></div>'+
          '<div class="scale"><span>'+(t.fmt==='$'?'$0':t.fmt==='c'?t.min.toFixed(2):'0')+'</span><span>'+
            (t.fmt==='$'?'$'+t.max.toLocaleString():t.fmt==='%'?t.max+'%':t.fmt==='d'?t.max+' days':t.max.toFixed(2))+'</span></div>'+
          '<div class="thr-src">'+t.k+' · '+k+'</div>'+
          (t.lock?'':'<div style="margin-top:9px"><button class="btn sm" onclick="modifyThr(\''+k+'\',\''+t.k+'\')">Modify — simulate first</button></div>')+
          '</div>';
      }).join('')+
      '<div class="note" style="margin-top:10px"><b>Never alone:</b> '+GOV[k].never+'</div>'+
      '</div></div>';
  }).join('');
}
var HOLDS90=[['EX-4472',214000],['EX-4451',182400],['EX-4438',168000],['EX-4429',296500],['EX-4415',157300]];
function modifyThr(k,tk){
  var t=GOV[k].thr.filter(function(x){return x.k===tk})[0];
  var isPR=tk==='PR_AUTO_LIMIT';
  openDrawer('<div class="dr-k">Governance · modify a threshold</div>'+
    '<div class="dr-t">'+t.n+'</div>'+
    '<div class="dr-s">Move the number, watch the replay, then send it to the policy owner. Nothing changes until it is approved and versioned — and never mid-run.</div>'+
    '<div class="kv"><span>Current</span><b>'+fmtV(t)+'</b></div>'+
    '<div class="kv"><span>Source key</span><b>'+t.k+'</b></div>'+
    '<div style="margin:14px 0 6px"><input type="range" id="thrSlider" min="'+t.min+'" max="'+t.max+'" step="'+(t.fmt==='$'?10000:1)+'" value="'+t.v+'" style="width:100%;accent-color:var(--brand)" oninput="thrSim(\''+k+'\',\''+tk+'\',+this.value)"></div>'+
    '<div id="thrSimOut"></div>'+
    '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">'+
    '<button class="btn pr" id="thrPropose" onclick="proposeThr(\''+k+'\',\''+tk+'\')">Send to policy owner</button>'+
    '<button class="btn" onclick="closeAll()">Cancel</button></div>'+
    '<div class="warncard" style="margin-top:14px">Simulation replays <b>recorded outcomes</b>, not counterfactuals. It knows what a planner did with a case that reached them — not what they would have done with one that never did.</div>');
  thrSim(k,tk,t.v);
}
var THRNEW=null;
function thrSim(k,tk,v){
  THRNEW=v;
  var t=GOV[k].thr.filter(function(x){return x.k===tk})[0];
  var out=$('thrSimOut');if(!out)return;
  var vf=t.fmt==='$'?'$'+v.toLocaleString():t.fmt==='%'?v+'%':t.fmt==='d'?v+' days':v;
  if(tk!=='PR_AUTO_LIMIT'){
    out.innerHTML='<div class="simbox"><div class="sb-t">Proposed: '+vf+'</div>'+
      '<div class="sb-note">90-day replay for this dial is directional — few cases crossed it in the window. The proposal still goes through the policy owner with the replay attached.</div></div>';
    return;
  }
  var freed=HOLDS90.filter(function(h){return h[1]<=v}).length;
  var sum=HOLDS90.filter(function(h){return h[1]<=v}).reduce(function(s,h){return s+h[1]},0);
  out.innerHTML='<div class="simbox"><div class="sb-t">What the last 90 days would have looked like at '+vf+'</div>'+
    '<div class="sb-row">'+
    '<div class="sb-i"><div class="sb-v" style="color:var(--pill-success-fg)">'+freed+'</div><div class="sb-l">needless holds removed — approved with no change</div></div>'+
    '<div class="sb-i"><div class="sb-v" style="color:var(--destructive)">0</div><div class="sb-l">would have slipped through that a planner actually stopped</div></div>'+
    '<div class="sb-i"><div class="sb-v">'+(HOLDS90.length-freed)+'</div><div class="sb-l">still held — the gate earned those</div></div>'+
    '<div class="sb-i"><div class="sb-v">$'+Math.round(sum/1000)+'k</div><div class="sb-l">would move to auto-execution</div></div></div>'+
    '<div class="sb-note">The number that matters is the second one. Removing holds <em>and</em> letting something through is not a calibration — it is a loosening, and it needs arguing for on its own terms.</div></div>';
}
function proposeThr(k,tk){
  var t=GOV[k].thr.filter(function(x){return x.k===tk})[0];
  if(THRNEW===t.v){toast('That is the current value — move the slider to propose a change.');return}
  var vf=t.fmt==='$'?'$'+THRNEW.toLocaleString():t.fmt==='%'?THRNEW+'%':t.fmt==='d'?THRNEW+' days':THRNEW;
  S.pendingProps.push({t:t.n+' → '+vf,agent:AG[k].n,by:'you · just now'});
  closeAll();gvTab('learn');
  toast('Proposed: '+t.n+' → '+vf+'. Sent to the policy owner with the replay attached.');
}
function renderProps(){
  var el=$('propList');if(!el)return;
  var h='<div class="prop"><div class="ph"><span class="pt">Read the phase-out flag before any cover recommendation</span>'+
    '<span class="pill br">awaiting policy owner</span></div>'+
    '<div class="pd">Born from Dana R.&rsquo;s rejection of EX-4468 — "SKU 44-2213 phases out in Q4." Backtested against 90 days of history.</div>'+
    '<div class="simbox" style="margin-top:10px"><div class="sb-t">Backtest</div><div class="sb-row">'+
    '<div class="sb-i"><div class="sb-v" style="color:var(--pill-success-fg)">3</div><div class="sb-l">wrong recommendations suppressed</div></div>'+
    '<div class="sb-i"><div class="sb-v" style="color:var(--destructive)">0</div><div class="sb-l">good recommendations lost</div></div>'+
    '<div class="sb-i"><div class="sb-v">90d</div><div class="sb-l">replay window · no side effects</div></div></div></div>'+
    '<div class="pf"><button class="btn pr" onclick="approveProp(this)">Approve — versions to v4.3</button>'+
    '<button class="btn" onclick="toast(\'Sent back for a longer replay window.\')">Request more testing</button>'+
    '<span style="font-size:11px;color:var(--text-neutral)">rollback stays available after approval</span></div></div>';
  S.pendingProps.forEach(function(p){
    h+='<div class="prop"><div class="ph"><span class="pt">'+esc(p.t)+'</span><span class="pill br">awaiting policy owner</span></div>'+
      '<div class="pd">'+esc(p.agent)+' threshold change · proposed by '+esc(p.by)+' · replay attached.</div>'+
      '<div class="pf"><button class="btn" onclick="withdrawProp(this)">Withdraw</button></div></div>';
  });
  el.innerHTML=h;
  $('verHist').innerHTML=
    '<div class="verrow"><span class="vv">v4.3</span><span>Phase-out check before cover recommendations <span class="pill br" style="margin-left:6px">proposed</span></span><span class="vw">from override b77c…1e4</span></div>'+
    '<div class="verrow"><span class="vv">v4.2</span><span>Lead-time updates scoped by source origin, not vendor</span><span class="vw">12 Aug · from Marcus O.</span></div>'+
    '<div class="verrow"><span class="vv">v4.1</span><span>PR limit raised $120k → $150k after replay</span><span class="vw">28 Jul · policy owner</span></div>'+
    '<div class="verrow"><span class="vv">v4.0</span><span>Confidence floor unified at 0.85 across agents</span><span class="vw">02 Jul</span></div>'+
    '<div class="note" style="margin-top:12px">Approval versions the policy and cascades on the next run — never mid-flight. Every version can be rolled back.</div>';
}
function approveProp(btn){
  var p=btn.closest('.prop');
  p.querySelector('.pill').className='pill ok';
  p.querySelector('.pill').textContent='approved · live from next run';
  p.querySelector('.pf').innerHTML='<button class="btn" onclick="toast(\'Rolled back — v4.2 active again from the next run.\')">Roll back</button>'+
    '<span style="font-size:11px;color:var(--text-neutral)">v4.3 · cascades on the next run</span>';
  var vc=$('verChip');if(vc)vc.textContent='v4.3 · today';
  var pb=$('polBtn');if(pb)pb.textContent='policy v4.3';
  toast('Approved. Policy v4.3 goes live on the next run — 3 repeat recommendations will be suppressed.');
}
function withdrawProp(btn){btn.closest('.prop').remove();toast('Proposal withdrawn.')}
function openRetry(){
  openDrawer('<div class="dr-k">Systems · live retry</div><div class="dr-t">OMP — safety-stock write, attempt 2 of 5</div>'+
    '<div class="dr-s">Every action is a promise: held open until OMP confirms. The retry carries a duplicate guard, so trying again can never double-raise.</div>'+
    '<div class="kv"><span>Attempt 1 · 09:44:07</span><b>timeout after 4.0s</b></div>'+
    '<div class="kv"><span>Attempt 2 · 09:44:19</span><b>in flight ↻</b></div>'+
    '<div class="kv"><span>Next if it fails</span><b>09:44:43 · backoff ×2</b></div>'+
    '<div class="kv"><span>Duplicate guard</span><b>req-8f2a · idempotent</b></div>'+
    '<div class="kv"><span>After 5 failures</span><b>a person gets the diagnosis</b></div>'+
    '<div style="margin-top:16px"><button class="btn" onclick="closeAll();nav(\'govern\');gvTab(\'sys\')">Recovery rules</button></div>');
}
</script>
<script>
/* ============ workflows ============ */
/* node kinds: gate · ai · human · step · term · start
   coords are in a 1020×900 stage; edges carry a labelled kind */
var WFS={
 'exception-triage':{name:'Exception triage',group:'Planning',owner:'Iris · planner',
  sub:'What the nightly run resolves on its own, and what reaches a planner with the evidence attached',
  nodes:[
   {id:'g1',x:376,y:16,k:'gate',t:'Safe to resolve alone?',d:'Routine movement inside policy with no escalating signal resolves without a person.',
    src:'PR_AUTO_LIMIT · CONF_FLOOR',badge:'Auto-approval thresholds',
    expr:'pr_value ≤ PR_AUTO_LIMIT\n  AND ss_move ≤ SS_MOVE_MAX\n  AND confidence ≥ CONF_FLOOR',
    auth:'Iris decides alone only while all three hold. Any one failing sends it to a person — authority, not doubt.',
    qs:['Is this inside every limit a person set?','Which limit is closest to its edge?','What would have to change for this to auto-run?']},
   {id:'a1',x:36,y:212,k:'step',t:'Resolved within policy',d:'Closed out, written and verified. No human touched it.',meta:'exc.autoResolved',
    auth:'No authority needed — every gate passed.',
    qs:['What did it actually write?','Was every write confirmed by the target system?']},
   {id:'a2',x:700,y:212,k:'ai',t:'Build the decision packet',d:'Assemble what a planner needs: the recommendation, the alternatives costed, the policy it sits against, and the cost of waiting.',
    meta:'exc.buildPacket',
    auth:'Iris may assemble evidence at any value. It may not act on it above the limit.',
    qs:['What is in the packet?','Why these two alternatives and not others?','What does waiting cost per day?']},
   {id:'h1',x:376,y:432,k:'human',t:'Planner decides',d:'Approve, adjust the quantity, hold, or reject. Override and reject both require a reason.',
    badge:'Planner',meta:'exc.pendingPlanner',
    auth:'Planning lead. The reason field is mandatory — without it the rejection teaches the system nothing.',
    qs:['Who exactly can answer this?','What happens to my reason afterwards?','Can I approve part of it?']},
   {id:'t1',x:60,y:672,k:'term',t:'→ Requisition queue',d:'Approved or adjusted — the requisition executes and verifies against Fusion.',
    auth:'Executed under the planner’s approval, recorded against their name.'},
   {id:'t2',x:390,y:768,k:'term',t:'→ Learning governance',d:'A rejection with a reason becomes a proposal, backtested before anything changes.',
