  d:'<span class="mono">PO-4471 · totalValue 9100 > 3000</span> · Gate 1 · policy v4.2'},
 {id:'b77c1e4',prev:'a41f9c2',day:'11 Aug',at:'09:14:58',actor:'agent',an:'Iris',ak:'iris',intent:'write',
  ref:'PO-4471',cause:'Coverage shortfall',t:'Coverage replanned across 6 nodes',
  d:'Safety stock raised 18% on 3 styles · Cartersville breaks first, day 12'},
 {id:'a41f9c2',prev:'9f30ab5',day:'11 Aug',at:'08:40:12',actor:'agent',an:'Mercer',ak:'mercer',intent:'handoff',
  ref:'PO-4471',cause:'Supply constraint',t:'Lead time updated and handed to planning',
  d:'<span class="mono">VN-3391 · +10 days</span> · 3-month window · 61 SKUs · handed to Iris'},
 {id:'9f30ab5',prev:'8c1d740',day:'11 Aug',at:'02:14:00',actor:'agent',an:'Iris',ak:'iris',intent:'read',
  ref:'run-0811',cause:'Coverage shortfall',t:'Nightly demand run complete',
  d:'43,120 SKUs scored across 49 nodes · 42,981 cleared within policy'},
 {id:'8c1d740',prev:'7b0e219',day:'11 Aug',at:'01:58:42',actor:'agent',an:'Iris',ak:'iris',intent:'skipped',
  ref:'4213-CTV',cause:'Excess & obsolete',t:'Re-classification skipped an overridden style',
  d:'Style 4213 · Cartersville · on the override exception list until rolled back'},
 {id:'7b0e219',prev:'6a9c103',day:'10 Aug',at:'17:20:14',actor:'human',an:'Terrence Boyd',ak:'tb',intent:'reject',
  ref:'LOAD-2288',cause:'Cost variance',t:'Carrier recommendation declined',
  d:'<span class="mono">LOAD-2288</span> · reason <em>“Backhaul available on the private fleet”</em>'},
 {id:'6a9c103',prev:'5d82f77',day:'10 Aug',at:'15:04:33',actor:'system',an:'System',ak:'sys',intent:'policy',
  ref:'policy v4.2',cause:'Excess & obsolete',t:'Phase-out check added before any cover recommendation',
  d:'<span class="mono">v4.1 → v4.2</span> · traced to an override · 3 similar cases suppressed since'},
 {id:'5d82f77',prev:null,day:'10 Aug',at:'09:12:08',actor:'agent',an:'Mercer',ak:'mercer',intent:'flagged',
  ref:'PO-4463',cause:'Awaiting confirmation',t:'Silent PO flagged — 14 days without acknowledgement',
  d:'<span class="mono">PO-4463</span> · no supplier reply · promise date in 9 days'}];
var INTENTS={notified:['nu','Notified'],policy:['info','Policy'],override:['dng','Override'],hold:['warn','Held'],
 write:['info','Write'],handoff:['info','Handoff'],read:['nu','Read'],skipped:['nu','Skipped'],
 reject:['dng','Reject'],flagged:['warn','Flagged'],decision:['ok','Decision'],detect:['nu','Detected']};
var AVCOL={christy:'var(--gradient-christy)',iris:'var(--iris)',mercer:'#232122',mw:'#6b7280',pr:'#6b7280',tb:'#6b7280',sys:'#6b7280'};
var TRAILS={
 'c02a8b7':{up:[{at:'08:40',l:'The lead time moved',x:'Mercer wrote +10 days and handed the replan to planning.'},
   {at:'09:14',l:'Cover broke on three styles',x:'Cartersville falls below service target from day 12.'}],
  steps:[{at:'08:51',l:'The gate stopped one requisition',g:1,taken:'totalValue 9100 > 3000 · held for the planner',
    nt:{l:'auto-approve it',w:'value crossed the A-tier cap — authority ran out, not confidence'}}],
  down:[{at:'08:52',l:'Priya overrode the quantity',x:'480 → 240 sq yd with a reason recorded.',h:1}],
  note:'A log tells you what happened; a thread tells you what else could have — and why it didn’t.'},
 'd9154f0':{up:[{at:'08:51',l:'A held PO reached the planner',x:'Order value over the A-tier cap.'}],
  steps:[{at:'08:52',l:'Quantity overridden, reason captured',g:1,taken:'480 → 240 sq yd · “Lead time has increased”',
    nt:{l:'approve as drafted',w:'the full quantity would have arrived after it was needed'}}],
  down:[{at:'—',l:'Reason feeds the next recommendation',x:'Captured against the style and the lane.',h:1}],
  note:'The reason is the product: without it the same recommendation returns next month.'},
 '6a9c103':{up:[{at:'—',l:'An override said the agent was wrong',x:'Cover on a phasing-out style would have been written off.'}],
  steps:[{at:'15:04',l:'It became a rule, not a note',g:1,taken:'read the phase-out flag before any cover recommendation',
    nt:{l:'leave it as a one-off',w:'the same wrong recommendation would return every month'}}],
  down:[{at:'since',l:'3 similar cases suppressed',x:'Backtested across 90 days: 0 good recommendations lost.'}],
  note:'One person’s judgement, tested, then made to hold every time.'}};

/* ============ case thread · board ============ */
var CTLAY={x:150,side:520,gap:34};
function openCase(id){
  if(!CASES[id]){nav('audit');ctMode('ledger');return}
  S.caseId=id;S.ctStep=null;S.ctMode='route';S.ctReplay=null;
  nav('audit');ctMode('route');
}
function renderCT(){
  var c=CASES[S.caseId];if(!c)return;
  var held=S.caseId==='EX-4472'&&!S.held;
  $('ct-id').textContent=S.caseId;
  $('ct-title').textContent=c.title;
  $('ct-pill').className='pill '+(held?'ok':c.pill[0]);
  $('ct-pill').textContent=held?'decided':c.pill[1];
  $('ct-facts').innerHTML='<span>At risk: <b>'+esc(c.atRisk)+'</b></span><span class="sep">·</span>'+
    '<span>Exposure <b>'+esc(c.exposure)+'</b></span><span class="sep">·</span>'+
    '<span>Owner <b>'+esc(c.owner)+'</b></span><span class="sep">·</span><span>'+esc(c.sla)+'</span>';
  renderCTRail();renderCTFlow();renderCTDots();
  if(S.ctMode==='simulate')renderSimPanel();
  else if(S.ctStep)renderStepInsp(S.ctStep);
  else renderInspEmpty();
}
function renderCTRail(){
  var b=$('ctRailBody');if(!b)return;
  if(S.ctRailTab==='ask'){
    b.innerHTML='<div class="insp-p" style="margin-bottom:12px">Ask about this case — answers come from the steps below, not from a model guessing.</div>'+
      ['Why is this waiting on me?','What happens if I do nothing?','Which systems were touched?','Show me what was not taken']
      .map(function(q){return '<button class="btn w" style="margin-bottom:7px;justify-content:flex-start;text-align:left" onclick="ctAsk(\''+q.replace(/'/g,"\\'")+'\')">'+q+'</button>'}).join('');
    return;
  }
  if(S.ctRailTab==='activity'){
    var c=CASES[S.caseId];
    b.innerHTML='<div class="raillab">This case, step by step</div>'+c.steps.map(function(st,i){
      var stt=st.st==='now'?'now':st.st==='held'?'held':st.st==='pending'?'pending':'done';
      return '<button class="ccard" onclick="selStep(\''+st.id+'\')"><div class="ct1">'+
        '<span class="cid2">'+String(i+1).padStart(2,'0')+'</span>'+
        '<span class="pill '+(stt==='done'?'ok':stt==='now'?'br':stt==='held'?'warn':'nu')+'">'+stt+'</span></div>'+
        '<span class="cnm">'+esc(st.t)+'</span>'+
        (st.dur?'<span class="cft"><span class="ctime">⏱ '+st.dur+'</span></span>':'')+'</button>';
    }).join('');
    return;
  }
  var q=(S.ctQ||'').toLowerCase();
  var list=CTORDER.filter(function(k){
    var c=CASES[k];
    if(S.ctFilter!=='all'){
      var g=c.status==='held'?'held':c.status==='done'||c.status==='overridden'?'done':'active';
      if(g!==S.ctFilter)return false;
    }
    if(!q)return true;
    return (k+' '+c.title+' '+c.owner).toLowerCase().indexOf(q)>-1;
  });
  var counts={active:0,held:0,done:0};
  CTORDER.forEach(function(k){var c=CASES[k];
    counts[c.status==='held'?'held':(c.status==='done'||c.status==='overridden')?'done':'active']++});
  if(!S.held&&counts.held>0){counts.held--;counts.done++}
  var pend=S.held?2:1;
  b.innerHTML='<button class="needsbar" onclick="S.ctFilter=\'held\';renderCTRail()">'+
    '<span class="ni">!</span><span><b>Needs a person</b><span>'+pend+' decision'+(pend===1?'':'s')+' pending · 1 handoff awaiting ack</span></span>'+
    '<span class="ch">›</span></button>'+
    '<input class="railsearch" id="ctQ" placeholder="Search case, order, customer…" value="'+esc(S.ctQ||'')+'">'+
    '<div class="railchips">'+
      ['all','active','held','done'].map(function(f){
        var n=f==='all'?CTORDER.length:counts[f];
        return '<button class="'+(S.ctFilter===f?'on':'')+'" onclick="S.ctFilter=\''+f+'\';renderCTRail()">'+
          (f==='held'?'⏸ ':'')+f.charAt(0).toUpperCase()+f.slice(1)+' <span class="n">'+n+'</span></button>';
      }).join('')+'</div>'+
    '<div class="raillab">Current case</div>'+caseCard(S.caseId,true)+
    '<div class="raillab">Other cases<span class="n">'+(list.length-1>0?list.length-1:0)+'</span></div>'+
    list.filter(function(k){return k!==S.caseId}).map(function(k){return caseCard(k,false)}).join('');
  var qi=$('ctQ');
  if(qi)qi.addEventListener('input',function(e){S.ctQ=e.target.value;renderCTRail();
    var n=$('ctQ');if(n){n.focus();n.setSelectionRange(n.value.length,n.value.length)}});
}
function caseCard(k,cur){
  var c=CASES[k];
  var held=k==='EX-4472'&&!S.held;
  var pill=held?['ok','decided']:c.pill;
  var icon={held:'⏸',waiting:'⧖',active:'◐',overridden:'↺',done:'✓'}[held?'done':c.status]||'';
  return '<button class="ccard'+(cur?' on':'')+'" onclick="pickCase(\''+k+'\')">'+
    '<div class="ct1"><span class="cid2">'+k+'</span><span class="cval">'+c.val+'</span></div>'+
    '<span class="cnm">'+esc(c.title)+'</span>'+
    '<span class="cft"><span class="pill '+pill[0]+'">'+icon+' '+pill[1]+'</span>'+
    '<span class="ctime">⏱ '+c.elapsed+'</span></span>'+
    (cur&&c.waiting&&!held?'<div class="cwait">⧖ Waiting on <b>'+esc(c.waiting)+'</b></div>':'')+
    '</button>';
}
function pickCase(k){S.caseId=k;S.ctStep=null;S.ctReplay=null;renderCT();ctFit()}
function ctRailTab(t){
  S.ctRailTab=t;
  document.querySelectorAll('.railtabs button').forEach(function(b){b.classList.toggle('on',b.dataset.rt===t)});
  renderCTRail();
}
function ctAsk(q){
  var c=CASES[S.caseId];
  var a=/waiting on me|why is this/.test(q)?'Because the requisition value crossed a limit a person set — not because the agent was unsure. Confidence was 0.88 against a 0.85 floor. Authority ran out, so it stopped.'
    :/nothing/.test(q)?'The cover gap stays open. Dalton and Cartersville break first around day 12, and expedites run about $1.8k a day until the window closes.'
    :/systems/.test(q)?'On this case: Oracle Fusion (read and write), OMP (read and write), Manhattan (read), project44 (read), and Databricks on close. Every write was confirmed by the target system before it counted.'
    :'Two branches were not taken: auto-approving the $214k requisition (value crossed the limit) and doing nothing (leaves ~4.1% service loss). Both are costed inside the decision packet.';
  openDrawer('<div class="dr-k">'+S.caseId+' · ask</div><div class="dr-t">'+esc(q)+'</div><div class="dr-s">'+a+'</div>'+
    '<div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">'+
    (S.held&&S.caseId==='EX-4472'?'<button class="btn pr" onclick="closeAll();openPacket()">Open the packet</button>':'')+
    '<button class="btn" onclick="closeAll();ctMode(\'ledger\')">See the records</button></div>');
}
/* ---- flow ---- */
function renderCTFlow(){
  var c=CASES[S.caseId];
  var rows=$('ctRows');
  var y=0,pos=[];
  var html=c.steps.map(function(st,i){
    var ag=st.ag?AG[st.ag]:null;
    var stt=st.st;
    var dim=(S.ctMode==='explain'&&S.ctStep&&S.ctStep!==st.id)?' dim':'';
    var replayHidden=(S.ctReplay!==null&&i>S.ctReplay);
    var cls='snode '+(st.k==='trigger'?'trigger':st.k==='human'?'human':st.k==='agent'?'agent':'')+
      (S.ctStep===st.id?' sel':'')+dim+(replayHidden?' dim':'');
    var stlabel=stt==='complete'?'<span class="sst">✓ Complete</span>'
      :stt==='now'?'<span class="sst nowst">● In progress</span>'
      :stt==='held'?'<span class="sst heldst">⏸ Held</span>'
      :'<span class="sst pend">○ Pending</span>';
    var head=st.k==='trigger'?'<span class="sag" style="--ac:var(--text-neutral)">⚑ Trigger</span>'
      :st.k==='gate'?'<span class="sag" style="--ac:var(--warning)"><i></i>Policy gate</span>'
      :st.k==='human'?'<span class="sag" style="--ac:var(--warning)"><i></i>Human decision</span>'
      :st.k==='end'?'<span class="sag" style="--ac:var(--text-neutral)"><i></i>Outcome</span>'
      :'<span class="sag" style="--ac:'+ag.c+'"><i></i>'+ag.n+'</span>';
    var node='<button class="'+cls+'" style="left:'+CTLAY.x+'px;top:'+y+'px;--ac:'+(ag?ag.c:'var(--text-neutral)')+'" '+
      'data-s="'+st.id+'" onclick="selStep(\''+st.id+'\')">'+
      '<span class="sh">'+head+stlabel+'</span>'+
      '<span class="stt">'+esc(st.t)+'</span>'+
      '<span class="sdd">'+esc(st.d)+'</span>'+
      ((st.conf||st.dur||st.chips)?'<span class="sfm">'+
        (st.chips?st.chips.map(function(ch){return '<span>$ '+esc(ch.replace('$',''))+'</span>'}).join(''):'')+
        (st.conf&&st.conf!=='—'?'<span>confidence '+st.conf+'</span>':'')+
        (st.dur?'<span>⏱ '+st.dur+'</span>':'')+'</span>':'')+
      '</button>';
    var sides='';
    (st.side||[]).forEach(function(sd,j){
      sides+='<button class="sidenode'+dim+(replayHidden?' dim':'')+'" style="left:'+CTLAY.side+'px;top:'+(y+8+j*66)+'px" '+
        'onclick="selStep(\''+st.id+'\')">'+
        '<span class="syshead"><span class="sysl">'+esc(sd.sys)+' · '+esc(sd.verb)+'</span>'+
        '<span class="ok'+(sd.ok?'':' pend')+'">'+(sd.ok?'✓ Confirmed':'○ Pending')+'</span></span>'+
        '<span class="sysd">'+esc(sd.d)+'</span></button>';
    });
    pos.push({id:st.id,y:y,side:(st.side||[]).length});
    y+=(st.k==='trigger'||st.k==='end'?128:st.d.length>110?152:140)+CTLAY.gap;
    return node+sides;
  }).join('');
  rows.innerHTML=html;
  $('ctStage').style.height=(y+40)+'px';
  requestAnimationFrame(function(){drawCTWires(pos);drawMap()});
  $('ctSum').textContent=summarize(c);
}
function summarize(c){
  var dec=c.steps.filter(function(s){return s.k==='gate'||s.k==='human'}).length;
  var ho=c.steps.filter(function(s){return /handoff/i.test(s.t)}).length;
  var reads=0,writes=0,hum=c.steps.filter(function(s){return s.k==='human'}).length;
  c.steps.forEach(function(s){(s.side||[]).forEach(function(d){
    if(d.verb==='read')reads++;if(d.verb==='write')writes++})});
  return dec+' decisions · '+ho+' handoffs · '+reads+' reads · '+writes+' writes · '+hum+' human';
}
function drawCTWires(pos){
  var stage=$('ctStage'),svg=$('ctWires');if(!stage||!svg)return;
  svg.setAttribute('viewBox','0 0 1000 '+stage.offsetHeight);
  svg.style.height=stage.offsetHeight+'px';
  var d='<defs><marker id="ctar" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">'+
    '<path d="M0 0 L6 3 L0 6 z" fill="#9aa3ae"/></marker>'+
    '<marker id="ctars" markerWidth="7" markerHeight="7" refX="5.5" refY="2.6" orient="auto">'+
    '<path d="M0 0 L5 2.6 L0 5.2 z" fill="#c3cad3"/></marker></defs>';
  var nodes=[].slice.call(stage.querySelectorAll('.snode'));
  for(var i=0;i<nodes.length-1;i++){
    var a=nodes[i],b=nodes[i+1];
    var x=CTLAY.x+a.offsetWidth/2;
    var y1=a.offsetTop+a.offsetHeight,y2=b.offsetTop;
    d+='<path marker-end="url(#ctar)" d="M'+x+' '+y1+' L'+x+' '+(y2-7)+'"/>';
  }
  stage.querySelectorAll('.sidenode').forEach(function(sd){
    var owner=stage.querySelector('[data-s="'+'"]');
    var y=sd.offsetTop+sd.offsetHeight/2;
    var x1=CTLAY.x+296,x2=CTLAY.side;
    var mx=(x1+x2)/2;
    d+='<path class="side" marker-end="url(#ctars)" d="M'+x1+' '+(y-10)+' C'+mx+' '+(y-10)+', '+mx+' '+y+', '+(x2-7)+' '+y+'"/>';
  });
  svg.innerHTML=d;
}
function drawMap(){
  var m=$('ctMap'),stage=$('ctStage'),cv=$('ctCanvas');
  if(!m||!stage)return;
  var H=stage.offsetHeight||1,W=1000;
  var sx=104/W,sy=82/H;
  var h='';
  stage.querySelectorAll('.snode').forEach(function(n){
    var cls=n.classList.contains('human')?'hu':n.classList.contains('agent')?'ag':'';
    h+='<i class="'+cls+'" style="left:'+(CTLAY.x*sx)+'px;top:'+(n.offsetTop*sy)+'px;width:'+(296*sx)+'px;height:'+Math.max(2,n.offsetHeight*sy)+'px"></i>';
  });
  stage.querySelectorAll('.sidenode').forEach(function(n){
    h+='<i style="left:'+(CTLAY.side*sx)+'px;top:'+(n.offsetTop*sy)+'px;width:'+(262*sx)+'px;height:'+Math.max(2,n.offsetHeight*sy)+'px"></i>';
  });
  var vh=Math.min(82,(cv.clientHeight/S.ctz)*sy),vy=Math.max(0,(-S.cty/S.ctz)*sy);
  h+='<div class="vp" style="left:2px;top:'+Math.min(82-vh,vy)+'px;width:100px;height:'+vh+'px"></div>';
  m.innerHTML=h;
}
function renderCTDots(){
  var c=CASES[S.caseId];
  $('ctDots').innerHTML=c.steps.map(function(st,i){
    var cls=st.st==='now'?'now':st.st==='held'?'held':st.st==='pending'?'':'done';
    if(S.ctReplay!==null&&i>S.ctReplay)cls='';
    return '<button class="rb-dot '+cls+'" title="'+esc(st.t)+'" onclick="ctReplay('+i+')">'+
      (st.k==='human'?'☺':st.k==='gate'?'◇':st.k==='trigger'?'⚑':'▪')+'</button>';
  }).join('');
}


/* ---- inspector ---- */
function selStep(id){
  S.ctStep=id;
  if(S.ctMode==='simulate'){renderCT();return}
  document.querySelectorAll('.snode').forEach(function(n){n.classList.toggle('sel',n.dataset.s===id)});
  if(S.ctMode==='explain')renderCTFlow();
  renderStepInsp(id);
  if($('ctInspEl').classList.contains('min'))ctInsp();
}
function renderInspEmpty(){
  $('ctInspLab').textContent='Step inspector';
  $('ctInspBody').innerHTML='<div class="insp-p" style="color:var(--muted-foreground)">'+
    'Select any step on the board to see what it was trying to do, what it concluded, the evidence it used, and the exact system action it took.</div>'+
    '<div class="insp-lab">This case</div>'+
    '<div class="insp-ul"><li>'+summarize(CASES[S.caseId]).split(' · ').join('</li><li>')+'</li></div>';
}
function renderStepInsp(id){
  var c=CASES[S.caseId];
  var st=c.steps.filter(function(x){return x.id===id})[0];if(!st)return;
  var ag=st.ag?AG[st.ag]:null;
  $('ctInspLab').textContent='Step inspector';
  var who=ag?'<span class="wn" style="--ac:'+ag.c+'"><i></i>'+ag.n+'</span><span class="pill nu">agent-work</span>'
    :st.k==='human'?'<span class="wn" style="--ac:var(--warning)"><i></i>'+esc(c.owner)+'</span><span class="pill warn">needs a person</span>'
    :st.k==='gate'?'<span class="wn" style="--ac:var(--warning)"><i></i>Policy gate</span><span class="pill nu">policy '+GOV.ver.split(' ')[0]+'</span>'
    :'<span class="wn" style="--ac:var(--text-neutral)"><i></i>System</span>';
  var h='<div class="insp-t">'+esc(st.t)+'</div><div class="insp-who">'+who+'</div>'+
    '<div class="insp-lab">Objective</div><div class="insp-p">'+esc(st.obj||'—')+'</div>'+
    '<div class="insp-lab">Result / summary</div><div class="insp-p">'+esc(st.res||st.d)+'</div>';
  if(st.ev&&st.ev.length){
    h+='<div class="insp-lab">Evidence / data used</div><ul class="insp-ul">'+
      st.ev.map(function(e){return '<li>'+esc(e)+'</li>'}).join('')+'</ul>';
  }
  var chips=[];
  if(st.conf&&st.conf!=='—')chips.push('Confidence '+st.conf);
  if(st.dur)chips.push('Duration '+st.dur);
  if(st.act)chips.push(st.act.sys);
  if(chips.length)h+='<div class="chiprow">'+chips.map(function(x){return '<span class="mchip">'+esc(x)+'</span>'}).join('')+'</div>';
  if(st.act){
    h+='<div class="insp-lab">Action</div><div class="actbox">'+
      '<div class="ab-h"><b>'+esc(st.act.sys)+' · '+esc(st.act.verb)+'</b>'+
      '<span class="pill '+(st.act.ok?'ok':'nu')+'" style="margin-left:auto">'+(st.act.ok?'✓ Confirmed':'pending')+'</span></div>'+
      '<div class="ab-b"><div class="ab-d">'+esc(st.act.d)+'</div>'+
      '<div class="ladder"><div class="ll">Status ladder</div>'+
      st.act.ladder.map(function(l,i){
        return '<div class="lrow'+(l[2]?' done':'')+'"><span class="lic">'+l[0]+'</span>'+
          '<span class="lt">'+esc(l[1])+'</span><span class="lw">'+esc(l[2]||'')+'</span></div>';
      }).join('')+'</div></div></div>';
  }
  var idx=c.steps.indexOf(st),next=c.steps[idx+1];
  if(next){
    var nag=next.ag?AG[next.ag].n:next.k==='human'?c.owner:next.k==='gate'?'policy':'the case';
    h+='<div class="nextline">→ Next step owned by <b>'+esc(nag)+'</b></div>';
  }
  if(st.k==='human'&&S.caseId==='EX-4472'&&S.held){
    h+='<div style="margin-top:14px"><button class="btn pr w" onclick="openPacket()">Open decision packet</button></div>';
  }
  $('ctInspBody').innerHTML=h;
}
/* ---- modes ---- */
function ctMode(m){
  document.querySelectorAll('#a-board .seg button,#a-list .seg button').forEach(function(b){b.classList.toggle('on',b.dataset.m===m)});
  if(m==='ledger'){
    S.audit='list';['board','list','trail'].forEach(function(k){$('a-'+k).classList.toggle('on',k==='list')});
    drawLedger();return;
  }
  S.audit='board';S.ctMode=m;
  ['board','list','trail'].forEach(function(k){$('a-'+k).classList.toggle('on',k==='board')});
  $('ctCanvas').classList.toggle('sim',m==='simulate');
  if(m==='simulate'&&$('ctInspEl').classList.contains('min'))ctInsp();
  renderCT();
  requestAnimationFrame(function(){ctFit()});
}
function renderSimPanel(){
  $('ctInspLab').textContent='⚗ Simulation';
  var lim=S.simLimit||250000;
  var flips=214000;
  $('ctInspBody').innerHTML='<div class="insp-t">What if Iris’s PR limit changed?</div>'+
    '<div class="insp-p" style="margin-top:8px">Iris purchase-requisition authority · currently <b>$150,000</b> ('+GOV.ver.split(' ')[0]+'). '+
    'Adjust the simulated limit and the board recalculates the affected branch.</div>'+
    '<div class="simslider"><div class="sl-t">Simulated PR limit: $'+lim.toLocaleString()+'</div>'+
    '<input type="range" min="100000" max="400000" step="10000" value="'+lim+'" oninput="S.simLimit=+this.value;renderSimPanel()">'+
    '<div class="sl-n">PR-20019 is $214,000 — the branch flips at $214,000.</div></div>'+
    '<table class="cmp"><thead><tr><th></th><th>Actual</th><th>Simulated</th></tr></thead><tbody>'+
    simRow('PR value','$214,000','$214,000')+
    simRow('Limit','$150,000','$'+lim.toLocaleString())+
    simRow('Authority','Above authority',lim>=flips?'Within authority':'Above authority')+
    simRow('Route','Held for planner',lim>=flips?'Automatically released':'Held for planner')+
    simRow('Waiting','2h 11m+ waiting',lim>=flips?'~12-second execution':'2h 11m+ waiting')+
    simRow('Cost of waiting','$1.8k/day',lim>=flips?'No waiting cost':'$1.8k/day')+
    '</tbody></table>'+
    '<div class="tradeoff"><b>⚠ Governance trade-off</b><p>Expanding an agent’s financial authority changes governance risk: '+
    'more spend is released without human review. Any real change must pass the governed lifecycle '+
    '(proposed → tested → approved → deployed).</p></div>'+
    '<div class="simacts">'+
    '<button class="btn" onclick="toast(\'Scenario saved — visible to anyone on this case.\')">⌸ Save scenario</button>'+
    '<button class="btn" onclick="toast(\'Link copied for this scenario.\')">↗ Share</button>'+
    '<button class="btn pr" onclick="nav(\'govern\');gvTab(\'auth\');toast(\'Propose it in Governance — the 90-day replay is attached there.\')">➤ Propose policy change</button>'+
    '<button class="btn" onclick="ctMode(\'route\')">↺ Discard</button></div>';
}
function simRow(l,a,b){
  var diff=a!==b;
  return '<tr><td>'+l+'</td><td>'+a+'</td><td class="'+(diff?'simv':'')+'">'+b+'</td></tr>';
}
/* ---- replay ---- */
var ctTimer=null;
function ctReplay(i){
  var c=CASES[S.caseId];
  if(i>=c.steps.length-1||i===999){S.ctReplay=null}else{S.ctReplay=i}
  ctStopPlay();renderCTFlow();renderCTDots();
  $('ctLive').classList.toggle('on',S.ctReplay===null);
  $('ctLive').textContent=S.ctReplay===null?'((•)) Live':'replaying step '+(S.ctReplay+1);
}
function ctPlay(){
  if(ctTimer){ctStopPlay();return}
  var c=CASES[S.caseId];
  if(S.ctReplay===null)S.ctReplay=0;
  $('ctPlayBtn').textContent='❚❚';
  ctTimer=setInterval(function(){
    S.ctReplay++;
    if(S.ctReplay>=c.steps.length-1){ctReplay(999);return}
    renderCTFlow();renderCTDots();
    $('ctLive').textContent='replaying step '+(S.ctReplay+1);
  },900);
}
function ctStopPlay(){if(ctTimer){clearInterval(ctTimer);ctTimer=null}$('ctPlayBtn').textContent='▶'}
/* ---- panels + pan/zoom ---- */
function ctRail(){$('ctRailEl').classList.toggle('min')}
function ctInsp(){$('ctInspEl').classList.toggle('min')}
function ctApply(){
  var st=$('ctStage');if(!st)return;
  st.style.transform='translate('+S.ctx+'px,'+S.cty+'px) scale('+S.ctz+')';
  var c=$('ctCanvas');if(c)c.style.backgroundPosition=S.ctx+'px '+S.cty+'px';
  drawMap();
}
function ctZoom(dir,cx,cy){
  var c=$('ctCanvas');if(!c)return;
  var old=S.ctz,nz=Math.min(1.7,Math.max(.3,old*(dir>0?1.13:1/1.13)));
  var r=c.getBoundingClientRect();
  cx=(cx==null?r.width/2:cx);cy=(cy==null?r.height/2:cy);
  S.ctx=cx-(cx-S.ctx)*(nz/old);S.cty=cy-(cy-S.cty)*(nz/old);S.ctz=nz;ctApply();
}
function ctFit(){
  var c=$('ctCanvas'),st=$('ctStage');if(!c||!st||!c.clientWidth)return;
  var contentW=CTLAY.side+262+40;
  var z=Math.min(1,Math.max(.4,(c.clientWidth-40)/contentW));
  S.ctz=z;S.ctx=Math.max(10,(c.clientWidth-contentW*z)/2);S.cty=8;ctApply();
}
(function(){
  var c=$('ctCanvas');if(!c)return;
  var drag=null;
  c.addEventListener('pointerdown',function(e){
    if(e.target.closest('.snode,.sidenode,.zstack,.replaybar,.fitbtn,.minimap'))return;
    drag={x:e.clientX,y:e.clientY,bx:S.ctx,by:S.cty};
    c.classList.add('grabbing');try{c.setPointerCapture(e.pointerId)}catch(_){}
  });
  c.addEventListener('pointermove',function(e){if(!drag)return;
    S.ctx=drag.bx+(e.clientX-drag.x);S.cty=drag.by+(e.clientY-drag.y);ctApply()});
  function end(){drag=null;c.classList.remove('grabbing')}
  c.addEventListener('pointerup',end);c.addEventListener('pointercancel',end);
  c.addEventListener('wheel',function(e){e.preventDefault();
    var r=c.getBoundingClientRect();
    if(e.ctrlKey){ // trackpad pinch (macOS) / ctrl+scroll → zoom at cursor
      var f=Math.exp(-e.deltaY*0.01),old=S.ctz,nz=Math.min(1.7,Math.max(.3,old*f));
      var cx=e.clientX-r.left,cy=e.clientY-r.top;
      S.ctx=cx-(cx-S.ctx)*(nz/old);S.cty=cy-(cy-S.cty)*(nz/old);S.ctz=nz;ctApply();
    }else{ // two-finger scroll → pan the board, like Figma
      S.ctx-=e.deltaX;S.cty-=e.deltaY;ctApply();
    }},{passive:false});
})();

/* ============ ledger ============ */
function auditRef(ref){S.aRef=ref;ctMode('ledger')}
function matches(r){
  if(S.aRef&&r.ref!==S.aRef)return false;
  if(S.aFilter==='agent'&&r.actor!=='agent')return false;
  if(S.aFilter==='human'&&r.actor!=='human')return false;
  if(['hold','override','policy'].indexOf(S.aFilter)>-1&&r.intent!==S.aFilter)return false;
  if(!S.aQ)return true;
  return (r.t+' '+r.d+' '+r.an+' '+r.ref+' '+r.id+' '+r.cause).toLowerCase().indexOf(S.aQ)>-1;
}
function drawLedger(){
  var rows=AUDIT.filter(matches);
  $('aCount').textContent=rows.length+' of '+AUDIT.length;
  var banner=$('refBanner');
  if(S.aRef){banner.hidden=false;
    banner.innerHTML='Every action on <span class="mono">'+esc(S.aRef)+'</span> — '+rows.length+' record'+(rows.length===1?'':'s')+'. '+
      '<button class="linky" onclick="S.aRef=null;drawLedger()">Show the whole ledger</button>';
  }else banner.hidden=true;
  $('auditList').innerHTML=rows.length?rows.map(function(r){
    var m=INTENTS[r.intent]||['nu',r.intent];
    var init=r.an.split(' ').map(function(w){return w[0]}).join('').slice(0,2).toUpperCase();
    return '<tr onclick="openTrail(\''+r.id+'\')">'+
      '<td class="led-when">'+esc(r.day)+'<br>'+esc(r.at)+'</td>'+
      '<td class="led-act"><b>'+esc(r.t)+'</b><span>'+r.d+'</span></td>'+
      '<td><span class="led-who"><span class="led-av" style="background:'+(AVCOL[r.ak]||'#6b7280')+'">'+init+'</span>'+esc(r.an)+'</span></td>'+
      '<td><span class="pill '+m[0]+'">'+m[1]+'</span></td>'+
      '<td class="led-cause">'+esc(r.cause)+'</td>'+
      '<td class="led-ref">'+esc(r.ref)+'</td>'+
      '<td class="led-hash">'+r.id+'</td></tr>';
  }).join(''):'<tr><td colspan="7" style="padding:26px;text-align:center;color:var(--muted-foreground)">Nothing matches — clear a filter or the search.</td></tr>';
  var broken=null;
  for(var i=0;i<AUDIT.length-1;i++){if(AUDIT[i].prev!==AUDIT[i+1].id){broken=AUDIT[i].id;break}}
  $('chainState').textContent=broken?'Chain breaks at '+broken+' — a record was edited or removed.':
    'Chain intact across all '+AUDIT.length+' records loaded. Each names its predecessor, back to the first.';
}
function openTrail(id){
  var r=null;AUDIT.forEach(function(x){if(x.id===id)r=x});
  if(!r)return;
  ['board','list','trail'].forEach(function(k){$('a-'+k).classList.toggle('on',k==='trail')});
  S.audit='trail';
  var m=INTENTS[r.intent]||['nu',r.intent];
  var t=TRAILS[id];
  function stepH(s){
    return '<div class="tstep"><div class="tstep-rail">'+esc(s.at||'')+'</div>'+
      '<div class="tstep-line"><span class="tstep-dot'+(s.g?' g':s.h?' h':'')+'"></span></div>'+
      '<div><div class="tstep-t">'+esc(s.l)+'</div>'+(s.x?'<div class="tstep-x">'+esc(s.x)+'</div>':'')+
      (s.nt?'<div class="fork"><div class="fork-row fork-yes"><span class="fork-tag">Took</span><span>'+esc(s.taken)+'</span></div>'+
        '<div class="fork-row fork-no"><span class="fork-tag">Did not</span><span><b>'+esc(s.nt.l)+'</b> — '+esc(s.nt.w)+'</span></div></div>':'')+
      '</div></div>';
  }
  function band(title,rows){
    if(!rows||!rows.length)return '';
    return '<div class="band-h"><span class="band-t">'+title+'</span><span class="band-rule"></span></div>'+rows.map(stepH).join('');
  }
  var init=r.an.split(' ').map(function(w){return w[0]}).join('').slice(0,2).toUpperCase();
  $('trailBody').innerHTML='<div class="trail-head"><div style="flex:1;min-width:0">'+
    '<div class="trail-title">'+esc(r.t)+'</div><div class="trail-sub">'+r.d+'</div></div>'+
    '<div style="text-align:right;flex-shrink:0"><div style="font-size:11px;color:var(--text-neutral)">'+esc(r.day)+' · '+esc(r.at)+'</div>'+
    '<div class="hash" style="margin-top:5px">'+r.id+'</div></div></div>'+
    '<div class="trail-facts"><span class="pill '+m[0]+'">'+m[1]+'</span>'+
    '<span class="pill nu"><span class="led-av" style="width:15px;height:15px;font-size:8px;background:'+(AVCOL[r.ak]||'#6b7280')+'">'+init+'</span> '+esc(r.an)+'</span>'+
    '<span class="pill nu">'+esc(r.cause)+'</span><span class="pill nu">'+esc(r.ref)+'</span>'+
    (r.prev?'<span class="pill nu">← prev '+r.prev+'</span>':'')+'</div>'+
    (t?band('Why this came up',t.up)+band('What it did',t.steps)+band('What it changed',t.down)+
      (t.note?'<div class="note" style="margin-top:16px"><b>Why the fork matters:</b> '+esc(t.note)+'</div>':'')
     :'<div class="note">A single step with no branches — the row above is the whole story. Records with gates or overrides carry a full trail.</div>')+
    '<div style="margin-top:18px;display:flex;gap:8px;flex-wrap:wrap">'+
    '<button class="btn" onclick="auditRef(\''+esc(r.ref)+'\')">Every action on '+esc(r.ref)+'</button>'+
    '<button class="btn" onclick="pickCase(\'EX-4472\');ctMode(\'route\')">Open a case thread</button></div>';
  window.scrollTo(0,0);
}
function copyCSV(){
  var rows=AUDIT.filter(matches);
  var csv=['id,prev,day,at,who,intent,cause,ref,title'].concat(rows.map(function(r){
    return [r.id,r.prev||'',r.day,r.at,r.an,r.intent,r.cause,r.ref,r.t]
      .map(function(v){return '"'+String(v).replace(/"/g,'""')+'"'}).join(',');
  })).join('\n');
  if(navigator.clipboard){navigator.clipboard.writeText(csv).then(function(){toast('CSV copied — '+rows.length+' records.')},
    function(){toast('Copy blocked by the browser.')})}
  else toast('Copy not available here.');
}
function renderAudit(){
  if(S.audit==='list'){drawLedger();return}
  if(S.audit==='board'){renderCT();requestAnimationFrame(ctFit)}
}

/* ============ decision packet · shared state ============ */
var rejectMode=false;
function openPacket(){
  if(!S.held){toast('EX-4472 is already decided — the outcome is in the Audit Trail.');return}
  $('modal').classList.add('on');$('scrim').classList.add('on');
}
function decide(kind){
  if(kind==='reject'&&!rejectMode){rejectMode=true;$('rzn').classList.add('on');$('rzn').focus();return}
  var reason='';
  if(kind==='reject'){
    reason=$('rzn').value.trim();
    if(!reason){$('rzerr').style.display='block';return}
  }
  S.held=false;closeAll();
  var ok=kind==='approve';
  var sh=$('ss-held');if(sh)sh.textContent='0';
  $('p-4472').className='pill '+(ok?'ok':'dng');
  $('p-4472').textContent=ok?'approved · executing':'rejected · reason captured';
  $('s-4472').textContent=ok?'PR released. Fusion write in progress — shows verified once Fusion confirms.'
    :'Rejected with your reason. Iris will not re-raise; the reason feeds the next recommendation.';
  $('a-4472').innerHTML='<button class="btn" onclick="openCase(\'EX-4472\')">Case flow</button>'+
    '<button class="btn" onclick="nav(\'audit\');auditRef(\'EX-4472\')">Case thread</button>';
  renderAgCards();renderRail();
  AUDIT.unshift({id:(ok?'91b2…0ff':'90aa…3e7'),prev:AUDIT[0].id,day:'today',at:'now',actor:'human',an:'you',
    intent:ok?'decision':'override',ref:'EX-4472',
    t:ok?'Planner approved — $214k PR released':'Planner rejected the held PR',
    d:'<span class="mono">intent '+(ok?'decision':'override')+'</span> · '+
      (ok?'write in flight to Fusion; the case closes when it verifies':'reason <em>"'+esc(reason)+'"</em> · fed to learning')});
  if(!ok){
    var d=document.createElement('div');d.className='ov';
    d.innerHTML='<b>now · You rejected EX-4472</b> — <span class="why">"'+esc(reason)+'"</span>'+
      '<div class="fed">↻ captured — will shape the next recommendation</div>';
    $('ovfeed').prepend(d);
  }
  var kr=$('kpiReach');if(kr)kr.textContent='36';
  if(S.p==='audit'){if(S.audit==='board'){renderCT()}else{drawLedger()}}
  toast(ok?'Approved. $214k PR released — the write will verify against Fusion.'
    :'Rejected with reason — captured, chained into the ledger, and fed to learning.');
}
function nudge4474(){
  if(S.nudged4474){toast('A reminder is already out — sent 09:52, logged on the case.');return}
  S.nudged4474=true;
  var b=$('nudge-4474');b.disabled=true;b.textContent='Reminder sent';
  toast('Reminder sent to the customer — logged on EX-4474.');
}

/* ============ overlays ============ */
function openDrawer(html){$('drbody').innerHTML=html;$('drawer').classList.add('on');$('scrim').classList.add('on')}
function closeAll(){
  $('drawer').classList.remove('on');$('scrim').classList.remove('on');
  $('modal').classList.remove('on');
  rejectMode=false;$('rzn').classList.remove('on');$('rzerr').style.display='none';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll()});
var tT=null;
function toast(m){
  $('toastEl').textContent=m;$('toastEl').classList.add('on');
  clearTimeout(tT);tT=setTimeout(function(){$('toastEl').classList.remove('on')},3400);
}

/* ============ wire-ups & init ============ */
$('wfq').addEventListener('input',renderWFLib);
$('wfq').addEventListener('keydown',function(e){if(e.key==='Enter')wfAskGo()});
$('aq').addEventListener('input',function(e){S.aQ=e.target.value.trim().toLowerCase();drawLedger()});
document.querySelectorAll('.fchip').forEach(function(b){
  b.addEventListener('click',function(){
    S.aFilter=b.dataset.f;
    document.querySelectorAll('.fchip').forEach(function(x){x.classList.toggle('on',x===b)});
    drawLedger();
  });
});
window.addEventListener('resize',function(){
  if(S.p==='workflows'){requestAnimationFrame(function(){drawWFWires();wfFit()})}
  if(S.p==='audit'&&S.audit==='board')requestAnimationFrame(function(){renderCTFlow();ctFit()});
});
renderAgCards();renderRail();renderGov();drawLedger();renderWFEntry();
</script>
</body>
</html>
