   {id:'t1',x:44,y:660,k:'term',t:'→ Argued on its own terms',d:'A loosening needs a case made for it, not a replay hidden behind it.',
    auth:'Policy owner, with the risk stated explicitly.'},
   {id:'t2',x:700,y:660,k:'term',t:'→ Versions on the next run',d:'v4.2 → v4.3. Cascades on the next run, never mid-flight. Rollback stays available.',
    auth:'Applied by the platform once approved; every case afterwards cites the new version.'}],
  edges:[
   {f:'s0',t:'a1',k:'expr'},{f:'a1',t:'g1',k:'expr'},
   {f:'g1',t:'t1',l:'something slipped',k:'expr'},
