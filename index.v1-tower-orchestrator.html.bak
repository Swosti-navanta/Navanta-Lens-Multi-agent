 t5:['Both sides costed','Neither the risk nor the cost was hidden from you.',[['Unprotected','~4.1% service loss'],['Covered','$214k tied up']]],
 t6:['What happens next','It waits as a bounded packet — you are not asked to re-investigate.',[['Waiting','2h 11m'],['Cost of delay','$1.8k/day']]],
 w1:['Routed to damage','The warranty branch stayed grey and explains itself.',[['Route','damage'],['Not taken','warranty']]],
 w2:['The rule','Warranty applies only inside its window.',[['Rule','warranty window']]],
 w3:['Warranty expired','Read from the product master: November 2025.',[['Expired','2025-11']]],
 w4:['Photos matched','Consistent with the POD damage pattern.',[['Confidence','0.93']]],
 w5:['Credit auto-issued','$8,400 was inside the ≤$10k limit.',[['Amount','$8,400'],['Limit','$10,000']]],
 a1:['Acted alone','No person was asked to approve the lead-time update.',[['Case','EX-4471']]],
 a2:['Test one','The change was 10 days against a 15-day ceiling.',[['Rule','≤ 15 days'],['Actual','10']]],
 a3:['Test two','Exposure was $38,200 against a $50,000 ceiling.',[['Rule','< $50,000'],['Actual','$38,200']]],
 a4:['Test three','Confidence 0.94 against a 0.85 floor.',[['Rule','≥ 0.85'],['Actual','0.94']]],
 a5:['The proof','Forty-two writes, each confirmed by Fusion itself.',[['Writes','42'],['Verified','all ✓']]],
 a6:['The counterfactual','One number over any line and it stops, exactly like EX-4472.',[['Behaviour','stop, draft, ask']]],
 c1:['The customer chose','Christy never made the product decision.',[['Decided by','the customer']]],
 c2:['Absorbing was allowed','The 4% price gap sat inside the ≤5% rule.',[['Rule','≤ 5%'],['Actual','4%']]],
 c3:['Substituting was not','Product substitution is on the never-alone list.',[['Rule','never alone']]],
 c4:['Both options costed','Alternate now, or wait six days — stated plainly.',[['Options','2']]],
 c5:['The outcome','They waited; the date was re-committed and the pattern logged.',[['Choice','wait'],['Logged','offer pattern']]]
};
function openStep(id){
  var d=STEPS[id];if(!d)return;
  openDrawer('<div class="dr-k">'+(S.caseId||'')+' · step detail</div><div class="dr-t">'+d[0]+'</div>'+
    '<div class="dr-s">'+d[1]+'</div>'+
    d[2].map(function(r){return '<div class="kv"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join(''));
}

/* ============ shared drawers ============ */
function openDrawer(html){$('drbody').innerHTML=html;$('drawer').classList.add('on');$('scrim').classList.add('on')}
function closeAll(){
  $('drawer').classList.remove('on');$('scrim').classList.remove('on');
  $('modal').classList.remove('on');S.rejectMode=false;
}
var HOS={
 'HO-8831':{t:'HO-8831 · Mercer → Iris',rows:[['Ask','replan cover for the affected window'],['Facts sent','new lead time · 41 affected POs (Fusion 08:14:04)'],['Assumption','window ends 21 Nov — labelled as an assumption'],['Authority passed','coverage + requisitions within limits'],['Authority kept','vendor master stays Mercer’s'],['Due','5 min'],['Status','accepted · 08:14:09']]},
 'HO-8832':{t:'HO-8832 · Iris → Christy',rows:[['Ask','protect the install on SO-48219'],['Facts sent','revised date · +6 days vs commitment'],['Authority passed','offer options · absorb ≤5%'],['Authority kept','requisition decisions stay Iris’s'],['Status','accepted · 08:16:41']]},
 'HO-8834':{t:'HO-8834 · Christy → Iris',rows:[['Ask','book the return and collection'],['Facts sent','claim approved · credit issued · POD reference'],['Authority passed','logistics booking within limits'],['Authority kept','customer contact stays Christy’s'],['Status','accepted · day 9']]}
};
function openHO(id){var h=HOS[id];
  openDrawer('<div class="dr-k">Handoff · inspectable contract</div><div class="dr-t">'+h.t+'</div>'+
   '<div class="dr-s">Not “hands to” prose — what moved, what stayed, and the acceptance.</div>'+
   h.rows.map(function(r){return '<div class="kv"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join(''));
}
var INSTS={
 'EX-4479':{t:'EX-4479 · new supplier signals',st:'run',
  d:'Mercer picked up three lead-time signals on the VN-2210 feed. Not a case yet — it becomes one only if promised dates are actually affected.',
  facts:[['Stage','Detect'],['Owner','Mercer'],['Source','EDI 824'],['Confidence','0.99'],['Started','09:41:02']],
  read:['Supplier feed · EDI 824','Oracle Fusion · open POs'],
  next:'Assess all 47 open orders against the new dates. If any promised date slips, a case opens automatically.',
  acts:[['Watch this','toast(\'Watching EX-4479 — you will be told the moment it becomes a case.\')']]},
 'EX-4479b':{t:'EX-4479 · assessing exposure',st:'run',
  d:'Comparing the new lead times against the promise date on every open PO from this vendor.',
  facts:[['Stage','Assess'],['Owner','Mercer'],['Progress','31 of 47 checked'],['Confidence','0.96'],['Elapsed','2.4s']],
  read:['Oracle Fusion · PO promise dates','OMP · coverage positions'],
  next:'Anything that slips past its committed date becomes an impact line, and customers get traced from there.'},
 'EX-4471w':{t:'EX-4471 · writes verified',st:'done',
  d:'The vendor lead time and 41 PO promise dates were written to Fusion — and confirmed by Fusion itself, not just sent.',
  facts:[['Stage','Act'],['Owner','Mercer'],['Writes','42 · all verified'],['Confidence','0.94'],['Runtime','6.1s']],
  read:['Oracle Fusion · vendor master','Oracle Fusion · PO lines'],
  next:'Handed to Iris as HO-8831 with the new lead time and the 41 affected orders attached.',
  acts:[['Open the handoff','openHO(\'HO-8831\')'],['See the full case','goFlow(\'audit\',\'EX-4471\')']]},
 'EX-4480':{t:'EX-4480 · coverage check',st:'run',
  d:'A fresh coverage run across six distribution centres, triggered by the EX-4479 signals.',
  facts:[['Stage','Assess'],['Owner','Iris'],['Sites','6 DCs'],['Confidence','0.92'],['Elapsed','1.8s']],
  read:['OMP · coverage by DC','Manhattan · on-hand and in-transit'],
  next:'Any SKU falling below service target inside the window moves to Impact for costing.'},
 'EX-4480b':{t:'EX-4480 · trade-off costed',st:'run',
  d:'Both sides costed before anything is recommended: what the service loss costs, and what full cover ties up.',
  facts:[['Stage','Impact'],['Owner','Iris'],['Unprotected','~4.1% service loss'],['Fully covered','$214k working capital'],['Confidence','0.90']],
  read:['OMP · service targets','Oracle Fusion · carrying cost'],
  next:'A recommendation is drafted, then checked against your limits before anything executes.'},
 'CL-2210':{t:'CL-2210 · damage claim',st:'wait',
  d:'Two pallets damaged under the wrap. Christy opened the claim from records already held rather than asking the customer to prove it first.',
  facts:[['Stage','Detect'],['Owner','Christy'],['Waiting on','customer photos'],['Waiting','3h 20m'],['Opened','06:22:10']],
  read:['Proof of delivery','Oracle Fusion · order record'],
  next:'Once photos arrive, the damage pattern is matched against the POD and the claim is validated automatically.',
  acts:[['Send a reminder','toast(\'Reminder sent to the customer — logged on CL-2210.\')'],['Escalate to a person','escalate()']]},
 'EX-4474':{t:'EX-4474 · damage validated',st:'done',
  d:'Photos matched the proof of delivery and the vendor score came back clean — the claim is genuine.',
  facts:[['Stage','Impact'],['Owner','Christy'],['Evidence','POD + photos'],['Confidence','0.93'],['Exposure','$8,400']],
  read:['Manhattan · POD','Product master · vendor score'],
  next:'Credit of $8,400 sits inside the $10,000 limit, so it issues without asking anyone.',
  acts:[['See the full route','goFlow(\'investigate\',\'EX-4474\')']]},
 'EX-4474b':{t:'EX-4474 · credit issued',st:'done',
  d:'The credit auto-issued once the claim was valid, and Fusion confirmed the write. The customer is confirming receipt.',
  facts:[['Stage','Act'],['Owner','Christy'],['Credit','$8,400 · verified'],['Limit','≤ $10,000'],['Hold left','17h']],
  read:['Oracle Fusion · invoice','Manhattan · 48h soft hold'],
  next:'Handed to Iris as HO-8832 to book the return and collection.',
  acts:[['Open the handoff','openHO(\'HO-8832\')'],['Nudge the customer','nudge4474()']]}
};
function openInst(id){
  var d=INSTS[id];if(!d)return;
  var pill={done:'<span class="pill ok">verified</span>',run:'<span class="pill br">running now</span>',
    wait:'<span class="pill nu">waiting</span>',held:'<span class="pill warn">needs you</span>'}[d.st]||'';
  var h='<div class="dr-k">Instance</div>'+
    '<div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:4px"><div class="dr-t" style="margin:0">'+d.t+'</div></div>'+
    '<div style="margin-bottom:10px">'+pill+'</div>'+
    '<div class="dr-s">'+d.d+'</div>'+
    d.facts.map(function(r){return '<div class="kv"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join('');
  if(d.read&&d.read.length){
    h+='<div class="rl" style="margin:16px 0 8px">Evidence read</div>'+
      d.read.map(function(r){return '<div class="note-i" style="margin-bottom:6px"><div class="nb">'+r+'</div></div>'}).join('');
  }
  if(d.next){
    h+='<div class="rl" style="margin:16px 0 8px">What happens next</div>'+
      '<div class="act-card calm" style="margin-bottom:0"><p style="margin:0">'+d.next+'</p></div>';
  }
  h+='<div class="rl" style="margin:16px 0 8px">Do something</div><div class="qa">';
  (d.acts||[]).forEach(function(a){h+='<button class="btn w" onclick="closeAll();'+a[1]+'">'+a[0]+'</button>'});
  var cid=id.replace(/[a-z]$/,'');
  h+='<button class="btn w" onclick="closeAll();goFlow(\'investigate\',\''+(CASES[cid]?cid:'EX-4472')+'\')">Open this case in the Orchestrator</button>';
  h+='<button class="btn w" onclick="closeAll();toast(\'Watching '+cid+' — you will be notified when it changes.\')">Watch for changes</button>';
  h+='</div>';
  openDrawer(h);
}
function openLimits(a){
  var L={mercer:[['Lead-time update','≤ 15 days'],['Exposure alone','< $50,000'],['Confidence floor','0.85'],['Never alone','vendor termination']],
         iris:[['Auto-raise PR','≤ $150,000'],['Safety stock move','≤ 25%'],['Confidence floor','0.85'],['Never alone','customer credit']],
         christy:[['Price absorb','≤ 5%'],['Claim credit','≤ $10,000'],['Confidence floor','0.85'],['Never alone','product substitution']]};
  openDrawer('<div class="dr-k">Decision rights · policy v4.2</div><div class="dr-t">'+AG[a].n+' — limits</div>'+
   '<div class="dr-s">Set by the planning lead, versioned, effective next run.</div>'+
   L[a].map(function(r){return '<div class="kv"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join('')+
   '<div style="margin-top:16px"><button class="btn" onclick="closeAll();goFlow(\'test\')">Test a limit change →</button></div>');
}
function openProposal(){
  var decided=S.proposal;
  openDrawer('<div class="dr-k">Learning proposal · from an override</div><div class="dr-t">Read the phase-out flag before cover recommendations</div>'+
   '<div class="dr-s">Born from Dana R.’s rejection of EX-4468, tested against 90 days of history.</div>'+
   '<div class="kv"><span>Source</span><b>override · EX-4468 · 14:22</b></div>'+
   '<div class="kv"><span>Backtest</span><b>3 wrong recommendations suppressed</b></div>'+
   '<div class="kv"><span>Side effects</span><b>none found in 90-day replay</b></div>'+
   '<div class="kv"><span>Status</span><b>'+(decided==='approved'?'live from next run · rollback available':decided==='testing'?'sent back for more testing':'awaiting policy owner')+'</b></div>'+
   (decided?'':'<div style="margin-top:16px;display:flex;gap:8px"><button class="btn pr" onclick="proposalDecide(\'approved\')">Approve change</button>'+
   '<button class="btn" onclick="proposalDecide(\'testing\')">Request more testing</button></div>'));
}
function proposalDecide(kind){
  S.proposal=kind;
  var row=$('row-4468-pill');
  if(row){row.className='pill '+(kind==='approved'?'ok':'nu');
    row.textContent=kind==='approved'?'change live · rollback available':'more testing requested';}
  toast(kind==='approved'?'Change approved — live from the next run. Rollback stays available.':'Sent back for more testing. The proposal stays open.');
  closeAll();
}
function openRetry(){
  openDrawer('<div class="dr-k">System write · recovering</div><div class="dr-t">OMP — safety stock write retrying</div>'+
   '<div class="dr-s">The write did not land. Nothing is lost: the action stays open until OMP confirms, and it will not double-write.</div>'+
   '<div class="kv"><span>Case</span><b>EX-4480 · safety stock +12%</b></div>'+
   '<div class="kv"><span>What happened</span><b>OMP returned 503 at 09:39:12</b></div>'+
   '<div class="kv"><span>Attempts</span><b>2 of 5 · next try in 38s</b></div>'+
   '<div class="kv"><span>Duplicate guard</span><b>same request key — OMP skips a repeat</b></div>'+
   '<div class="kv"><span>If it fails</span><b>stops and comes to you with the attempt history</b></div>'+
   '<div style="margin-top:16px;display:flex;gap:8px">'+
   '<button class="btn" onclick="toast(\'Retrying now — re-sent with the same request key.\');closeAll()">Retry now</button>'+
   '<button class="btn dng" onclick="toast(\'Write cancelled and rolled back. EX-4480 flagged for you.\');closeAll()">Cancel &amp; roll back</button></div>');
}

/* ============ decision packet ============ */
function openPacket(){
  if(!S.held){toast('EX-4472 is already decided.');return}
  $('modalBody').innerHTML=
   '<div class="m-t">Decision packet — EX-4472</div>'+
   '<div class="m-s">One bounded question. The investigation is attached, not re-opened.</div>'+
   '<div class="opt rec"><h6>Iris recommends <span class="pill br">conf 0.88 · floor 0.85</span></h6>'+
   '<p>Raise cover on 3 SKUs — the $214,000 requisition. Unprotected, an estimated 4.1% service loss on the affected lines. Two smaller requisitions already executed and verified.</p></div>'+
   '<div class="opt"><h6>Alternative — partial cover</h6><p>Raise Dalton and Cartersville only (~$128k). Covers the two DCs that break first, leaves the tail exposed.</p></div>'+
   '<div class="opt"><h6>Alternative — do nothing</h6><p>Accept the service risk. Costs roughly $1.8k/day in expedites if the window holds.</p></div>'+
   '<div class="kv"><span>Policy check</span><b>$214k &gt; $150k limit — the only reason you are being asked</b></div>'+
   '<textarea class="rzn" id="rzn" placeholder="Reason (required to reject) — this is what the system learns from"></textarea>'+
   '<div class="rz-err" id="rzerr">A reason is required — it is what the system learns from.</div>'+
   '<div class="m-f"><button class="btn dng" onclick="decide(\'reject\')">Reject with reason</button>'+
   '<button class="btn" onclick="closeAll()">Later</button>'+
   '<button class="btn pr" onclick="decide(\'approve\')">Approve · $214,000</button></div>';
  $('modal').classList.add('on');$('scrim').classList.add('on');
}
function decide(kind){
  if(kind==='reject'&&!S.rejectMode){S.rejectMode=true;$('rzn').classList.add('on');$('rzn').focus();return}
  if(kind==='reject'){
    var r=$('rzn').value.trim();
    if(!r){$('rzerr').style.display='block';return}
    S.held=false;applyDecision(false,r);
  }else{S.held=false;applyDecision(true,'')}
  closeAll();
}
function applyDecision(ok,reason){
  var sh=$('ss-held');if(sh)sh.textContent='0';
  $('p-4472').className='pill '+(ok?'ok':'dng');
  $('p-4472').textContent=ok?'approved · executing':'rejected · reason captured';
  $('s-4472').textContent=ok
    ?'Requisition released. Fusion write in progress — it will show verified once Fusion confirms.'
    :'Rejected with your reason. Iris will not re-raise it; the reason feeds the next recommendation.';
  $('a-4472').innerHTML='<button class="btn" onclick="goFlow(\'investigate\',\'EX-4472\')">Open flow</button>';
  var wf=$('wf-4472');
  if(wf){wf.className='inst '+(ok?'done':'');
    wf.innerHTML='<span class="id">EX-4472</span><span class="what">'+(ok?'approved · writing to Fusion':'rejected · reason captured')+'</span>';}
  AGWORK.iris.m[1][0]=String(Math.max(0,+AGWORK.iris.m[1][0]-1));
  if(!ok){
    AGWORK.iris.m[2][0]=String(+AGWORK.iris.m[2][0]+1);
    var d=document.createElement('div');d.className='ov';
    d.innerHTML='<b>now · You rejected EX-4472</b> — <span class="why">"'+esc(reason)+'"</span>'+
      '<div class="fed">↻ captured — it will shape the next recommendation</div>';
    $('ovfeed').prepend(d);
  }
  // flow: replace the decision stage
  var c=CASES['EX-4472'];
  c.stages[5]={n:'Your decision',i:'◉',s:ok?'done':'held',t:'answered',items:[
    ok?{b:'You approved it',s:'$214,000 released to Fusion',k:'ok',d:'packet'}
      :{b:'You rejected it',s:'reason captured and fed back',k:'warn',d:'packet'}]};
  c.stages[6]={n:'Act & learn',i:'↻',s:ok?'active':'done',t:ok?'writing':'logged',items:[
    ok?{b:'Writing to Fusion',s:'closes when the system confirms',k:'',d:'future-a'}
      :{b:'Learning from your reason',s:'no silent repeat of this recommendation',k:'ok',d:'future-r'}]};
  c.meta=[['Exposure','$214,000'],['Outcome',ok?'approved':'rejected'],['Owner','Iris'],['Decided','just now']];
  if(S.filter==='iris'&&$('wf-single').style.display!=='none')renderSingle('iris');
  if(S.filter==='all')renderVWF();
  renderAgCards();renderRail();
  if(S.motive)  {renderPanes();renderFlow()}
  toast(ok?'Approved. $214k released — the write will verify against Fusion.'
          :'Rejected with reason — captured and fed back. That is the signal that trains the system.');
  if(ok)setTimeout(function(){
    $('p-4472').className='pill ok';$('p-4472').textContent='executed · verified ✓';
    $('s-4472').textContent='Released and confirmed by Fusion. Safety stock and requisition are live; the outcome is logged against the baseline.';
    var w=$('wf-4472');if(w){w.className='inst done';
      w.innerHTML='<span class="id">EX-4472</span><span class="what">$214k · verified ✓</span>';}
    c.stages[6]={n:'Act & learn',i:'↻',s:'done',t:'verified',items:[
      {b:'Fusion confirmed the write',s:'requisition live · case closed',k:'ok',d:'future-a'}]};
    if(S.motive&&S.caseId==='EX-4472')renderFlow();
  },2600);
}

/* ============ nudge / propose / audit ============ */
function nudge4474(){
  if(S.nudged4474){toast('A reminder already went out — the customer has until the hold expires.');return}
  S.nudged4474=true;
  var b=$('nudge-4474');
  if(b){b.textContent='Reminder sent ✓';b.disabled=true}
  $('s-4474').textContent='Christy validated the claim from the POD and photos. $8,400 credit issuing · reminder sent just now, logged on the case.';
  if(S.motive)renderActions();
  toast('Reminder sent to the customer — logged on EX-4474.');
}
function proposeLimit(){
  if(S.limit===150000){toast('That is the current limit — move it first to propose a change.');return}
  S.pendingLimit=S.limit;renderActions();
  toast('Proposed: $'+S.limit.toLocaleString()+' — sent to the policy owner with the replay attached. Nothing changes until it is approved.');
}
function withdrawLimit(){S.pendingLimit=null;renderActions();toast('Proposal withdrawn. The limit stays at $150,000.')}
function copyAudit(){
  var txt='NAVANTA AUDIT · EX-4471 — vendor lead time +10 days\n'+
   'Decisions: 6 (1 acted-alone, 1 gate split, 2 handoffs accepted, 1 customer choice)\n'+
   'Writes: 7, all verified by target systems (Fusion x4, OMP, Manhattan, Databricks)\n'+
   'Human moments: 1 override by Dana R., reason captured, learning proposed\n'+
   'Outcome: 6.1s agent time vs 3.5-day manual baseline; customer re-committed';
  if(navigator.clipboard)navigator.clipboard.writeText(txt).then(
    function(){toast('Audit summary copied to your clipboard.')},function(){showAuditText(txt)});
  else showAuditText(txt);
}
function showAuditText(txt){
  openDrawer('<div class="dr-k">Audit summary</div><div class="dr-t">EX-4471 — copy this</div>'+
    '<div class="dr-s">Your browser blocked clipboard access. Select the text below and copy it.</div>'+
    '<textarea class="rzn on" style="min-height:190px;font-family:Geist Mono,monospace;font-size:11.5px" readonly>'+esc(txt)+'</textarea>');
}

/* ============ audit motive uses a closed case ============ */
CASES['EX-4471']={title:'Vendor lead time +10 days',sub:'closed and provable — every decision, write and human moment',
 meta:[['Decisions','6'],['Writes','7 verified'],['Human moments','1'],['Agent time','6.1s']],
 stages:[
  {n:'Signal',i:'⚑',s:'done',t:'0.8s',own:'mercer',items:[{b:'Lead-time notice',s:'EDI 824 · caught before any inbox',k:'',d:'signal'}]},
  {n:'Acted alone',i:'▸',s:'done',t:'1.5s',own:'mercer',items:[
    {b:'Lead time + 41 PO dates',s:'all three tests passed · verified by Fusion ✓',k:'ok',d:'write1'}]},
  {ho:'HO-8831',hoLabel:'new lead time → Iris'},
  {n:'Gate split',i:'◇',s:'done',t:'0.2s',own:'iris',items:[
    {b:'2 executed · 1 held',s:'$96,400 ran · $214,000 asked a person',k:'',d:'gate-pass'}]},
  {ho:'HO-8832',hoLabel:'date risk → Christy'},
  {n:'Customer chose',i:'◉',s:'done',t:'day 1',own:'christy',items:[
    {b:'Waited rather than substitute',s:'install date re-committed in Fusion ✓',k:'ok',d:'c5'}]},
  {n:'Human moment',i:'✋',s:'done',t:'+2h 11m',items:[
    {b:'Dana R. rejected the held PR',s:'“SKU 44-2213 phases out in Q4 — don’t build cover we’ll write off.”',k:'warn',d:'t6'}]},
  {n:'Learned',i:'↻',s:'done',t:'day 9',items:[
    {b:'Phase-out check proposed',s:'3 repeat recommendations suppressed since',k:'ok',d:'score'}]}
 ]};

/* ============ keyboard + toast ============ */
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAll()});
function makeKeyboardReachable(){
  document.querySelectorAll('.sw,.inst[onclick]').forEach(function(el){
    if(el.tagName==='BUTTON'||el.tabIndex>=0)return;
    el.tabIndex=0;el.setAttribute('role','button');
    el.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();el.click()}});
  });
}
var tT=null;
function toast(m){
  $('toastEl').textContent=m;$('toastEl').classList.add('on');
  clearTimeout(tT);tT=setTimeout(function(){$('toastEl').classList.remove('on')},3600);
}

/* ============ init ============ */
renderEntry();renderAgCards();renderRail();makeKeyboardReachable();
</script>
</body>
</html>
