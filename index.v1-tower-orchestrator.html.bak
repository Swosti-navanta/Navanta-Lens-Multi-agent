       '<li>Cover breaks on 3 SKUs across 6 DCs from day 12</li>'+
       '<li>The $214,000 requisition sits above your $150,000 limit</li>'+
       '<li>Two smaller requisitions already ran and were verified</li>'+
       '<li>Confidence 0.88 cleared the 0.85 floor — authority stopped it, not doubt</li>'+
     '</ul><div class="ff">Waiting 2h 11m<span class="pill warn" style="margin-left:auto">$1.8k/day</span></div></div>'+
     '<div class="rl">Recommended plan</div>'+
     '<div class="plan">'+
       '<div class="pstep now"><div class="pn">1</div><div class="pc"><div class="pw">Now · waiting on you</div>'+
         '<div class="pb"><b>Approve the $214,000 requisition</b><span>Raises cover on 3 SKUs before the window closes</span>'+
         '<span class="chk">✓ two alternatives costed in the packet</span></div></div></div>'+
       '<div class="pstep"><div class="pn">2</div><div class="pc"><div class="pw">Immediately after</div>'+
         '<div class="pb"><b>Iris writes to Fusion and OMP</b><span>Closes only once both systems confirm</span></div></div></div>'+
       '<div class="pstep"><div class="pn">3</div><div class="pc"><div class="pw">Ongoing</div>'+
         '<div class="pb"><b>Outcome logged against the baseline</b><span>Feeds the next coverage recommendation</span></div></div></div>'+
     '</div>'+
     '<button class="btn pr execbtn" onclick="openPacket()">Open the decision packet</button>';
  }else{
    el.innerHTML='<div class="rd">Today · '+stamp+'</div>'+
     '<h3>Nothing is waiting on you</h3>'+
     '<div class="tags"><span>all cases inside limits</span><span>or waiting on someone outside</span></div>'+
     '<div class="rl">Findings</div>'+
     '<div class="finding" style="border-color:#bbe7c9;background:var(--pill-success-bg)">'+
       '<div class="fh" style="color:var(--pill-success-fg)">✓ Clear — agents acting inside their limits</div><ul>'+
       '<li>EX-4472 answered — the outcome is on its flow</li>'+
       '<li>EX-4474 credit issued and verified; customer confirming</li>'+
       '<li>One OMP write retrying with a duplicate guard</li>'+
     '</ul></div>'+
     '<div class="rl">Worth a look</div>'+
     '<div class="plan">'+
       '<div class="pstep now"><div class="pn">1</div><div class="pc"><div class="pw">Proposed</div>'+
         '<div class="pb"><b>Phase-out check before cover</b><span>From Dana R.’s override · 3 repeats suppressed in backtest</span></div></div></div>'+
       '<div class="pstep"><div class="pn">2</div><div class="pc"><div class="pw">Optional</div>'+
         '<div class="pb"><b>Revisit the $150,000 limit</b><span>5 requisitions were above the line this month</span></div></div></div>'+
     '</div>'+
     '<button class="btn execbtn" onclick="openProposal()">Review the proposed change</button>';
  }
}
function towerTab(t){
  document.querySelectorAll('.tabsrow button').forEach(function(b){b.classList.toggle('on',b.dataset.t===t)});
  ['activity','systems','overrides','value'].forEach(function(k){$('tp-'+k).classList.toggle('on',k===t)});
}
function towerAskEx(q){$('towerAsk').value=q;towerAskGo()}
function towerAskGo(){
  var q=($('towerAsk').value||'').toLowerCase().trim();
  if(!q){toast('Tell the agents what you need, or tap a suggestion.');return}
  if(/attention|need|waiting/.test(q)){if(S.held){openPacket()}else{toast('Nothing is waiting on you right now.')}return}
  if(/break|risk|about to/.test(q)){towerTab('activity');toast('Ranked by exposure — EX-4472 is the one that needs you.');return}
  if(/214|held|why/.test(q))return goFlow('trace','TR-held');
  if(/recover|value|saved|today/.test(q)){towerTab('value');toast('$129k protected today, against the 3.5-day manual baseline.');return}
  if(/claim|damage/.test(q))return goFlow('investigate','EX-4474');
  goFlow('monitor');
}
/* ===== tower workflow · three vertical agent lanes ===== */
var TWF={
 stages:['Detect','Assess','Impact','Recommend','Decide ◇','Act','Learn'],
 work:{
  mercer:{'Detect':[{id:'EX-4479',t:'Three new signals',v:'VN-2210 supplier feed',st:'run',ref:'EDI 824',cf:'0.99',o:'EX-4479'}],
          'Assess':[{id:'EX-4479',t:'Checking exposure',v:'31 of 47 open orders so far',st:'run',ref:'Fusion p1',cf:'0.96',o:'EX-4479b'}],
          'Decide ◇':[{id:'policy',t:'Inside limits',v:'lead time ≤ 15 days',st:'done',ref:'policy v4.2',cf:'—'}],
          'Act':[{id:'EX-4471',t:'41 PO dates written',v:'confirmed by Fusion',st:'done',ref:'Fusion p4',cf:'0.94',o:'EX-4471w'}],
          'Learn':[{id:'↻',t:'Outcome logged',v:'6.1s vs 3.5-day baseline',st:'done',ref:'Databricks',cf:'—'}]},
  iris:{'Assess':[{id:'EX-4480',t:'Coverage re-checked',v:'6 DCs against the new date',st:'run',ref:'OMP p2',cf:'0.92',o:'EX-4480'}],
        'Impact':[{id:'EX-4480',t:'Trade-off costed',v:'4.1% service loss vs $214k stock',st:'run',ref:'OMP p7',cf:'0.90',o:'EX-4480b'}],
        'Decide ◇':[{id:'EX-4472',t:'Above your limit',v:'$214,000 vs $150,000 cap',st:'held',ref:'policy v4.2',cf:'0.88',hold:true}],
        'Act':[{id:'EX-4472',t:'Two requisitions run',v:'$96,400 · verified',st:'done',ref:'Fusion p9',cf:'0.88'}]},
  christy:{'Detect':[{id:'CL-2210',t:'Claim opened',v:'waiting on customer photos',st:'wait',ref:'POD ref',cf:'—',o:'CL-2210'}],
        'Impact':[{id:'EX-4474',t:'Damage validated',v:'photos match the POD',st:'done',ref:'Manhattan p3',cf:'0.93',o:'EX-4474'}],
        'Recommend':[{id:'EX-4474',t:'Credit proposed',v:'$8,400 plus a return',st:'done',ref:'Pricing p2',cf:'0.93',o:'EX-4474b'}],
        'Decide ◇':[{id:'limit',t:'Inside limits',v:'credit ≤ $10,000',st:'done',ref:'policy v4.2',cf:'—'}],
        'Act':[{id:'EX-4474',t:'Credit issued',v:'confirmed by Fusion',st:'done',ref:'Fusion p12',cf:'0.93',o:'EX-4474b'}],
        'Learn':[{id:'↻',t:'Choice pattern logged',v:'by offer type and segment',st:'done',ref:'Databricks',cf:'—'}]}},
 hos:[{id:'HO-8831',from:'mercer',fs:'Act',to:'iris',ts:'Assess'},
      {id:'HO-8832',from:'iris',fs:'Act',to:'christy',ts:'Impact'}]
};
var STLABEL={done:'Verified',held:'Needs you',run:'Running',wait:'Waiting'};
function renderVWF(){
  var cols=$('vwfCols');if(!cols)return;
  cols.innerHTML=['mercer','iris','christy'].map(function(k){
    var g=AG[k],w=TWF.work[k],p=S.paused[k];
    var all=[];TWF.stages.forEach(function(st){(w[st]||[]).forEach(function(i){all.push(i)})});
    var mix={done:0,held:0,run:0,wait:0};
    all.forEach(function(i){var st=i.hold?(S.held?'held':'done'):i.st;mix[st]=(mix[st]||0)+1});
    var tot=all.length||1;
    var col={done:'var(--success)',held:'var(--warning)',run:'var(--brand)',wait:'var(--input)'};
    var bar=['done','run','held','wait'].filter(function(x){return mix[x]}).map(function(x){
      return '<i style="width:'+(mix[x]/tot*100)+'%;background:'+col[x]+'"></i>'}).join('');
    return '<div class="vcol" data-col="'+k+'">'+
      '<div class="vhead">'+
        '<div class="hbarline">'+bar+'</div>'+
        '<div class="hin"><span class="av" style="background:'+g.bg+'">'+g.av+'</span>'+
          '<span><b>'+g.n+'</b><span class="role">'+g.r.replace(' agent','')+'</span></span>'+
          '<span class="cnt">'+all.length+'</span></div>'+
        '<div class="hsub"><span><b>'+mix.done+'</b> verified</span>'+
          (mix.held?'<span><b>'+mix.held+'</b> needs you</span>':'')+
          (mix.run?'<span><b>'+mix.run+'</b> running</span>':'')+
          (p?'<span style="color:var(--pill-warning-fg)">paused</span>':'')+'</div>'+
      '</div>'+
      TWF.stages.map(function(st){
        var items=w[st]||[];
        var gate=st.indexOf('Decide')===0;
        return '<div class="vstage'+(items.length?' busy':'')+(gate&&items.length?' gate':'')+'" data-stage="'+k+'|'+st+'">'+
          '<div class="vsh"><span class="vsn">'+st+'</span>'+
          (items.length?'<span class="vsc">'+items.length+'</span>':'')+'</div>'+
          (items.length?items.map(function(it){
            var live=it.hold?(S.held?'held':'done'):it.st;
            var title=it.hold&&!S.held?'Decision answered':it.t;
            var val=it.hold&&!S.held?'the outcome is on the flow':it.v;
            var click=(it.hold&&S.held)?'openPacket()':(it.o?'openInst(\''+it.o+'\')':'');
            return '<'+(click?'button':'div')+' class="vinst '+live+'"'+(click?' onclick="'+click+'"':'')+'>'+
              '<span class="cat">'+st.replace(' ◇','')+' · '+it.id+'</span>'+
              '<span class="ttl">'+title+'</span>'+
              '<span class="val">'+val+'</span>'+
              '<span class="sfoot"><span class="sdot"></span><span class="sst">'+STLABEL[live]+'</span>'+
              '<span class="sref">'+it.ref+'</span>'+
              (it.cf!=='—'?'<span class="sconf">'+it.cf+'</span>':'')+'</span>'+
            '</'+(click?'button':'div')+'>';
          }).join(''):'<div class="empty">nothing here</div>')+
        '</div>';
      }).join('')+
    '</div>';
  }).join('');
  var lg=$('vwf').querySelector('.vlegend');
  if(!lg){
    lg=document.createElement('div');lg.className='vlegend';
    lg.innerHTML='<h6>Reading this board</h6>'+
      '<div><i style="background:var(--success)"></i>Verified by the system</div>'+
      '<div><i style="background:var(--brand)"></i>Running now</div>'+
      '<div><i style="background:var(--warning)"></i>Needs your decision</div>'+
      '<div><i style="background:var(--input)"></i>Waiting on someone</div>';
    $('vwf').appendChild(lg);
  }
  requestAnimationFrame(function(){drawVWF();if(!S.vfitted){S.vfitted=1;vfit()}});
  makeKeyboardReachable();
}
function drawVWF(){
  var stage=$('vwfStage'),svg=$('vwfWires');
  if(!stage||!svg||!stage.offsetWidth)return;
  var wb=stage.getBoundingClientRect(),z=S.vz||1;
  svg.setAttribute('viewBox','0 0 '+stage.offsetWidth+' '+stage.offsetHeight);
  svg.style.height=stage.offsetHeight+'px';
  stage.querySelectorAll('.holabel').forEach(function(e){e.remove()});
  function box(el){var r=el.getBoundingClientRect();
    return{x:(r.left-wb.left)/z,y:(r.top-wb.top)/z,w:r.width/z,h:r.height/z}}
  var d='';
  /* spine: root → each agent header */
  var root=stage.querySelector('.vroot .rn');
  if(root){
    var rb=box(root),rx=rb.x+rb.w/2,ry=rb.y+rb.h;
    stage.querySelectorAll('.vhead').forEach(function(h){
      var hb=box(h),hx=hb.x+hb.w/2,hy=hb.y;
      var k=Math.max(16,(hy-ry)*0.55);
      d+='<path class="spine" d="M'+rx+' '+ry+' C'+rx+' '+(ry+k)+', '+hx+' '+(hy-k)+', '+hx+' '+hy+'"/>';
    });
  }
  /* handoffs between lanes */
  TWF.hos.forEach(function(ho){
    var a=stage.querySelector('[data-stage="'+ho.from+'|'+ho.fs+'"]');
    var b=stage.querySelector('[data-stage="'+ho.to+'|'+ho.ts+'"]');
    if(!a||!b)return;
    var ab=box(a),bb=box(b);
    var x1=ab.x+ab.w,y1=ab.y+ab.h/2,x2=bb.x,y2=bb.y+bb.h/2,mx=(x1+x2)/2;
    d+='<path class="ho" d="M'+x1+' '+y1+' C'+mx+' '+y1+', '+mx+' '+y2+', '+x2+' '+y2+'"/>';
    var lb=document.createElement('button');
    lb.className='holabel';lb.textContent=ho.id+' ↗';
    lb.style.left=mx+'px';lb.style.top=((y1+y2)/2)+'px';
    lb.onclick=function(e){e.stopPropagation();openHO(ho.id)};
    stage.appendChild(lb);
  });
  svg.innerHTML=d;
}
/* ---- canvas pan + zoom ---- */
function vapply(){
  var st=$('vwfStage');if(!st)return;
  st.style.transform='translate('+S.vx+'px,'+S.vy+'px) scale('+S.vz+')';
  var v=$('vwf');
  if(v)v.style.backgroundPosition=S.vx+'px '+S.vy+'px';
  var zv=$('vzv');if(zv)zv.textContent=Math.round(S.vz*100)+'%';
}
function vzoom(dir,cx,cy){
  var v=$('vwf');if(!v)return;
  var old=S.vz;
  var nz=Math.min(2,Math.max(.35,old*(dir>0?1.12:1/1.12)));
  var r=v.getBoundingClientRect();
  cx=(cx==null?r.width/2:cx);cy=(cy==null?r.height/2:cy);
  S.vx=cx-(cx-S.vx)*(nz/old);
  S.vy=cy-(cy-S.vy)*(nz/old);
  S.vz=nz;vapply();
}
function vfit(){
  var v=$('vwf'),st=$('vwfStage');if(!v||!st)return;
  var prev=st.style.transform;st.style.transform='scale(1)';
  var w=st.scrollWidth;st.style.transform=prev;
  /* fit the width like a board, not the full height — you pan down for the rest */
  var z=Math.min(1.1,Math.max(.5,(v.clientWidth-32)/w));
  S.vz=z;S.vx=Math.max(8,(v.clientWidth-w*z)/2);S.vy=10;
  vapply();
}
function toggleLegend(){
  var l=$('vlegend');l.classList.toggle('min');
  $('lgcv').textContent=l.classList.contains('min')?'▸':'▾';
}
(function(){
  var v=$('vwf');if(!v)return;
  var drag=null;
  v.addEventListener('pointerdown',function(e){
    if(e.target.closest('.vinst,.holabel,.zoompill,.vlegend,.canvashint'))return;
    drag={x:e.clientX,y:e.clientY,vx:S.vx,vy:S.vy};
    v.classList.add('grabbing');
    try{v.setPointerCapture(e.pointerId)}catch(_){}
  });
  v.addEventListener('pointermove',function(e){
    if(!drag)return;
    S.vx=drag.vx+(e.clientX-drag.x);S.vy=drag.vy+(e.clientY-drag.y);vapply();
  });
  function end(){drag=null;v.classList.remove('grabbing')}
  v.addEventListener('pointerup',end);
  v.addEventListener('pointercancel',end);
  v.addEventListener('wheel',function(e){
    e.preventDefault();
    var r=v.getBoundingClientRect();
    vzoom(e.deltaY<0?1:-1,e.clientX-r.left,e.clientY-r.top);
  },{passive:false});
})();
window.addEventListener('resize',function(){if(S.tower==='workflow'&&S.filter==='all'){requestAnimationFrame(function(){drawVWF();vfit()})}});
function renderSingle(a){
  var g=AG[a];
  $('sf-av').textContent=g.av; $('sf-av').style.background=g.bg;
  $('sf-name').textContent=g.n; $('sf-role').textContent=g.r;
  $('sf-health').textContent=g.h; $('sf-desc').textContent=g.d;
  $('sf-stages').innerHTML=g.st.map(function(s){
    var cell=s[2];
    if(a==='iris'&&cell.indexOf('HELD')>-1&&!S.held)cell='EX-4472 · decided ✓';
    var held=cell.indexOf('HELD')>-1, done=cell.indexOf('✓')>-1;
    return '<div class="stc"><h5>'+s[0]+'</h5><p>'+s[1]+'</p>'+
      (cell!=='—'?'<'+(held?'button':'div')+' class="inst'+(held?' held':(done?' done':''))+'" '+(held?'onclick="openPacket()"':'')+'><span class="what">'+cell+'</span></'+(held?'button':'div')+'>'
        :'<div style="font-size:11px;color:var(--muted-foreground)">nothing here right now</div>')+
      '<div class="last">'+s[3]+'</div></div>';
  }).join('');
  makeKeyboardReachable();
}
function togglePause(a){
  S.paused[a]=!S.paused[a];
  if(S.filter===a&&$('wf-single').style.display!=='none')renderSingle(a);
  if(S.filter==='all'&&S.tower==='workflow')renderVWF();
  renderAgCards();
  var run=$('ss-run');
  if(run)run.textContent=3-Object.keys(S.paused).filter(function(k){return S.paused[k]}).length;
  toast(S.paused[a]?AG[a].n+' paused — takes no new cases; in-flight work finishes safely.':AG[a].n+' active again.');
}

/* ============ ORCHESTRATOR: motives ============ */
var MOTIVES=[
 {id:'monitor',icon:'◎',t:'See what needs me',p:'Everything moving right now, with whatever is waiting on your decision pulled to the top.',def:true,
  badge:function(){return S.held?'<span class="pill warn">1 waiting on you</span>':'<span class="pill ok">nothing waiting</span>'},
  cases:['EX-4472','EX-4474','EX-4479','CL-2210']},
 {id:'investigate',icon:'⌕',t:'Understand a case',p:'Follow one case stage by stage — what each agent did, and the routes it chose not to take.',
  badge:function(){return '<span class="pill nu">4 open cases</span>'},
  cases:['EX-4474','EX-4472','EX-4479','CL-2210']},
 {id:'trace',icon:'⑃',t:'Question a decision',p:'Pick a moment that surprised you and see the rule, the evidence, and who was allowed to make it.',
  badge:function(){return '<span class="pill nu">4 decisions</span>'},
  cases:['TR-held','TR-warranty','TR-alone','TR-customer']},
 {id:'test',icon:'⇄',t:'Try a change safely',p:'Move a limit and replay real history before anything changes. Nothing goes live without approval.',
  badge:function(){return S.pendingLimit?'<span class="pill warn">1 proposal pending</span>':'<span class="pill nu">sandbox</span>'},
  cases:['SIM-pr']},
 {id:'audit',icon:'▤',t:'Prove what happened',p:'A closed case as an evidence bundle: every decision, every verified write, every human moment.',
  badge:function(){return '<span class="pill ok">1 closed today</span>'},
  cases:['EX-4471']}
];
function renderEntry(){
  $('mgrid').innerHTML=MOTIVES.map(function(m){
    return '<button class="mcard'+(m.def?' def':'')+'" onclick="goFlow(\''+m.id+'\')">'+
      (m.def?'<span class="defbadge">start here</span>':'')+
      '<div class="mi">'+m.icon+'</div><h4>'+m.t+'</h4><p>'+m.p+'</p>'+
      '<div class="mf">'+m.badge()+'</div></button>';
  }).join('');
}

