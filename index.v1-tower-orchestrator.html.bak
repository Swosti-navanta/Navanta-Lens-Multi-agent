/* ============ flow rendering ============ */
function goFlow(motive,caseId){
  if(S.p!=='orch')document.querySelector('.ptab[data-p=orch]').click();
  S.motive=motive;
  var m=MOTIVES.filter(function(x){return x.id===motive})[0];
  S.caseId=caseId||m.cases[0];
  $('o-entry').style.display='none';
  $('o-ws').style.display='';
  renderPanes();renderFlow();
}
function backToEntry(){
  S.motive=null;$('o-ws').style.display='none';$('o-entry').style.display='';renderEntry();
}
function togglePane(side){
  var k=side==='L'?'paneL':'paneR';
  S[k]=!S[k];
  $('pane'+side).classList.toggle('collapsed',S[k]);
  $('pane'+side+'x').textContent=side==='L'?(S[k]?'›':'‹'):(S[k]?'‹':'›');
}
function renderPanes(){
  $('motiveList').innerHTML=MOTIVES.map(function(m){
    return '<button class="mitem'+(m.id===S.motive?' on':'')+'" onclick="goFlow(\''+m.id+'\')">'+
      '<span class="ic">'+m.icon+'</span>'+m.t+'</button>';
  }).join('');
  var m=MOTIVES.filter(function(x){return x.id===S.motive})[0];
  var label={monitor:'In flight',investigate:'Open cases',trace:'Decisions to question',
             test:'Sandboxes',audit:'Closed cases'}[S.motive];
  $('caseListLabel').textContent=label;
  $('caseList').innerHTML=m.cases.map(function(cid){
    var c=CASES[cid]||TRACES[cid];
    if(cid==='SIM-pr')return '<button class="citem'+(cid===S.caseId?' on':'')+'" onclick="pickCase(\''+cid+'\')">'+
      '<span class="cn">Purchase requisition limit</span><span class="cm">Iris · currently $'+S.limit.toLocaleString()+'</span></button>';
    if(cid==='EX-4471')return '<button class="citem'+(cid===S.caseId?' on':'')+'" onclick="pickCase(\''+cid+'\')">'+
      '<div class="ch"><span class="cid">EX-4471</span><span class="pill ok">closed</span></div>'+
      '<span class="cn">Vendor lead time +10 days</span><span class="cm">6 decisions · 7 verified writes</span></button>';
    if(!c)return '';
    var isTrace=!!TRACES[cid];
    return '<button class="citem'+(cid===S.caseId?' on':'')+'" onclick="pickCase(\''+cid+'\')">'+
      (isTrace?'':'<div class="ch"><span class="cid">'+cid+'</span>'+statusPill(cid)+'</div>')+
      '<span class="cn">'+c.title+'</span>'+
      '<span class="cm">'+(isTrace?c.sub:c.meta.slice(0,2).map(function(x){return x[0]+' '+x[1]}).join(' · '))+'</span></button>';
  }).join('');
}
function statusPill(cid){
  if(cid==='EX-4472')return S.held?'<span class="pill warn">waiting on you</span>':'<span class="pill ok">decided</span>';
  if(cid==='EX-4474')return '<span class="pill info">acting</span>';
  if(cid==='EX-4479')return '<span class="pill nu">early</span>';
  if(cid==='CL-2210')return '<span class="pill nu">waiting</span>';
  return '';
}
function pickCase(cid){S.caseId=cid;renderPanes();renderFlow()}

function renderFlow(){
  if(S.motive==='test')return renderTest();
  var c=CASES[S.caseId]||TRACES[S.caseId];
  if(!c){$('flowScroll').innerHTML='<div class="emptyflow">Pick something on the left to see its flow.</div>';return}

  // header
  var isTrace=!!TRACES[S.caseId];
  $('canvasH').innerHTML='<div class="ci">'+(isTrace?'':'<div class="cid">'+S.caseId+'</div>')+
    '<h3>'+c.title+'</h3><div class="cs">'+c.sub+'</div></div>'+
    '<div class="cmeta">'+c.meta.map(function(m){return '<div>'+m[0]+'<b>'+m[1]+'</b></div>'}).join('')+'</div>';

  // stages
  var parts=[];
  c.stages.forEach(function(st,i){
    if(st.ho){
      parts.push('<div class="horow"><button class="hoflag" onclick="openHO(\''+st.ho+'\')">'+
        st.ho+' <span class="hl2">'+st.hoLabel+'</span> ↗</button></div>');
      return;
    }
    var own=st.own?AG[st.own]:null;
    var body='<div class="scard '+st.s+'">'+
      '<div class="sc-h"><span class="si">'+st.i+'</span><span class="sn">'+st.n+'</span>'+
      (st.now?'<span class="nowflag" style="margin-left:auto">now</span>':'<span class="st">'+(st.t||'')+'</span>')+'</div>'+
      (own?'<div class="sc-o"><span class="oav" style="background:'+own.bg+'">'+own.av+'</span>'+own.n+'</div>':'')+
      '<div class="sc-b">'+st.items.map(function(it){
        return '<button class="titem '+(it.k||'')+'" onclick="openStep(\''+it.d+'\')" data-step="'+it.d+'"><b>'+it.b+'</b><span>'+it.s+'</span></button>';
      }).join('')+'</div></div>';
    var branch=st.branch?'<div class="branch"><div class="bcard"><div class="bh">'+st.branch.h+'</div>'+
      '<div class="bw">'+st.branch.w+'</div></div></div>':'';
    parts.push('<div class="stagerow">'+body+branch+'</div>');
  });
  $('flowScroll').innerHTML=zoomBar()+
    '<div class="flowcanvas" id="flowCanvas" style="transform:scale('+S.zoom+');transform-origin:top center">'+
    '<svg class="flowwires" id="flowWires"></svg>'+
    '<div class="flowrow">'+parts.join('')+'</div></div>';
  renderActions();
  makeKeyboardReachable();
  requestAnimationFrame(drawWires);
}
function zoomBar(){
  return '<div class="zoomer"><button onclick="zoomFlow(-1)" aria-label="Zoom out">−</button>'+
    '<span class="zl" id="zLabel">'+Math.round(S.zoom*100)+'%</span>'+
    '<button onclick="zoomFlow(1)" aria-label="Zoom in">+</button>'+
    '<span class="zdiv"></span>'+
    '<button onclick="zoomFlow(0)" aria-label="Reset zoom" style="font-size:11px">⤢</button></div>';
}
function zoomFlow(dir){
  var steps=[0.6,0.7,0.8,0.9,1,1.1,1.25,1.5];
  if(dir===0)S.zoom=1;
  else{
    var i=steps.indexOf(S.zoom);
    if(i<0)i=steps.indexOf(1);
    i=Math.min(steps.length-1,Math.max(0,i+dir));
    S.zoom=steps[i];
  }
  var fc=$('flowCanvas');
  if(fc){fc.style.transform='scale('+S.zoom+')';$('zLabel').textContent=Math.round(S.zoom*100)+'%'}
}
/* woven connectors — one clean spine, branches curving off to the right */
function drawWires(){
  var wrap=$('flowCanvas'),svg=$('flowWires');
  if(!wrap||!svg)return;
  var wb=wrap.getBoundingClientRect();
  if(!wb.width)return;
  svg.setAttribute('viewBox','0 0 '+wrap.offsetWidth+' '+wrap.offsetHeight);
  svg.style.height=wrap.offsetHeight+'px';
  var nodes=[].slice.call(wrap.querySelectorAll('.scard,.hoflag'));
  var d='';
  function box(el){var r=el.getBoundingClientRect();
    return{x:r.left-wb.left,y:r.top-wb.top,w:r.width,h:r.height}}
  for(var i=0;i<nodes.length-1;i++){
    var a=box(nodes[i]),b=box(nodes[i+1]);
    var x1=a.x+a.w/2,y1=a.y+a.h,x2=b.x+b.w/2,y2=b.y;
    var k=Math.max(14,(y2-y1)*0.45);
    var hot=nodes[i+1].classList.contains('active')||nodes[i+1].classList.contains('held');
    d+='<path class="'+(hot?'hot':'')+'" d="M'+x1+' '+y1+' C'+x1+' '+(y1+k)+', '+x2+' '+(y2-k)+', '+x2+' '+y2+'"/>';
    d+='<circle cx="'+x2+'" cy="'+y2+'" r="3" fill="'+(hot?'var(--brand)':'#cbd2da')+'"/>';
  }
  wrap.querySelectorAll('.stagerow').forEach(function(row){
    var card=row.querySelector('.scard'),br=row.querySelector('.bcard');
    if(!card||!br)return;
    var a=box(card),b=box(br);
    var x1=a.x+a.w,y1=a.y+a.h/2,x2=b.x,y2=b.y+b.h/2;
    var mx=(x1+x2)/2;
    d+='<path class="dash" d="M'+x1+' '+y1+' C'+mx+' '+y1+', '+mx+' '+y2+', '+x2+' '+y2+'"/>';
  });
  svg.innerHTML=d;
}
window.addEventListener('resize',function(){if(S.motive&&S.motive!=='test')requestAnimationFrame(drawWires)});
function renderTest(){
  $('canvasH').innerHTML='<div class="ci"><h3>Purchase requisition limit</h3>'+
    '<div class="cs">move the line, replay real history — nothing changes until it is approved</div></div>'+
    '<div class="cmeta"><div>Current<b>$'+ (150000).toLocaleString() +'</b></div>'+
    '<div>Testing<b id="tm-now">$'+S.limit.toLocaleString()+'</b></div>'+
    '<div>Agent<b>Iris</b></div></div>';
  var rows=HOLDS.map(function(h){
    var auto=h[3]<=S.limit;
    return '<div class="scard '+(auto?'done':'held')+'" style="width:auto;margin-bottom:8px">'+
      '<div class="sc-h"><span class="si">'+(auto?'▸':'◇')+'</span><span class="sn">'+h[0]+'</span>'+
      '<span class="st">'+h[1]+'</span></div>'+
      '<div class="sc-b"><div class="titem '+(auto?'ok':'warn')+'" style="cursor:default"><b>'+
      (auto?'would auto-run':'still held for a person')+'</b><span>'+h[2]+'</span></div></div></div>';
  }).join('');
  var freed=HOLDS.filter(function(h){return h[3]<=S.limit}).length;
  $('flowScroll').innerHTML=
   '<div style="max-width:560px">'+
   '<div class="card" style="padding:18px 20px;margin-bottom:14px">'+
     '<div class="lab">Set the limit</div>'+
     '<input type="range" min="100000" max="300000" step="10000" value="'+S.limit+'" id="limSlider" '+
       'oninput="setLimit(+this.value)" style="width:100%;accent-color:var(--brand)">'+
     '<div style="display:flex;justify-content:space-between;font-family:Geist Mono,monospace;font-size:11px;color:var(--text-neutral);margin-top:4px">'+
       '<span>$100k</span><span id="limNow" style="color:var(--brand);font-weight:600">$'+S.limit.toLocaleString()+(S.limit===150000?' (current)':'')+'</span><span>$300k</span></div>'+
     '<div style="margin-top:14px;background:var(--surface-accent);border:1px solid #ddd0f2;border-radius:10px;padding:12px 15px;font-size:13px;color:var(--brand-deep)" id="limImpact">'+limCopy(freed)+'</div>'+
   '</div>'+
   '<div class="lab">Replayed against this month’s 5 above-limit holds</div>'+rows+
   '</div>';
  renderActions();
}
function limCopy(freed){
  if(S.limit===150000)return 'At the current $150k limit: 5 requisitions were above the line this month · $1,018,200 routed to planners.';
  if(S.limit>150000)return 'At $'+S.limit.toLocaleString()+': '+freed+' of those 5 would have run on their own · your queue shrinks, the agent’s exposure grows.';
  return 'At $'+S.limit.toLocaleString()+': tighter than today — smaller requisitions that run automatically now would stop for a person instead.';
}
var HOLDS=[['EX-4472','$214,000','coverage gap across 6 DCs',214000],
 ['EX-4451','$182,400','reorder point rebuild',182400],
 ['EX-4438','$168,000','seasonal build-ahead',168000],
 ['EX-4429','$296,500','dual-source split',296500],
 ['EX-4415','$157,300','expedite bundle',157300]];
function setLimit(v){
  S.limit=v;
  $('limNow').textContent='$'+v.toLocaleString()+(v===150000?' (current)':'');
  $('tm-now').textContent='$'+v.toLocaleString();
  var freed=HOLDS.filter(function(h){return h[3]<=v}).length;
  $('limImpact').textContent=limCopy(freed);
  renderTest();
  $('limSlider').focus();
}

/* ============ right panel ============ */
/* ===== right panel: Act / Activity / Notes ===== */
var CASE_TL={
 'EX-4472':[
  {t:'08:14:02',b:'Signal picked up',s:'Mercer caught the lead-time change from the supplier feed',k:'ok'},
  {t:'08:14:04',b:'41 of 47 orders slip',s:'checked every open PO against the new date',k:'ok'},
  {t:'08:14:09',b:'Handed to Iris',s:'HO-8831 accepted with facts, assumptions and authority',k:'ok'},
  {t:'08:14:11',b:'Coverage replanned',s:'3 SKUs break across 6 DCs from day 12',k:'ok'},
  {t:'08:14:12',b:'Two requisitions executed',s:'$96,400 written to Fusion and verified',k:'ok'},
  {t:'08:14:12',b:'One requisition held',s:'$214,000 is above your $150,000 limit',k:'warn'},
  {t:'now',b:'Waiting on your decision',s:'2h 11m so far · roughly $1.8k a day',k:'now'}],
 'EX-4474':[
  {t:'09:38:41',b:'Claim raised',s:'POD and customer photos arrived together',k:'ok'},
  {t:'09:38:42',b:'Matched to SO-48219',s:'found in Fusion on the first lookup',k:'ok'},
  {t:'09:39:10',b:'Warranty checked first',s:'expired 2025-11, so it was assessed as damage',k:'ok'},
  {t:'09:39:12',b:'Damage confirmed',s:'photos match the POD pattern · conf 0.93',k:'ok'},
  {t:'09:39:14',b:'Credit auto-approved',s:'$8,400 sits inside the $10,000 limit',k:'ok'},
  {t:'now',b:'Customer confirming',s:'17h left on the 48-hour soft hold',k:'now'}],
 'EX-4479':[
  {t:'09:41:02',b:'Three signals picked up',s:'VN-2210 feed · not yet a case',k:'ok'},
  {t:'now',b:'Assessing exposure',s:'31 of 47 open orders checked so far',k:'now'}],
 'CL-2210':[
  {t:'06:22:10',b:'Claim opened',s:'from records already held — no proof demanded up front',k:'ok'},
  {t:'now',b:'Waiting on photos',s:'3h 20m · a reminder can be sent',k:'warn'}],
 'EX-4471':[
  {t:'08:14:02',b:'Signal picked up',s:'lead-time notice caught in 0.8s',k:'ok'},
  {t:'08:14:08',b:'Acted alone',s:'all three tests passed · 42 writes verified',k:'ok'},
  {t:'10:25:00',b:'Planner rejected the held PR',s:'"SKU 44-2213 phases out in Q4"',k:'warn'},
  {t:'day 9',b:'Closed and logged',s:'6.1s of agent time vs a 3.5-day baseline',k:'ok'}]
};
function renderActions(){
  var el=$('actionsBody');if(!el)return;
  if(S.motive==='test'){
    el.innerHTML='<div class="act-block"><h5>Propose</h5>'+
      (S.pendingLimit
        ?'<div class="act-card"><h6>Proposal pending</h6><p>PR limit $'+S.pendingLimit.toLocaleString()+
          ' sent to the policy owner with the replay attached. The live limit is still $150,000.</p>'+
          '<div class="btnrow"><button class="btn" onclick="withdrawLimit()">Withdraw</button></div></div>'
        :'<div class="act-card calm"><h6>Nothing proposed yet</h6><p>Move the limit, then send it to the policy owner with the replay attached.</p>'+
          '<div class="btnrow"><button class="btn pr" onclick="proposeLimit()">Propose $'+S.limit.toLocaleString()+'</button></div></div>')+
      '</div><div class="act-block"><h5>Guardrails that never move</h5>'+
      '<div class="fkv"><span>Confidence floor</span><b>0.85</b></div>'+
      '<div class="fkv"><span>Never alone</span><b>customer credit</b></div>'+
      '<div class="fkv"><span>Safety stock move</span><b>&le; 25%</b></div></div>';
    return;
  }
  var c=CASES[S.caseId]||TRACES[S.caseId];
  if(!c){el.innerHTML='';return}
  el.innerHTML=
   '<div class="ptabs2">'+
     '<button class="'+(S.atab==='act'?'on':'')+'" onclick="actTab(\'act\')">Act</button>'+
     '<button class="'+(S.atab==='activity'?'on':'')+'" onclick="actTab(\'activity\')">Activity</button>'+
     '<button class="'+(S.atab==='notes'?'on':'')+'" onclick="actTab(\'notes\')">Notes</button>'+
   '</div>'+
   '<div class="apane'+(S.atab==='act'?' on':'')+'" id="ap-act">'+actPane(c)+'</div>'+
   '<div class="apane'+(S.atab==='activity'?' on':'')+'" id="ap-activity">'+activityPane()+'</div>'+
   '<div class="apane'+(S.atab==='notes'?' on':'')+'" id="ap-notes">'+notesPane()+'</div>';
  makeKeyboardReachable();
}
function actTab(t){
  S.atab=t;
  document.querySelectorAll('.ptabs2 button').forEach(function(b,i){
    b.classList.toggle('on',['act','activity','notes'][i]===t)});
  ['act','activity','notes'].forEach(function(k){$('ap-'+k).classList.toggle('on',k===t)});
}
function actPane(c){
  var h='';
  /* the one thing that needs a person */
  if(S.caseId==='EX-4472'&&S.held){
    h+='<div class="act-block"><h5>Needs you now</h5><div class="act-card">'+
      '<h6>$214,000 requisition</h6><p>Above your $150,000 limit &mdash; the only reason you are being asked. '+
      'Two alternatives are costed inside the packet.</p>'+
      '<div class="btnrow"><button class="btn pr" onclick="openPacket()">Open decision packet</button>'+
      '<button class="btn" onclick="snooze()">Snooze 1h</button></div></div></div>';
  }else if(S.caseId==='EX-4472'){
    h+='<div class="act-block"><h5>Decided</h5><div class="act-card calm"><h6>This case is answered</h6>'+
      '<p>The outcome is on the flow and in the activity tab. Nothing is waiting on you.</p></div></div>';
  }
  if(S.caseId==='EX-4474'){
    h+='<div class="act-block"><h5>Waiting on the customer</h5><div class="act-card'+(S.nudged4474?' calm':'')+'">'+
      '<h6>'+(S.nudged4474?'Reminder sent':'Confirmation outstanding')+'</h6>'+
      '<p>The credit is issued. 17h left on the soft hold for the customer to confirm.</p>'+
      '<div class="btnrow"><button class="btn" onclick="nudge4474()"'+(S.nudged4474?' disabled':'')+'>'+
      (S.nudged4474?'Reminder sent':'Nudge customer')+'</button>'+
      '<button class="btn" onclick="escalate()">Escalate to a person</button></div></div></div>';
  }
  if(S.caseId==='CL-2210'){
    h+='<div class="act-block"><h5>Waiting on the customer</h5><div class="act-card">'+
      '<h6>Photos not in yet</h6><p>Three hours since the claim opened.</p>'+
      '<div class="btnrow"><button class="btn" onclick="toast(\'Reminder sent — logged on CL-2210.\')">Send reminder</button>'+
      '<button class="btn" onclick="escalate()">Escalate</button></div></div></div>';
  }

  /* ask about this case — a real input point */
  h+='<div class="askmini"><div class="aml">Ask about this case</div>'+
    '<textarea id="caseAsk" placeholder="e.g. what happens if I do nothing until Monday?"></textarea>'+
    '<div class="amf"><button class="btn pr sm" onclick="caseAskGo()">Ask</button>'+
    '<button class="btn sm" onclick="addNote()">Save as note</button></div>'+
    '<div class="sugg">'+askSuggestions().map(function(q){
      return '<button onclick="caseAskEx(\''+q.replace(/'/g,"\\'")+'\')">'+q+'</button>'}).join('')+'</div></div>';

  /* things a person can do that are not just reading */
  h+='<div class="act-block"><h5>Change something</h5><div class="qa">'+
    (CASES[S.caseId]?'<button class="btn w" onclick="reassign()">Reassign to a person</button>':'')+
    '<button class="btn w" onclick="correctFact()">Correct a fact the agent used</button>'+
    '<button class="btn w" onclick="goFlow(\'test\')">Test a limit change</button>'+
    (S.caseId==='EX-4471'?'<button class="btn w" onclick="copyAudit()">Export the audit bundle</button>':'')+
    '</div></div>';

  h+='<div class="act-block"><h5>At a glance</h5>'+
    c.meta.map(function(m){return '<div class="fkv"><span>'+m[0]+'</span><b>'+m[1]+'</b></div>'}).join('')+'</div>';
  return h;
}
function askSuggestions(){
  return {'EX-4472':['What breaks if I say no?','Why this amount?','Who else could approve?'],
   'EX-4474':['Can we recover this from the vendor?','Has this customer claimed before?'],
   'EX-4479':['Which customers are exposed?','When does this become a case?'],
   'CL-2210':['What if the photos never arrive?'],
   'EX-4471':['What did this cost us?','What changed after the override?']}[S.caseId]||
   ['Why did it route this way?','What would change the outcome?'];
}
function activityPane(){
  var tl=CASE_TL[S.caseId];
  if(!tl)return '<div class="empty-s">No activity recorded for this view.</div>';
  return '<div class="tl">'+tl.map(function(e){
    return '<div class="tle '+(e.k||'')+'"><div class="tt">'+e.t+'</div>'+
      '<div class="tb">'+e.b+'</div><div class="ts">'+e.s+'</div></div>'}).join('')+'</div>';
}
function notesPane(){
  var list=(S.notes[S.caseId]||[]);
  return '<div class="askmini"><div class="aml">Add a note to this case</div>'+
    '<textarea id="noteBox" placeholder="Context the agents cannot see — a supplier call, a decision made offline…"></textarea>'+
    '<div class="amf"><button class="btn pr sm" onclick="addNote()">Save note</button></div></div>'+
    (list.length?list.map(function(n){
      return '<div class="note-i"><div class="nh">'+n.t+' · you</div><div class="nb">'+esc(n.b)+'</div></div>'}).join('')
      :'<div class="empty-s">No notes yet. Anything you add here travels with the case and is visible to whoever picks it up next.</div>');
}
function nowStamp(){var d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')}
function addNote(){
  var box=$('noteBox')||$('caseAsk');
  var v=(box&&box.value||'').trim();
  if(!v){toast('Type the note first — it travels with the case.');if(box)box.focus();return}
  S.notes[S.caseId]=S.notes[S.caseId]||[];
  S.notes[S.caseId].unshift({t:nowStamp(),b:v});
  box.value='';S.atab='notes';renderActions();
  toast('Note saved on '+S.caseId+' — visible to whoever picks this case up next.');
}
function caseAskEx(q){$('caseAsk').value=q;caseAskGo()}
function caseAskGo(){
  var v=($('caseAsk').value||'').trim();
  if(!v){toast('Type a question about this case.');return}
  var a=answerFor(v.toLowerCase());
  openDrawer('<div class="dr-k">'+S.caseId+' · answer</div><div class="dr-t">'+esc(v)+'</div>'+
    '<div class="dr-s">'+a.body+'</div>'+
    a.rows.map(function(r){return '<div class="kv"><span>'+r[0]+'</span><b>'+r[1]+'</b></div>'}).join('')+
    '<div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">'+
    '<button class="btn" onclick="closeAll();goFlow(\'trace\')">Trace the decision</button>'+
    '<button class="btn" onclick="closeAll();S.atab=\'notes\';renderActions()">Add a note</button></div>');
  $('caseAsk').value='';
}
function answerFor(q){
  if(/nothing|do nothing|monday|wait/.test(q))return{body:'Doing nothing keeps the cover gap open. Dalton and Cartersville break first, around day 12, and the expedite cost runs at roughly $1.8k a day until the window closes.',
    rows:[['Cost of waiting','~$1.8k/day'],['First break','Dalton · day 12'],['Reversible','yes — the draft stays open']]};
  if(/why this amount|amount|214/.test(q))return{body:'The $214,000 covers an 18% safety-stock lift on the three SKUs that fall below service target inside the window. It is the full-cover option; a partial option at about $128k is in the packet.',
    rows:[['Full cover','$214,000'],['Partial option','~$128,000'],['SKUs','3'],['Window','3 months']]};
  if(/who else|approve|delegate/.test(q))return{body:'Anyone with the planning-lead role can approve above $150,000. The category manager is always notified but cannot approve alone.',
    rows:[['Can approve','planning lead'],['Notified','category manager'],['Your limit','$150,000']]};
  if(/breaks if|say no|reject/.test(q))return{body:'Rejecting leaves the three SKUs uncovered — an estimated 4.1% service loss on the affected lines. Iris will not re-raise the same requisition; your reason shapes the next recommendation instead.',
    rows:[['Service impact','~4.1% loss'],['Re-raised?','no'],['Your reason','feeds the next run']]};
  if(/vendor|recover|charge/.test(q))return{body:'The vendor scorecard is updated automatically once the claim closes. Recovery against the carrier is a separate claim — Iris opens it when the collection is booked.',
    rows:[['Scorecard','updated on close'],['Carrier claim','opens with collection']]};
  if(/claimed before|history|before/.test(q))return{body:'No pattern of false claims on this account. The vendor score was pulled during validation and came back clean, which is part of why the credit auto-issued.',
    rows:[['Prior claims','none flagged'],['Vendor score','clean'],['Effect','auto-issue allowed']]};
  return{body:'Routing follows lane ownership and policy: supplier facts to Mercer, coverage and requisitions to Iris, customer promises to Christy. Every stop names the rule that caused it — open any step on the flow to see the evidence behind it.',
    rows:[['Routing by','lane + policy'],['Every stop','names its rule'],['Evidence','on each step']]};
}
function snooze(){toast('Snoozed for 1 hour. It returns to the top of your list at '+
  String((new Date().getHours()+1)%24).padStart(2,'0')+':'+String(new Date().getMinutes()).padStart(2,'0')+'.')}
function escalate(){
  openDrawer('<div class="dr-k">'+S.caseId+' · escalate</div><div class="dr-t">Bring a person in</div>'+
   '<div class="dr-s">The case keeps running; the person you pick gets the packet and the full history, not a summary.</div>'+
   '<div class="kv"><span>Planning lead</span><b>Dana R.</b></div>'+
   '<div class="kv"><span>Category manager</span><b>Marcus O.</b></div>'+
   '<div class="kv"><span>Service lead</span><b>Priya N.</b></div>'+
   '<div style="margin-top:16px;display:flex;gap:8px">'+
   '<button class="btn pr" onclick="toast(\'Escalated to Dana R. — she has the packet and the history.\');closeAll()">Send to Dana R.</button>'+
   '<button class="btn" onclick="closeAll()">Cancel</button></div>');
}
function reassign(){
  openDrawer('<div class="dr-k">'+S.caseId+' · reassign</div><div class="dr-t">Take this off the agents</div>'+
   '<div class="dr-s">The agents stop acting on it and hand you everything they have. You can hand it back at any point.</div>'+
   '<div class="kv"><span>Current owner</span><b>'+(CASES[S.caseId]&&CASES[S.caseId].meta.filter(function(m){return m[0]==='Owner'})[0]||['','—'])[1]+'</b></div>'+
   '<div class="kv"><span>Work done so far</span><b>stays attached</b></div>'+
   '<div class="kv"><span>Agents will</span><b>stop acting, keep watching</b></div>'+
   '<div style="margin-top:16px;display:flex;gap:8px">'+
   '<button class="btn pr" onclick="toast(\''+S.caseId+' reassigned to you. The agents stopped acting and kept the history attached.\');closeAll()">Reassign to me</button>'+
   '<button class="btn" onclick="closeAll()">Cancel</button></div>');
}
function correctFact(){
  openDrawer('<div class="dr-k">'+S.caseId+' · correct a fact</div><div class="dr-t">Tell the agent it is wrong</div>'+
   '<div class="dr-s">If a fact behind the recommendation is wrong, correct it here. The agent re-runs from the corrected fact and says what changed.</div>'+
   '<div class="kv"><span>Facts used</span><b>see the flow steps</b></div>'+
   '<textarea class="rzn on" id="factBox" placeholder="e.g. Dalton reopens on the 14th, not the 20th — the coverage gap is shorter than modelled" style="min-height:88px"></textarea>'+
   '<div style="margin-top:12px;display:flex;gap:8px">'+
   '<button class="btn pr" onclick="submitFact()">Submit correction</button>'+
   '<button class="btn" onclick="closeAll()">Cancel</button></div>');
}
function submitFact(){
  var v=($('factBox').value||'').trim();
  if(!v){toast('Describe what is wrong — the agent re-runs from your correction.');$('factBox').focus();return}
  S.notes[S.caseId]=S.notes[S.caseId]||[];
  S.notes[S.caseId].unshift({t:nowStamp(),b:'Correction: '+v});
  closeAll();S.atab='notes';renderActions();
  toast('Correction logged. Iris will re-run from it and show what changed.');
}
/* ============ ask ============ */
function askEx(q){$('askInput').value=q;runAsk()}
function runAsk(){
  var q=($('askInput').value||'').toLowerCase().trim();
  if(!q){toast('Type what you want to see, or pick a starting point below.');return}
  if(/214|held|hold|requisition|why.*stop/.test(q))return goFlow('trace','TR-held');
  if(/warrant/.test(q))return goFlow('trace','TR-warranty');
  if(/alone|without asking|mercer/.test(q))return goFlow('trace','TR-alone');
  if(/customer.*(chose|decide|option)|who decided/.test(q))return goFlow('trace','TR-customer');
  if(/claim|damage|pallet/.test(q))return goFlow('investigate','EX-4474');
  if(/limit|what if|change|sandbox|test/.test(q))return goFlow('test');
  if(/audit|prove|export|evidence|4471/.test(q))return goFlow('audit','EX-4471');
  if(/4472/.test(q))return goFlow('investigate','EX-4472');
  goFlow('monitor');
  toast('Not sure what you meant — here is everything that needs you.');
}

/* ============ step / drawer detail ============ */
var STEPS={
 signal:['Signal · vendor lead time','The supplier feed carried a lead-time change before anyone opened an inbox.',[['Source','EDI 824 · supplier feed'],['Vendor','VN-3391'],['Change','+10 days'],['Caught in','0.8s']]],
 assess1:['Assess · which orders slip','Every open PO from this vendor was checked against the new date.',[['Checked','47 open POs'],['Slipping','41'],['Absorb without slip','6'],['Read from','Oracle Fusion']]],
 write1:['Write · lead time updated','Mercer acted alone because all three tests passed, then Fusion confirmed the write.',[['Rule','LT ≤ 15 days'],['This change','10 days'],['Exposure','$38,200 < $50k'],['Verified','by Fusion ✓']]],
 assess2:['Replan · where cover breaks','Coverage rerun across six DCs against the longer lead time.',[['SKUs at risk','3'],['DCs','6'],['First to break','Dalton · day 12'],['Read from','OMP · Manhattan']]],
 tradeoff:['Trade-off · both sides costed','Neither number is hidden: the risk of doing nothing and the cost of covering.',[['Unprotected','~4.1% service loss'],['Fully covered','$214k working capital'],['Window','3 months']]],
 prs:['Three requisitions drafted','Drafted together, then judged separately by the gate.',[['PR 1','$44,100'],['PR 2','$52,300'],['PR 3','$214,000'],['Limit','$150,000']]],
 'gate-pass':['Gate · two passed','Inside the planner’s limit, so they executed and verified without interrupting anyone.',[['Amount','$96,400 combined'],['Rule','PR ≤ $150,000'],['Written to','Oracle Fusion ✓']]],
 'gate-hold':['Gate · one stopped','The agent drafted it and stopped. It did not argue its confidence up to push it through.',[['Amount','$214,000'],['Limit','$150,000'],['Confidence','0.88 (floor 0.85)'],['Reason','authority — not doubt']]],
 packet:['Your decision packet','A bounded question with the investigation attached, not re-opened.',[['Recommendation','raise cover on 3 SKUs'],['Alternatives','2 costed'],['Cost of waiting','$1.8k/day'],['Waiting','2h 11m']]],
 'future-a':['If you approve','The PR is released and only closes once Fusion confirms the write.',[['Then','executes'],['Closes when','target system confirms']]],
 'future-r':['If you reject','Your reason is captured and shapes the next recommendation.',[['Requires','a reason'],['Effect','no silent repeat']]],
 'claim-in':['Claim raised','Opened from the POD and photos — the customer was not asked to prove it first.',[['Evidence','POD + photos'],['Damage','2 pallets'],['Caught in','0.4s']]],
 matched:['Matched to the order','Found on the first lookup, so no search route was needed.',[['Order','SO-48219'],['Confidence','0.97'],['Read from','Oracle Fusion']]],
 warranty:['Warranty checked first','Checked before treating it as damage — the window had closed.',[['Expired','2025-11'],['Read from','product master'],['Result','damage route']]],
 photos:['Photos match the POD','Damage pattern consistent with the delivery record.',[['Confidence','0.93'],['Floor','0.85'],['Evidence','POD + 4 photos']]],
 vendor:['Vendor score pulled','No pattern of false claims on this account.',[['Source','vendor scorecard'],['Result','no flag']]],
 'gate-4474':['Gate · inside authority','$8,400 sits under the $10,000 credit limit, so no person was interrupted.',[['Credit','$8,400'],['Limit','$10,000'],['Result','auto-approved']]],
 'conf-4474':['Confidence cleared the floor','Both the money test and the confidence test had to pass.',[['Confidence','0.93'],['Floor','0.85']]],
 credit:['Credit issued','Written to Fusion and confirmed by Fusion — not just sent.',[['Amount','$8,400'],['System','Oracle Fusion'],['Status','verified ✓']]],
 invoice:['Invoice corrected','The customer sees the corrected balance, not a promise of one.',[['Action','invoice amended'],['Customer','notified']]],
 'return':['Return and collection','Handed to Iris, who owns the logistics booking.',[['Owner','Iris'],['Via','HO-8834'],['Waiting on','customer confirmation']]],
 score:['Vendor scorecard updated','This outcome sharpens the next detection on the lane.',[['Written to','Databricks'],['Effect','detection tuning']]],
 'sig-4479':['Three new signals','Picked up from the feed; not yet a case.',[['Feed','VN-2210'],['Signals','3'],['Stage','pre-case']]],
 'assess-4479':['Assessing exposure','Checking whether any promise dates actually move.',[['Checked','31 of 47'],['Owner','Mercer']]],
 'next-4479':['If dates slip','A case opens and routes to Iris for coverage.',[['Next owner','Iris'],['Trigger','any committed date moves']]],
 'quiet-4479':['If nothing slips','It closes quietly and nobody is interrupted.',[['Outcome','logged'],['Interruptions','none']]],
 'cl-open':['Claim opened','From records already held — no proof demanded up front.',[['Owner','Christy'],['Age','3h 20m']]],
 'cl-wait':['Waiting on photos','A reminder can be sent from the actions panel.',[['Waiting on','customer'],['Action','reminder available']]],
 'cl-next':['Then it validates','The same path EX-4474 took: POD, photos, vendor score.',[['Next','validate'],['Rule','credit ≤ $10k auto']]],
 t1:['The decision','The requisition was held, not executed.',[['Case','EX-4472'],['Amount','$214,000']]],
