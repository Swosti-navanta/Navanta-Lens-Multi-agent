<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Navanta Agent Experience</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
<style>
/* ===== Navanta Design System tokens (@navanta-ai/design-system) ===== */
:root{
  --background:#ffffff; --foreground:#09090b; --card:#ffffff;
  --primary:#232122; --primary-foreground:#ffffff;
  --secondary:#f4f4f5; --secondary-foreground:#27272a;
  --muted:#f4f4f5; --muted-foreground:#4b5563;
  --destructive:#dc2626; --success:#16a34a; --warning:#f59e0b; --info:#0ea5e9;
  --border:#e4e4e7; --input:#d4d4d8; --ring:#c4c4c8;
  --radius:.5rem; --radius-md:.375rem; --radius-lg:.5rem; --radius-xl:.75rem; --radius-full:9999px;
  --brand:#6440b6; --brand-deep:#3b0764;
  --surface-raised:#f8fafc; --surface-grey:#fafafa; --surface-hover:#f4f4f5;
  --surface-accent:color-mix(in oklab,#6440b6 10%,#fff);
  --text-neutral:#6b7280; --text-heading:#1e1e1e; --text-link:#005b89;
  --border-light:#f1f3f5; --border-strong:#71717b;
  --switch-on:#0087ce; --switch-off:rgba(60,60,67,.3);
  --pill-info-bg:#eff6ff; --pill-info-fg:#1e40af;
  --pill-danger-bg:#fff1f2; --pill-danger-fg:#a7000f;
  --pill-warning-bg:#fffbeb; --pill-warning-fg:#92400e;
  --pill-neutral-bg:#f4f4f5; --pill-neutral-fg:#18181b;
  --pill-success-bg:#f0fdf4; --pill-success-fg:#166534;
  --shadow-card:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);
  --shadow-menu:0 4px 6px -1px rgb(0 0 0/.1),0 2px 4px -2px rgb(0 0 0/.1);
  --shadow-modal:0 20px 25px -5px rgb(0 0 0/.1),0 8px 10px -6px rgb(0 0 0/.1);
  --gradient-brand:linear-gradient(135deg,#6440b6 0%,#3b0764 100%);
  --gradient-christy:linear-gradient(154.42deg,#1d4a86 1.66%,#3d348b 83.4%);
  --progress-track:#e4e4e7;
  --gp-blue:linear-gradient(90deg,#89a9e5 0%,#89a9e5 54%,#234687 100%);
  --gp-green:linear-gradient(90deg,#86efac 0%,#86efac 54%,#166534 100%);
  --mercer:#6440b6; --iris:#00648f; --christy:#3d348b;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#f4f4f5}
body{font-family:'Geist',-apple-system,BlinkMacSystemFont,sans-serif;color:var(--foreground);
  font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased}
.mono{font-family:'Geist Mono',ui-monospace,monospace}
button{font-family:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--ring);outline-offset:2px;border-radius:var(--radius-md);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--ring) 35%,transparent)}

/* ===== shell ===== */
.app{max-width:1560px;margin:0 auto;min-height:100vh;background:var(--background);
  box-shadow:0 0 0 1px var(--border);display:flex;flex-direction:column}
.top{background:var(--background);border-bottom:1px solid var(--border);padding:0 26px;
  display:flex;align-items:center;gap:20px;position:sticky;top:0;z-index:40}
.brand{display:flex;align-items:center;gap:11px;padding:13px 0}
.mk{width:30px;height:30px;border-radius:8px;background:var(--gradient-brand);
  color:#fff;font-weight:600;font-size:15px;display:flex;align-items:center;justify-content:center}
.bt{font-size:15px;font-weight:600;letter-spacing:-.01em;line-height:1.2}
.bs{font-size:11px;color:var(--muted-foreground)}
.ptabs{display:flex;gap:18px;margin-left:16px;align-self:stretch}
.ptab{border:0;background:none;font-size:13.5px;font-weight:500;color:var(--muted-foreground);
  padding:0 2px;position:relative;display:flex;align-items:center}
.ptab::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:3px;border-radius:3px 3px 0 0;background:transparent}
.ptab:hover{color:var(--foreground)}
.ptab.on{color:var(--foreground);font-weight:600}
.ptab.on::after{background:var(--primary)}
.top-r{margin-left:auto;display:flex;align-items:center;gap:14px}
.live{display:flex;align-items:center;gap:7px;font-size:12px;color:var(--muted-foreground)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.pol{font-family:'Geist Mono',monospace;font-size:11px;color:var(--muted-foreground);
  background:var(--secondary);padding:3px 9px;border-radius:5px}
.view{display:none}.view.on{display:block;animation:fade .2s ease}
@keyframes fade{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}

/* ===== primitives ===== */
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);box-shadow:var(--shadow-card)}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;
  padding:2px 9px;border-radius:var(--radius-full);white-space:nowrap}
.pill.warn{background:var(--pill-warning-bg);color:var(--pill-warning-fg)}
.pill.dng{background:var(--pill-danger-bg);color:var(--pill-danger-fg)}
.pill.ok{background:var(--pill-success-bg);color:var(--pill-success-fg)}
.pill.info{background:var(--pill-info-bg);color:var(--pill-info-fg)}
.pill.nu{background:var(--pill-neutral-bg);color:var(--pill-neutral-fg)}
.pill.br{background:var(--surface-accent);color:var(--brand)}
.btn{border:1px solid var(--border);background:var(--background);color:var(--foreground);
  font-size:12.5px;font-weight:500;height:32px;padding:0 14px;border-radius:var(--radius-md);
  display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap}
.btn:hover{background:var(--surface-hover)}
.btn.pr{background:var(--primary);border-color:var(--primary);color:var(--primary-foreground)}
.btn.pr:hover{background:#000}
.btn.dng{border-color:#fecaca;color:var(--destructive)}
.btn.dng:hover{background:var(--pill-danger-bg)}
.btn.sm{height:26px;padding:0 10px;font-size:11.5px}
.btn.w{width:100%}
.btn:disabled{opacity:.55;cursor:default}
.lab{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:10px}
.sw{position:relative;width:36px;height:21px;border-radius:99px;background:var(--switch-on);border:0;flex:0 0 auto}
.sw::after{content:'';position:absolute;top:2px;left:17px;width:17px;height:17px;border-radius:50%;background:#fff;
  box-shadow:0 1px 2px rgba(0,0,0,.25);transition:left .2s}
.sw.off{background:var(--switch-off)}
.sw.off::after{left:2px}

/* ===== CONTROL TOWER ===== */
.body{padding:20px 26px 40px;flex:1}
.subbar{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
.seg{display:flex;background:var(--secondary);border-radius:9px;padding:3px}
.seg button{border:0;background:none;font-size:12.5px;font-weight:500;color:var(--muted-foreground);padding:6px 16px;border-radius:7px}
.seg button.on{background:var(--background);color:var(--foreground);font-weight:600;box-shadow:var(--shadow-card)}
.subhint{font-size:12px;color:var(--muted-foreground)}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:14px 16px;box-shadow:var(--shadow-card)}
.kpi.alert{border-color:#fcd34d;background:#fffdf5;cursor:pointer}
.kpi.alert:hover{border-color:var(--warning)}
.kpi-l{font-size:11.5px;color:var(--muted-foreground);margin-bottom:4px}
.kpi-v{font-family:'Geist Mono',monospace;font-size:22px;font-weight:500;letter-spacing:-.02em;line-height:1.2}
.kpi-s{font-size:11px;color:var(--text-neutral);margin-top:3px}
.agrow{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px;margin-bottom:18px}
.ag{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:14px 16px;box-shadow:var(--shadow-card);border-top:3px solid var(--ac);cursor:pointer;text-align:left;width:100%}
.ag:hover{border-color:var(--border-strong);border-top-color:var(--ac)}
.ag.paused{background:var(--surface-grey);border-color:var(--input)}
.ag.paused .now{color:var(--pill-warning-fg);background:var(--pill-warning-bg);border-color:#f5e2b8}
.ag.paused .now i{animation:none;background:var(--warning)}
.ag.paused .av,.ag.paused .hl,.ag.paused .auto{opacity:.6}
.ag-h{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.av{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;
  font-weight:600;font-size:13px;color:#fff;flex:0 0 auto}
.ag-n{font-size:15px;font-weight:600;line-height:1.15}
.ag-r{font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral)}
.hl{margin-left:auto;text-align:right}
.hl b{font-family:'Geist Mono',monospace;font-size:16px;font-weight:500}
.hl span{display:block;font-size:9.5px;color:var(--text-neutral);letter-spacing:.05em;text-transform:uppercase}
.now{font-size:12px;color:var(--muted-foreground);background:var(--surface-grey);border:1px solid var(--border-light);
  border-radius:7px;padding:6px 10px;margin-bottom:9px;display:flex;gap:7px;align-items:center;min-height:32px}
.now i{width:6px;height:6px;border-radius:50%;background:var(--ac);animation:pulse 1.6s infinite;flex:0 0 auto}
.ag-m{display:flex;gap:14px;font-size:11.5px;color:var(--muted-foreground);margin-bottom:9px}
.ag-m b{font-family:'Geist Mono',monospace;font-weight:500;color:var(--foreground)}
.auto{display:flex;align-items:center;gap:9px;margin-bottom:11px}
.auto .trk{flex:1;height:6px;background:var(--progress-track);border-radius:4px;overflow:hidden}
.auto .trk i{display:block;height:100%;border-radius:4px;background:var(--gp-blue)}
.auto span{font-size:10.5px;color:var(--muted-foreground);white-space:nowrap}
.ag-f{display:flex;gap:8px;align-items:center}
.ag-f .sw{margin-left:auto}
.paused-note{font-size:10.5px;color:var(--pill-warning-fg);margin-top:7px;display:none}
.ag.paused .paused-note{display:block}
.nrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center;padding:13px 18px;border-bottom:1px solid var(--border-light)}
.nrow:last-child{border-bottom:0}
.nrow:hover{background:var(--surface-grey)}
.nr-t{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:2px}
.nr-id{font-family:'Geist Mono',monospace;font-size:12px;font-weight:500;color:var(--text-link)}
.nr-name{font-size:13.5px;font-weight:600}
.nr-s{font-size:12px;color:var(--muted-foreground)}
.nr-a{display:flex;gap:8px}
.strips{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.strip{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:14px 18px;box-shadow:var(--shadow-card)}
.sys{display:flex;gap:8px;flex-wrap:wrap}
.sysc{display:flex;align-items:center;gap:7px;font-size:12px;background:var(--surface-grey);
  border:1px solid var(--border-light);border-radius:7px;padding:5px 11px;font-family:inherit;color:inherit}
.sysc b{font-weight:600;font-size:12px}
.sysc .st{width:7px;height:7px;border-radius:50%;background:var(--success)}
.sysc.warn{cursor:pointer}
.sysc.warn .st{background:var(--warning);animation:pulse 1.4s infinite}
.ov{font-size:12.5px;padding:8px 0;border-bottom:1px solid var(--border-light);line-height:1.5}
.ov:last-child{border-bottom:0}
.ov .why{color:var(--muted-foreground);font-style:italic}
.ov .fed{font-size:11.5px;color:var(--brand);margin-top:2px}
.val{display:flex;gap:22px;flex-wrap:wrap}
.val div b{display:block;font-family:'Geist Mono',monospace;font-size:19px;font-weight:500}
.val div span{font-size:11px;color:var(--muted-foreground)}
.wfbar{display:flex;gap:8px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.fch{border:1px solid var(--border);background:var(--background);border-radius:99px;font-size:12px;font-weight:500;color:var(--muted-foreground);padding:5px 14px}
.fch:hover{background:var(--surface-hover)}
.fch.on{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
.legend{margin-left:auto;display:flex;gap:14px;font-size:11px;color:var(--muted-foreground);flex-wrap:wrap}
.legend b{width:9px;height:9px;border-radius:3px;display:inline-block;vertical-align:-1px;margin-right:4px;font-weight:400}
.wf{overflow-x:auto}
.wf-grid{min-width:980px}
.wf-head{display:grid;grid-template-columns:130px repeat(7,1fr);gap:6px;padding:0 0 8px}
.wf-head div{font-size:10px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);text-align:center}
.wf-head div:first-child{text-align:left}
.lane{display:grid;grid-template-columns:130px repeat(7,1fr);gap:6px;padding:10px 0;border-top:1px solid var(--border-light);align-items:stretch}
.lane-ag{display:flex;align-items:center;gap:9px}
.lane-ag .av{width:26px;height:26px;border-radius:7px;font-size:11px}
.lane-ag b{font-size:13px;font-weight:600;display:block;line-height:1.15}
.lane-ag span{font-size:9.5px;color:var(--text-neutral);text-transform:uppercase;letter-spacing:.05em}
.cell{background:var(--surface-grey);border:1px dashed var(--border);border-radius:8px;min-height:52px;
  padding:5px;display:flex;flex-direction:column;gap:4px;justify-content:center}
.cell.gate{border-style:solid;border-color:#f0e2b6;background:#fffdf3}
.inst{border:1px solid var(--border);background:var(--background);border-radius:6px;padding:4px 8px;
  font-size:11px;line-height:1.35;box-shadow:0 1px 1px rgba(0,0,0,.04);text-align:left;width:100%;font-family:inherit;color:inherit;display:block}
.inst[onclick]{cursor:pointer}
.inst[onclick]:hover{border-color:var(--border-strong);background:var(--surface-grey)}
.inst .id{font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;color:var(--text-link)}
.inst .what{color:var(--muted-foreground);display:block}
.inst.held{border-color:#fcd34d;background:var(--pill-warning-bg)}
.inst.held .id{color:var(--pill-warning-fg)}
.inst.done{border-color:#bbe7c9;background:var(--pill-success-bg)}
.inst .act{margin-top:3px}
.ho-strip{display:flex;gap:10px;padding:4px 0 4px 136px;align-items:center}
.ho{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--background);
  border-radius:99px;font-size:11px;padding:3px 11px;color:var(--muted-foreground);box-shadow:0 1px 1px rgba(0,0,0,.04)}
.ho:hover{border-color:var(--brand);color:var(--brand)}
.ho b{font-family:'Geist Mono',monospace;font-weight:500;font-size:10.5px;color:var(--brand)}
.stagecards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.stc{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 13px;box-shadow:var(--shadow-card)}
.stc h5{font-size:10px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:5px}
.stc p{font-size:11.5px;color:var(--muted-foreground);line-height:1.45;margin-bottom:8px;min-height:48px}
.stc .last{font-size:10.5px;color:var(--text-neutral);border-top:1px solid var(--border-light);padding-top:6px;margin-top:6px}

/* ===== TOWER · Augury-style layout ===== */
.statusstrip{display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--muted-foreground)}
.statusstrip .sd{display:flex;align-items:center;gap:7px}
.statusstrip .sd i{width:7px;height:7px;border-radius:50%;background:var(--success)}
.statusstrip .sd.w i{background:var(--warning)}
.statusstrip .sd.f i{background:var(--input)}
.statusstrip b{font-weight:600;color:var(--foreground)}
.statusstrip .div{width:1px;height:14px;background:var(--border)}
.tower-split{display:grid;grid-template-columns:minmax(0,1fr) 344px;gap:16px;align-items:start}
.askpanel{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:16px 18px;box-shadow:var(--shadow-card);margin-bottom:18px}
.askpanel .ah{display:flex;align-items:center;gap:9px;margin-bottom:12px}
.askpanel .ah .sp{width:22px;height:22px;border-radius:7px;background:var(--gradient-brand);color:#fff;
  display:flex;align-items:center;justify-content:center;font-size:12px}
.askpanel .ah h3{font-size:15px;font-weight:600;letter-spacing:-.01em}
.askpanel .ai{display:flex;gap:9px}
.askpanel input{flex:1;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;
  font-size:13.5px;padding:10px 13px;color:var(--foreground);min-width:0}
.askpanel input:focus{outline:none;border-color:var(--brand)}
.askpanel .ac{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.askpanel .ac button{border:1px solid var(--border);background:var(--surface-grey);border-radius:99px;
  font-size:11.5px;padding:5px 12px;color:var(--muted-foreground)}
.askpanel .ac button:hover{border-color:var(--brand);color:var(--brand)}
.workband{border:1px solid var(--border);border-radius:var(--radius-xl);padding:14px;background:var(--surface-grey);margin-bottom:18px}
.workband .wl{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:11px}
.agcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(212px,1fr));gap:11px}
.agc{background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-card);
  overflow:hidden;text-align:left;width:100%;font-family:inherit;color:inherit;display:flex;flex-direction:column}
.agc:hover{border-color:var(--border-strong)}
.agc .tab{background:var(--ac);color:#fff;font-size:10.5px;font-weight:600;padding:4px 11px;
  border-radius:0 0 9px 0;align-self:flex-start;letter-spacing:.01em}
.agc .cb{padding:11px 13px 12px;display:flex;flex-direction:column;flex:1}
.agc h4{font-size:13.5px;font-weight:600;line-height:1.3;margin-bottom:7px;letter-spacing:-.005em}
.agc .stpill{align-self:flex-start;margin-bottom:10px}
.agc .mini{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:6px}
.agc .mrow{display:flex;gap:12px;margin-bottom:10px}
.agc .mrow div{text-align:left}
.agc .mrow b{display:block;font-family:'Geist Mono',monospace;font-size:17px;font-weight:500;line-height:1.15}
.agc .mrow span{font-size:9.5px;color:var(--text-neutral)}
.agc .hbar{height:5px;border-radius:3px;background:var(--progress-track);overflow:hidden;margin-bottom:9px}
.agc .hbar i{display:block;height:100%;border-radius:3px;background:var(--gp-blue)}
.agc .ft{margin-top:auto;padding-top:10px;border-top:1px solid var(--border-light);
  display:flex;align-items:center;gap:8px;font-size:10.5px;color:var(--text-neutral)}
.agc .ft .lk{margin-left:auto;color:var(--text-link);font-weight:600;font-size:11.5px}
.agc.paused{background:var(--surface-grey)}
.agc.paused .tab{background:var(--input)}
.tabsrow{display:flex;gap:18px;border-bottom:1px solid var(--border);margin-bottom:14px}
.tabsrow button{border:0;background:none;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  color:var(--text-neutral);padding:0 2px 10px;position:relative}
.tabsrow button::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;background:transparent}
.tabsrow button.on{color:var(--foreground)}
.tabsrow button.on::after{background:var(--primary)}
.tpane{display:none}.tpane.on{display:block}
/* right rail */
.rail{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:16px 18px;box-shadow:var(--shadow-card);position:sticky;top:73px}
.rail .rd{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:6px}
.rail h3{font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1.3;margin-bottom:9px}
.rail .tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.rail .tags span{font-size:11px;border:1px solid var(--border);border-radius:7px;padding:3px 9px;
  color:var(--muted-foreground);background:var(--surface-grey)}
.rl{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin:16px 0 8px}
.finding{border:1px solid #f3c6c6;background:#fff5f5;border-radius:11px;padding:12px 14px}
.finding.warn{border-color:#f5d78a;background:var(--pill-warning-bg)}
.finding .fh{font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  color:var(--pill-warning-fg);margin-bottom:7px;display:flex;align-items:center;gap:6px}
.finding ul{list-style:none;display:flex;flex-direction:column;gap:6px}
.finding li{font-size:12px;line-height:1.45;color:var(--foreground);padding-left:13px;position:relative}
.finding li::before{content:'▪';position:absolute;left:0;color:var(--pill-warning-fg)}
.finding .ff{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:9px;border-top:1px solid #f0dcae;font-size:11px;color:var(--muted-foreground)}
.plan{display:flex;flex-direction:column}
.pstep{display:flex;gap:11px;padding-bottom:14px;position:relative}
.pstep:last-child{padding-bottom:0}
.pstep::before{content:'';position:absolute;left:13px;top:28px;bottom:0;width:1px;background:var(--border)}
.pstep:last-child::before{display:none}
.pstep .pn{width:27px;height:27px;border-radius:8px;background:var(--secondary);color:var(--muted-foreground);
  display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto;z-index:1}
.pstep.now .pn{background:var(--brand);color:#fff}
.pstep .pc{flex:1;min-width:0}
.pstep .pw{font-size:10.5px;color:var(--text-neutral);margin-bottom:2px}
.pstep .pb{border:1px solid var(--border);background:var(--surface-grey);border-radius:9px;padding:9px 11px}
.pstep .pb b{display:block;font-size:12.5px;font-weight:600;line-height:1.3;margin-bottom:2px}
.pstep .pb span{font-size:11.5px;color:var(--muted-foreground);line-height:1.4;display:block}
.pstep .pb .chk{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;color:var(--pill-success-fg);
  background:var(--pill-success-bg);border-radius:6px;padding:2px 8px;margin-top:6px}
.execbtn{width:100%;margin-top:14px;height:40px;font-size:13.5px;font-weight:600}
@media(max-width:1180px){.tower-split{grid-template-columns:1fr}.rail{position:static}}

/* ===== tower workflow · infinite canvas ===== */
.vwf{position:relative;height:calc(100vh - 212px);min-height:520px;overflow:hidden;
  border:1px solid var(--border);border-radius:var(--radius-xl);background:#fbfbfc;
  background-image:radial-gradient(#dfe3e9 1.1px,transparent 1.1px);background-size:22px 22px;
  cursor:grab;touch-action:none;box-shadow:inset 0 1px 3px rgba(0,0,0,.03)}
.vwf.grabbing{cursor:grabbing}
.vwf-stage{position:absolute;top:0;left:0;transform-origin:0 0;padding:30px 36px 60px;width:1180px}
.vwf-wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:0}
.vwf-wires path{fill:none;stroke-width:1.8}
.vwf-wires path.spine{stroke:#c8cfd8}
.vwf-wires path.ho{stroke:var(--brand);stroke-dasharray:6 5;opacity:.85}
.vroot{display:flex;justify-content:center;margin-bottom:32px;position:relative;z-index:1}
.vroot .rn{display:inline-flex;align-items:center;gap:11px;background:var(--card);
  border:1.5px solid var(--brand);border-radius:12px;padding:11px 18px;box-shadow:var(--shadow-menu)}
.vroot .rn .ri{width:30px;height:30px;border-radius:8px;background:var(--gradient-brand);color:#fff;
  display:flex;align-items:center;justify-content:center;font-weight:600;font-size:14px;flex:0 0 auto}
.vroot .rn b{font-size:14px;font-weight:600;display:block;line-height:1.2}
.vroot .rn .sub{font-size:11px;color:var(--muted-foreground)}
.vroot .rn .rs{margin-left:10px;padding-left:14px;border-left:1px solid var(--border);
  font-family:'Geist Mono',monospace;font-size:12px;color:var(--muted-foreground)}
.vwf-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;position:relative;z-index:1}
.vcol{display:flex;flex-direction:column;gap:9px}
.vhead{background:var(--card);border:1px solid var(--border);border-radius:11px;
  padding:0 0 10px;box-shadow:var(--shadow-card);overflow:hidden}
.vhead .hbarline{display:flex;height:3px}
.vhead .hbarline i{display:block;height:100%}
.vhead .hin{display:flex;align-items:center;gap:9px;padding:10px 12px 0}
.vhead .av{width:26px;height:26px;border-radius:7px;font-size:11px}
.vhead b{font-size:13.5px;font-weight:600;display:block;line-height:1.15}
.vhead .role{font-size:9.5px;color:var(--text-neutral);text-transform:uppercase;letter-spacing:.05em}
.vhead .cnt{margin-left:auto;font-family:'Geist Mono',monospace;font-size:15px;font-weight:500;color:var(--muted-foreground)}
.vhead .hsub{display:flex;gap:10px;padding:7px 12px 0;font-size:10.5px;color:var(--text-neutral);flex-wrap:wrap}
.vhead .hsub b{display:inline;font-size:10.5px;font-weight:600;color:var(--muted-foreground)}
.vstage{border:1px solid var(--border-light);background:rgba(255,255,255,.7);border-radius:10px;padding:8px 10px}
.vstage.busy{background:var(--card);border-color:var(--border)}
.vstage.gate{background:#fffdf3;border-color:#f0e2b6}
.vstage .vsh{display:flex;align-items:center;gap:7px;margin-bottom:6px}
.vstage .vsn{font-size:10.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--text-neutral)}
.vstage.busy .vsn{color:var(--muted-foreground)}
.vstage .vsc{margin-left:auto;font-family:'Geist Mono',monospace;font-size:10px;color:var(--text-neutral)}
.vstage .empty{font-size:11px;color:var(--input)}
.vinst{border:1px solid var(--border);background:var(--background);border-radius:8px;padding:8px 10px;
  width:100%;text-align:left;font-family:inherit;color:inherit;display:block;margin-bottom:6px;
  box-shadow:0 1px 1px rgba(0,0,0,.04)}
.vinst:last-child{margin-bottom:0}
.vinst:hover{border-color:var(--border-strong)}
.vinst .cat{font-size:9.5px;color:var(--text-neutral);display:block;margin-bottom:1px}
.vinst .ttl{font-size:12.5px;font-weight:600;line-height:1.25;display:block}
.vinst .val{font-size:11.5px;color:var(--muted-foreground);line-height:1.35;display:block;margin-top:1px}
.vinst .sfoot{display:flex;align-items:center;gap:6px;margin-top:7px;padding-top:6px;
  border-top:1px solid var(--border-light);font-size:9.5px;color:var(--text-neutral);flex-wrap:wrap}
.vinst .sdot{width:6px;height:6px;border-radius:50%;flex:0 0 auto}
.vinst .sst{font-weight:600}
.vinst .sref{font-family:'Geist Mono',monospace}
.vinst .sconf{margin-left:auto;font-family:'Geist Mono',monospace}
.vinst.done{border-color:#bbe7c9;background:var(--pill-success-bg)}
.vinst.done .sdot{background:var(--success)}.vinst.done .sst{color:var(--pill-success-fg)}
.vinst.held{border-color:#fcd34d;background:var(--pill-warning-bg)}
.vinst.held .sdot{background:var(--warning)}.vinst.held .sst{color:var(--pill-warning-fg)}
.vinst.run .sdot{background:var(--brand)}.vinst.run .sst{color:var(--brand)}
.vinst.wait .sdot{background:var(--input)}.vinst.wait .sst{color:var(--muted-foreground)}
.holabel{position:absolute;transform:translate(-50%,-50%);z-index:2;background:var(--background);
  border:1px solid var(--brand);color:var(--brand);border-radius:99px;font-family:'Geist Mono',monospace;
  font-size:9.5px;font-weight:500;padding:3px 9px;white-space:nowrap;box-shadow:var(--shadow-card)}
.holabel:hover{background:var(--surface-accent)}
.vlegend{position:absolute;right:14px;bottom:14px;background:var(--card);border:1px solid var(--border);
  border-radius:11px;padding:11px 13px;box-shadow:var(--shadow-menu);z-index:6;min-width:168px}
.vlegend .lgh{display:flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;margin-bottom:7px;
  width:100%;background:none;border:0;font-family:inherit;color:inherit;padding:0}
.vlegend .lgh .cv{margin-left:auto;color:var(--text-neutral);font-size:11px}
.vlegend .lgb div{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted-foreground);padding:2px 0}
.vlegend.min .lgb{display:none}
.vlegend.min .lgh{margin-bottom:0}
.vlegend i{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
.zoompill{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:6;display:flex;
  align-items:center;gap:2px;background:var(--card);border:1px solid var(--border);border-radius:99px;
  padding:3px;box-shadow:var(--shadow-menu)}
.zoompill button{width:28px;height:28px;border-radius:99px;border:0;background:none;font-size:15px;
  color:var(--muted-foreground);display:flex;align-items:center;justify-content:center}
.zoompill button:hover{background:var(--surface-hover);color:var(--foreground)}
.zoompill .zv{font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--muted-foreground);min-width:44px;text-align:center}
.canvashint{position:absolute;left:14px;bottom:14px;z-index:6;font-size:11px;color:var(--muted-foreground);
  background:var(--card);border:1px solid var(--border);border-radius:99px;padding:5px 12px;box-shadow:var(--shadow-card)}

/* ===== zoom cluster ===== */
.zoomer{position:absolute;left:14px;top:12px;z-index:8;display:flex;align-items:center;gap:4px;
  background:var(--background);border:1px solid var(--border);border-radius:9px;padding:3px;box-shadow:var(--shadow-card)}
.zoomer button{width:27px;height:27px;border-radius:6px;border:0;background:none;font-size:14px;
  color:var(--muted-foreground);display:flex;align-items:center;justify-content:center}
.zoomer button:hover{background:var(--surface-hover);color:var(--foreground)}
.zoomer .zl{font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--muted-foreground);
  min-width:38px;text-align:center;padding:0 2px}
.zoomer .zdiv{width:1px;height:16px;background:var(--border);margin:0 2px}

/* ================= ORCHESTRATOR ================= */
/* --- entry --- */
.entry{max-width:1000px;margin:0 auto;padding:44px 26px 60px}
.entry h1{font-size:30px;font-weight:600;letter-spacing:-.02em;line-height:1.15;margin-bottom:8px;text-align:center}
.entry .sub{font-size:14.5px;color:var(--muted-foreground);text-align:center;margin-bottom:30px}
.askbox{border:1.5px solid var(--brand);border-radius:14px;padding:14px 16px;background:var(--background);
  box-shadow:0 0 0 4px var(--surface-accent);margin-bottom:14px}
.askbox .al{font-size:10.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--brand);margin-bottom:8px;display:flex;align-items:center;gap:7px}
.askbox .al i{width:14px;height:14px;border-radius:4px;background:var(--gradient-brand);display:inline-block}
.askrow{display:flex;gap:9px;align-items:flex-start}
.askrow input{flex:1;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;
  font-size:14px;padding:10px 13px;color:var(--foreground);min-width:0}
.askrow input:focus{outline:none;border-color:var(--brand)}
.askrow .btn{height:40px}
.exq{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}
.exq button{border:1px solid var(--border);background:var(--surface-grey);border-radius:99px;
  font-size:11.5px;padding:4px 12px;color:var(--muted-foreground)}
.exq button:hover{border-color:var(--brand);color:var(--brand)}
.ordiv{display:flex;align-items:center;gap:14px;margin:24px 0 18px;color:var(--text-neutral);font-size:11.5px;
  font-weight:600;letter-spacing:.09em;text-transform:uppercase}
.ordiv::before,.ordiv::after{content:'';flex:1;height:1px;background:var(--border)}
.mgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.mcard{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-xl);
  padding:18px 18px 16px;box-shadow:var(--shadow-card);text-align:left;position:relative;width:100%;font-family:inherit;color:inherit}
.mcard:hover{border-color:var(--brand);box-shadow:var(--shadow-menu)}
.mcard.def{border-color:var(--brand);background:var(--surface-accent)}
.mcard .mi{width:34px;height:34px;border-radius:10px;background:var(--secondary);color:var(--brand);
  display:flex;align-items:center;justify-content:center;font-size:17px;margin-bottom:11px}
.mcard.def .mi{background:var(--brand);color:#fff}
.mcard h4{font-size:15px;font-weight:600;letter-spacing:-.01em;margin-bottom:4px}
.mcard p{font-size:12.5px;color:var(--muted-foreground);line-height:1.45;min-height:52px}
.mcard .mf{display:flex;align-items:center;gap:7px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border-light);flex-wrap:wrap}
.mcard .defbadge{position:absolute;top:14px;right:14px;font-size:9.5px;font-weight:600;letter-spacing:.07em;
  text-transform:uppercase;background:var(--brand);color:#fff;padding:2px 8px;border-radius:99px}

/* --- flow workspace --- */
.ws{display:flex;height:calc(100vh - 57px);overflow:hidden}
.pane{background:var(--surface-grey);border-right:1px solid var(--border);width:264px;flex:0 0 264px;
  display:flex;flex-direction:column;transition:width .2s ease,flex-basis .2s ease;overflow:hidden}
.pane.right{border-right:0;border-left:1px solid var(--border);width:312px;flex-basis:312px;background:var(--background)}
.pane.collapsed{width:48px;flex-basis:48px}
.pane-h{display:flex;align-items:center;gap:9px;padding:13px 14px;border-bottom:1px solid var(--border);min-height:49px}
.pane-h .pt{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);white-space:nowrap}
.pane.collapsed .pt,.pane.collapsed .pane-b{display:none}
.pane-x{border:1px solid var(--border);background:var(--background);border-radius:7px;width:26px;height:26px;
  display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--muted-foreground);flex:0 0 auto}
.pane-x:hover{background:var(--surface-hover)}
.pane.right .pane-x{order:-1}
.pane.right .pt{order:0}
.pane-b{flex:1;overflow-y:auto;padding:14px}
.pane.collapsed .pane-h{padding:13px 10px;justify-content:center}
.grp-l{font-size:10px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin:2px 0 8px}
.grp-l.mt{margin-top:18px}
.mitem{display:flex;align-items:center;gap:9px;width:100%;border:1px solid transparent;background:none;
  border-radius:9px;padding:8px 10px;font-size:13px;text-align:left;color:var(--muted-foreground);font-family:inherit;margin-bottom:2px}
.mitem:hover{background:var(--surface-hover)}
.mitem.on{background:var(--background);border-color:var(--border);color:var(--foreground);font-weight:600;box-shadow:var(--shadow-card)}
.mitem .ic{width:22px;height:22px;border-radius:6px;background:var(--secondary);color:var(--brand);
  display:flex;align-items:center;justify-content:center;font-size:12px;flex:0 0 auto}
.mitem.on .ic{background:var(--brand);color:#fff}
.mitem .ct{margin-left:auto;font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--text-neutral)}
.citem{display:block;width:100%;border:1px solid var(--border);background:var(--background);border-radius:10px;
  padding:10px 12px;text-align:left;margin-bottom:7px;font-family:inherit;color:inherit;box-shadow:var(--shadow-card)}
.citem:hover{border-color:var(--border-strong)}
.citem.on{border-color:var(--brand);background:var(--surface-accent)}
.citem .ch{display:flex;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap}
.citem .cid{font-family:'Geist Mono',monospace;font-size:11px;font-weight:500;color:var(--text-link)}
.citem .cn{font-size:12.5px;font-weight:600;line-height:1.3;display:block;margin-bottom:3px}
.citem .cm{font-size:11px;color:var(--muted-foreground);display:flex;gap:8px;flex-wrap:wrap}

/* --- centre canvas --- */
.stagewrap{flex:1;min-width:0;display:flex;flex-direction:column;background:#fbfbfc;
  background-image:radial-gradient(#e2e5ea 1px,transparent 1px);background-size:20px 20px}
.canvas-h{background:var(--background);border-bottom:1px solid var(--border);padding:12px 20px;
  display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.canvas-h .ci{min-width:0}
.canvas-h .cid{font-family:'Geist Mono',monospace;font-size:12px;font-weight:500;color:var(--text-link)}
.canvas-h h3{font-size:16px;font-weight:600;letter-spacing:-.01em;line-height:1.25}
.canvas-h .cs{font-size:12px;color:var(--muted-foreground);margin-top:1px}
.canvas-h .cmeta{margin-left:auto;display:flex;gap:20px;flex-wrap:wrap}
.canvas-h .cmeta div{font-size:11px;color:var(--muted-foreground)}
.canvas-h .cmeta b{display:block;font-family:'Geist Mono',monospace;font-size:13.5px;font-weight:500;color:var(--foreground)}
.flowscroll{flex:1;overflow:auto;padding:26px 20px 46px}
.flowcanvas{position:relative;width:640px;margin:0 auto}
.flowwires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible;z-index:0}
.flowwires path{fill:none;stroke:#cbd2da;stroke-width:1.8;stroke-linecap:round}
.flowwires path.dash{stroke-dasharray:5 6;stroke-width:1.4}
.flowwires path.hot{stroke:var(--brand);stroke-width:2.1}
.flowrow{display:flex;flex-direction:column;align-items:flex-start;gap:38px;width:100%;position:relative;z-index:1}
.stagerow{display:flex;align-items:center;gap:0;width:100%}
.scard{width:340px;flex:0 0 auto;background:var(--card);border:1px solid var(--border);border-radius:12px;
  box-shadow:var(--shadow-card);overflow:hidden}
.scard.done{border-color:#c9e7d4}
.scard.done .sc-h{background:var(--pill-success-bg)}
.scard.active{border-color:var(--brand);box-shadow:0 0 0 3px var(--surface-accent),var(--shadow-card)}
.scard.active .sc-h{background:var(--surface-accent)}
.scard.held{border-color:#f5d78a}
.scard.held .sc-h{background:var(--pill-warning-bg)}
.scard.pending{border-style:dashed;background:var(--surface-grey);opacity:.85}
.sc-h{padding:9px 12px;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:8px}
.sc-h .si{width:20px;height:20px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  font-size:11px;background:var(--secondary);color:var(--muted-foreground);flex:0 0 auto}
.scard.done .sc-h .si{background:#bbe7c9;color:var(--pill-success-fg)}
.scard.active .sc-h .si{background:var(--brand);color:#fff}
.scard.held .sc-h .si{background:var(--warning);color:#fff}
.sc-h .sn{font-size:12.5px;font-weight:600;letter-spacing:-.005em}
.sc-h .st{margin-left:auto;font-family:'Geist Mono',monospace;font-size:10px;color:var(--text-neutral)}
.sc-o{display:flex;align-items:center;gap:7px;padding:8px 12px 0;font-size:11px;color:var(--muted-foreground)}
.sc-o .oav{width:18px;height:18px;border-radius:5px;color:#fff;font-size:9.5px;font-weight:600;
  display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.sc-b{padding:8px 12px 12px;display:flex;flex-direction:column;gap:6px}
.titem{border:1px solid var(--border);background:var(--background);border-radius:8px;padding:7px 10px;
  text-align:left;font-family:inherit;color:inherit;width:100%;font-size:11.5px;line-height:1.4}
.titem:hover{border-color:var(--brand);background:var(--surface-accent)}
.titem b{display:block;font-weight:600;font-size:11.5px;margin-bottom:1px}
.titem span{color:var(--muted-foreground);font-size:11px}
.titem.ok{border-color:#c9e7d4;background:var(--pill-success-bg)}
.titem.warn{border-color:#f5d78a;background:var(--pill-warning-bg)}
.titem.warn b{color:var(--pill-warning-fg)}
.branch{width:250px;flex:0 0 auto;position:relative;padding-left:34px}
.branch::before{content:'';position:absolute;left:0;top:50%;width:34px;border-top:1px dashed var(--input)}
.bcard{border:1px dashed var(--input);background:var(--surface-grey);border-radius:10px;padding:9px 12px}
.bcard .bh{font-size:11.5px;font-weight:600;color:var(--muted-foreground);margin-bottom:2px;display:flex;align-items:center;gap:6px}
.bcard .bw{font-size:11px;color:var(--text-neutral);font-style:italic;line-height:1.4}
.horow{display:flex;align-items:center;gap:10px;width:340px;padding:8px 0;justify-content:center}
.hoflag{background:var(--background);border:1px solid var(--brand);color:var(--brand);
  border-radius:99px;font-family:'Geist Mono',monospace;font-size:10.5px;font-weight:500;
  padding:5px 13px;white-space:nowrap;display:inline-flex;align-items:center;gap:7px}
.hoflag:hover{background:var(--surface-accent)}
.hoflag .hl2{font-family:'Geist',sans-serif;font-size:10.5px;color:var(--muted-foreground);font-weight:400}
.hoflag:hover .hl2{color:var(--brand)}
.nowflag{background:var(--brand);color:#fff;font-size:9px;font-weight:600;letter-spacing:.08em;
  padding:2px 7px;border-radius:99px;text-transform:uppercase}
.emptyflow{text-align:center;padding:60px 20px;color:var(--muted-foreground);font-size:13.5px}

/* right panel content */
.ptabs2{display:flex;gap:3px;background:var(--secondary);border-radius:9px;padding:3px;margin-bottom:14px}
.ptabs2 button{flex:1;border:0;background:none;font-size:12px;font-weight:500;color:var(--muted-foreground);
  padding:6px 4px;border-radius:7px}
.ptabs2 button.on{background:var(--background);color:var(--foreground);font-weight:600;box-shadow:var(--shadow-card)}
.apane{display:none}.apane.on{display:block}
.askmini{border:1px solid var(--input);border-radius:10px;padding:10px 11px;background:var(--surface-grey);margin-bottom:14px}
.askmini .aml{font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--brand);margin-bottom:7px}
.askmini textarea{width:100%;border:1px solid var(--input);border-radius:7px;font-family:inherit;font-size:12px;
  padding:8px 10px;min-height:56px;resize:vertical;background:var(--background);color:var(--foreground)}
.askmini textarea:focus{outline:none;border-color:var(--brand)}
.askmini .amf{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.sugg{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.sugg button{border:1px solid var(--border);background:var(--background);border-radius:99px;
  font-size:11px;padding:4px 10px;color:var(--muted-foreground)}
.sugg button:hover{border-color:var(--brand);color:var(--brand)}
.tl{position:relative;padding-left:20px}
.tl::before{content:'';position:absolute;left:5px;top:6px;bottom:6px;width:1px;background:var(--border)}
.tle{position:relative;padding:0 0 14px}
.tle:last-child{padding-bottom:0}
.tle::before{content:'';position:absolute;left:-18px;top:5px;width:9px;height:9px;border-radius:50%;
  background:var(--background);border:2px solid var(--border)}
.tle.ok::before{border-color:var(--success);background:var(--success)}
.tle.warn::before{border-color:var(--warning);background:var(--warning)}
.tle.now::before{border-color:var(--brand);background:var(--brand);box-shadow:0 0 0 3px var(--surface-accent)}
.tle .tt{font-size:10px;font-family:'Geist Mono',monospace;color:var(--text-neutral);margin-bottom:1px}
.tle .tb{font-size:12.5px;font-weight:600;line-height:1.35}
.tle .ts{font-size:11.5px;color:var(--muted-foreground);line-height:1.45;margin-top:1px}
.note-i{border:1px solid var(--border);background:var(--surface-grey);border-radius:9px;padding:9px 11px;margin-bottom:8px}
.note-i .nh{font-size:10px;font-family:'Geist Mono',monospace;color:var(--text-neutral);margin-bottom:3px}
.note-i .nb{font-size:12px;line-height:1.45}
.empty-s{font-size:12px;color:var(--text-neutral);font-style:italic;padding:10px 0}
.act-block{margin-bottom:18px}
.act-block h5{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:9px}
.act-card{border:1px solid #fcd34d;background:#fffdf5;border-radius:11px;padding:13px 14px;margin-bottom:10px}
.act-card h6{font-size:13px;font-weight:600;margin-bottom:4px;line-height:1.35}
.act-card p{font-size:11.5px;color:var(--muted-foreground);line-height:1.5;margin-bottom:10px}
.act-card .btnrow{display:flex;gap:7px;flex-wrap:wrap}
.act-card.calm{border-color:var(--border);background:var(--surface-grey)}
.fkv{display:flex;justify-content:space-between;gap:10px;font-size:12px;padding:6px 0;border-bottom:1px solid var(--border-light)}
.fkv:last-child{border-bottom:0}
.fkv span{color:var(--muted-foreground)}
.fkv b{font-family:'Geist Mono',monospace;font-weight:500;text-align:right;font-size:11.5px}
.qa{display:flex;flex-direction:column;gap:7px}

/* ===== drawer / modal / toast ===== */
.scrim{position:fixed;inset:0;background:rgba(9,9,11,.35);z-index:50;display:none}
.scrim.on{display:block}
.drawer{position:fixed;top:0;right:-440px;width:420px;max-width:94vw;height:100vh;background:var(--background);
  border-left:1px solid var(--border);box-shadow:var(--shadow-modal);z-index:60;transition:right .25s ease;
  padding:22px 24px;overflow:auto}
.drawer.on{right:0}
.dr-k{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-neutral);margin-bottom:8px}
.dr-t{font-size:17px;font-weight:600;letter-spacing:-.01em;margin-bottom:4px}
.dr-s{font-size:12.5px;color:var(--muted-foreground);margin-bottom:14px;line-height:1.5}
.kv{display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:7px 0;border-bottom:1px solid var(--border-light)}
.kv:last-child{border-bottom:0}
.kv span{color:var(--muted-foreground)}
.kv b{font-family:'Geist Mono',monospace;font-weight:500;text-align:right;font-size:12px}
.dr-x{position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--background);font-size:14px}
.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-46%) scale(.98);width:560px;max-width:94vw;
  max-height:88vh;overflow:auto;background:var(--background);border:1px solid var(--border);border-radius:14px;
  box-shadow:var(--shadow-modal);z-index:70;padding:24px 26px;display:none}
.modal.on{display:block;animation:pop .18s ease forwards}
@keyframes pop{to{transform:translate(-50%,-50%) scale(1)}}
.m-t{font-size:16px;font-weight:600;margin-bottom:2px}
.m-s{font-size:12px;color:var(--muted-foreground);margin-bottom:14px}
.opt{border:1px solid var(--border);border-radius:10px;padding:11px 14px;margin-bottom:9px}
.opt.rec{border-color:var(--brand);background:var(--surface-accent)}
.opt h6{font-size:12.5px;font-weight:600;display:flex;gap:8px;align-items:center}
.opt p{font-size:11.5px;color:var(--muted-foreground);margin-top:2px;line-height:1.45}
.m-f{display:flex;gap:9px;justify-content:flex-end;margin-top:16px;flex-wrap:wrap}
.rzn{width:100%;border:1px solid var(--input);border-radius:var(--radius-md);font-family:inherit;font-size:12.5px;
  padding:9px 11px;min-height:64px;resize:vertical;display:none;margin-top:4px}
.rzn.on{display:block}
.rz-err{display:none;font-size:11.5px;color:var(--destructive);margin-top:4px}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(70px);background:#18181b;
  color:#fafafa;font-size:12.5px;padding:10px 18px;border-radius:9px;z-index:90;transition:transform .25s ease;
  box-shadow:var(--shadow-modal);max-width:90vw}
.toast.on{transform:translateX(-50%) translateY(0)}

@media(max-width:1100px){
  .pane{position:absolute;z-index:20;height:100%;box-shadow:var(--shadow-menu)}
  .pane.right{right:0}
}
@media(max-width:900px){.strips{grid-template-columns:1fr}.nrow{grid-template-columns:1fr}}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <div class="brand"><div class="mk">N</div>
      <div><div class="bt">Navanta Lens</div><div class="bs">Agent operations</div></div></div>
    <div class="ptabs">
      <button class="ptab on" data-p="tower">Control Tower</button>
      <button class="ptab" data-p="orch">Orchestrator</button>
    </div>
    <div class="top-r">
      <span class="pol">policy v4.2</span>
      <div class="live"><span class="dot"></span> live</div>
    </div>
  </div>

  <!-- ============ CONTROL TOWER ============ -->
  <div class="view on" id="p-tower">
   <div class="body">
    <div class="subbar">
      <div class="seg">
        <button class="on" id="tv-status" onclick="towerView('status')">Today</button>
        <button id="tv-workflow" onclick="towerView('workflow')">Workflow</button>
      </div>
      <div class="statusstrip">
        <span class="sd"><i></i><b id="ss-run">3</b> running</span>
        <span class="div"></span>
        <span class="sd w"><i></i><b id="ss-held">1</b> waiting on you</span>
        <span class="div"></span>
        <span class="sd f"><i></i><b>0</b> faults</span>
        <span class="div"></span>
        <span>$339k at risk · 5 open cases</span>
      </div>
    </div>

    <div class="view on" id="t-status">
     <div class="tower-split">
      <div>
        <div class="askpanel">
          <div class="ah"><span class="sp">✦</span><h3>Work with your agents</h3></div>
          <div class="ai">
            <input id="towerAsk" placeholder="What do you want to get done?" onkeydown="if(event.key==='Enter')towerAskGo()">
            <button class="btn pr" onclick="towerAskGo()">Go</button>
          </div>
          <div class="ac">
            <button onclick="towerAskEx('what needs my attention?')">What needs my attention?</button>
            <button onclick="towerAskEx('anything about to break?')">Anything about to break?</button>
            <button onclick="towerAskEx('why was the $214k held?')">Why was the $214k held?</button>
            <button onclick="towerAskEx('what did we recover today?')">What did we recover today?</button>
          </div>
        </div>

        <div class="workband">
          <div class="wl">Working for you today</div>
          <div class="agcards" id="agCards"></div>
        </div>

        <div class="tabsrow">
          <button class="on" data-t="activity" onclick="towerTab('activity')">Recent activity</button>
          <button data-t="systems" onclick="towerTab('systems')">Systems</button>
          <button data-t="overrides" onclick="towerTab('overrides')">Overrides</button>
          <button data-t="value" onclick="towerTab('value')">Value</button>
        </div>

        <div class="tpane on" id="tp-activity">
          <div class="card">
            <div class="nrow" id="row-4472">
              <div>
                <div class="nr-t"><span class="nr-id">EX-4472</span><span class="nr-name">Coverage gap, 6 DCs</span>
                  <span class="pill warn" id="p-4472">held · $214,000</span></div>
                <div class="nr-s" id="s-4472">Iris raised 3 requisitions — two auto-ran, the third is above your $150k limit. Waiting on you 2h 11m · delay costs ≈ $1.8k/day.</div>
              </div>
              <div class="nr-a" id="a-4472">
                <button class="btn pr" onclick="openPacket()">Open packet</button>
                <button class="btn" onclick="goFlow('investigate','EX-4472')">Open flow</button>
              </div>
            </div>
            <div class="nrow" id="row-4474">
              <div>
                <div class="nr-t"><span class="nr-id">EX-4474</span><span class="nr-name">Damaged delivery claim · SO-48219</span>
                  <span class="pill info" id="p-4474">credit issuing · customer confirming</span></div>
                <div class="nr-s" id="s-4474">Christy validated the claim from the POD and photos. The $8,400 credit is issuing; alternate stock soft-held 48h — 17h left.</div>
              </div>
              <div class="nr-a">
                <button class="btn" id="nudge-4474" onclick="nudge4474()">Nudge customer</button>
                <button class="btn" onclick="goFlow('investigate','EX-4474')">Open flow</button>
              </div>
            </div>
            <div class="nrow">
              <div>
                <div class="nr-t"><span class="nr-id">EX-4468</span><span class="nr-name">Phase-out cover — overridden</span>
                  <span class="pill br" id="row-4468-pill">learning proposed</span></div>
                <div class="nr-s">Dana R. rejected with a reason. Proposed change: read the phase-out flag before any cover recommendation.</div>
              </div>
              <div class="nr-a"><button class="btn" onclick="openProposal()">Review change</button></div>
            </div>
            <div class="nrow">
              <div>
                <div class="nr-t"><span class="nr-id">EX-4471</span><span class="nr-name">Vendor lead time +10 days</span>
                  <span class="pill ok">resolved · verified</span></div>
                <div class="nr-s">7 writes confirmed by the target systems. Case closed in 6.1s of agent time; customer re-committed.</div>
              </div>
              <div class="nr-a"><button class="btn" onclick="goFlow('audit','EX-4471')">Audit</button></div>
            </div>
          </div>
        </div>

        <div class="tpane" id="tp-systems">
          <div class="card" style="padding:16px 18px">
            <div class="sys">
              <span class="sysc"><span class="st"></span><b>Fusion</b> 214r · 41w ✓</span>
              <button class="sysc warn" onclick="openRetry()"><span class="st"></span><b>OMP</b> 96r · 3w · 1 retrying</button>
              <span class="sysc"><span class="st"></span><b>Manhattan</b> 61r · 2w ✓</span>
              <span class="sysc"><span class="st"></span><b>Project44</b> read-only</span>
              <span class="sysc"><span class="st"></span><b>Product master</b> 44r</span>
              <span class="sysc"><span class="st"></span><b>Databricks</b> 213w ✓</span>
            </div>
            <div class="nr-s" style="margin-top:12px">Every write is confirmed by the target system before a case closes. One OMP write is retrying — click it to see the attempt history.</div>
          </div>
        </div>

        <div class="tpane" id="tp-overrides">
          <div class="card" style="padding:16px 18px">
            <div id="ovfeed">
              <div class="ov"><b>14:22 · Dana R. rejected EX-4468</b> — <span class="why">"SKU 44-2213 phases out in Q4 — don't build cover we'll write off."</span>
                <div class="fed">↻ fed back: phase-out check proposed before any cover recommendation</div></div>
              <div class="ov"><b>11:07 · Marcus O. adjusted EX-4455</b> — <span class="why">"Delay only hits the imported range — applied to 40 of 61 SKUs."</span>
                <div class="fed">↻ fed back: lead-time updates now scoped by source origin</div></div>
            </div>
          </div>
        </div>

        <div class="tpane" id="tp-value">
          <div class="card" style="padding:16px 18px">
            <div class="val">
              <div><b>$129k</b><span>protected today</span></div>
              <div><b>$67k</b><span>Mercer · service</span></div>
              <div><b>$41k</b><span>Iris · stock-outs</span></div>
              <div><b>$21k</b><span>Christy · promises</span></div>
              <div><b>38h</b><span>planner hours saved</span></div>
            </div>
            <div class="nr-s" style="margin-top:12px">Measured against the 3.5-day manual baseline — not against agent activity counts.</div>
          </div>
        </div>
      </div>

      <aside class="rail" id="towerRail"></aside>
     </div>
    </div>

    <div class="view" id="t-workflow">
      <div class="wfbar">
        <button class="fch on" data-f="all" onclick="wfFilter('all')">All agents</button>
        <button class="fch" data-f="mercer" onclick="wfFilter('mercer')">Mercer</button>
        <button class="fch" data-f="iris" onclick="wfFilter('iris')">Iris</button>
        <button class="fch" data-f="christy" onclick="wfFilter('christy')">Christy</button>
        
      </div>

      <div id="wf-all">
        <div class="vwf" id="vwf">
          <div class="vwf-stage" id="vwfStage">
            <svg class="vwf-wires" id="vwfWires"></svg>
            <div class="vroot"><div class="rn">
              <span class="ri">N</span>
              <span><b>Today's operation</b><span class="sub">3 agents · 5 open cases · policy v4.2</span></span>
              <span class="rs" id="vrootStat">$339k at risk</span>
            </div></div>
            <div class="vwf-cols" id="vwfCols"></div>
          </div>
          <div class="zoompill">
            <button onclick="vzoom(-1)" aria-label="Zoom out">−</button>
            <span class="zv" id="vzv">100%</span>
            <button onclick="vzoom(1)" aria-label="Zoom in">+</button>
            <button onclick="vfit()" aria-label="Fit to screen" style="font-size:12px">⤢</button>
          </div>
          <div class="canvashint">drag to pan · scroll to zoom</div>
          <div class="vlegend" id="vlegend">
            <button class="lgh" onclick="toggleLegend()">Reading this board<span class="cv" id="lgcv">▾</span></button>
            <div class="lgb">
              <div><i style="background:var(--success)"></i>Verified by the system</div>
              <div><i style="background:var(--brand)"></i>Running now</div>
              <div><i style="background:var(--warning)"></i>Needs your decision</div>
              <div><i style="background:var(--input)"></i>Waiting on someone</div>
            </div>
          </div>
        </div>
      </div>

      <div id="wf-single" style="display:none">
        <div class="card" style="padding:16px 18px;margin-bottom:12px">
          <div class="ag-h" style="margin-bottom:4px">
            <div class="av" id="sf-av">M</div>
            <div><div class="ag-n" id="sf-name">Mercer</div><div class="ag-r" id="sf-role">Buying agent</div></div>
            <div class="hl"><b id="sf-health">94</b><span>health</span></div>
          </div>
          <div class="nr-s" id="sf-desc"></div>
        </div>
        <div class="stagecards" id="sf-stages"></div>
      </div>
    </div>
   </div>
  </div>

  <!-- ============ ORCHESTRATOR ============ -->
  <div class="view" id="p-orch">

    <!-- ENTRY -->
    <div id="o-entry">
      <div class="entry">
        <h1>What do you need to see?</h1>
        <p class="sub">Ask in your own words, or pick what you're here for.</p>

        <div class="askbox">
          <div class="al"><i></i>Ask the orchestrator</div>
          <div class="askrow">
            <input id="askInput" placeholder="e.g. why was the $214k requisition held?" onkeydown="if(event.key==='Enter')runAsk()">
            <button class="btn pr" onclick="runAsk()">Show me</button>
          </div>
          <div class="exq">
            <button onclick="askEx('why was the $214k requisition held?')">why was the $214k held?</button>
            <button onclick="askEx('show me the damage claim')">show me the damage claim</button>
            <button onclick="askEx('what if the PR limit were higher?')">what if the limit were higher?</button>
            <button onclick="askEx('prove what happened on EX-4471')">prove what happened on EX-4471</button>
          </div>
        </div>

        <div class="ordiv">or pick a starting point</div>
        <div class="mgrid" id="mgrid"></div>
      </div>
    </div>

    <!-- WORKSPACE -->
    <div class="ws" id="o-ws" style="display:none">
      <!-- LEFT: motives + cases -->
      <aside class="pane" id="paneL">
        <div class="pane-h">
          <button class="pane-x" onclick="togglePane('L')" aria-label="Collapse panel" id="paneLx">‹</button>
          <span class="pt">What you're here for</span>
        </div>
        <div class="pane-b">
          <div class="grp-l">Motive</div>
          <div id="motiveList"></div>
          <div class="grp-l mt" id="caseListLabel">Cases</div>
          <div id="caseList"></div>
          <button class="btn w" style="margin-top:12px" onclick="backToEntry()">← Start over</button>
        </div>
      </aside>

      <!-- CENTRE: the flow -->
      <main class="stagewrap">
        <div class="canvas-h" id="canvasH"></div>
        <div class="flowscroll" id="flowScroll"></div>
      </main>

      <!-- RIGHT: actions -->
      <aside class="pane right" id="paneR">
        <div class="pane-h">
          <button class="pane-x" onclick="togglePane('R')" aria-label="Collapse panel" id="paneRx">›</button>
          <span class="pt">Actions</span>
        </div>
        <div class="pane-b" id="actionsBody"></div>
      </aside>
    </div>
  </div>
</div>

<div class="scrim" id="scrim" onclick="closeAll()"></div>
<div class="drawer" id="drawer"><button class="dr-x" onclick="closeAll()">✕</button><div id="drbody"></div></div>
<div class="modal" id="modal"><div id="modalBody"></div></div>
<div class="toast" id="toastEl"></div>

<script>
var $=function(id){return document.getElementById(id)};
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var S={p:'tower',tower:'status',filter:'all',motive:null,caseId:null,held:true,rejectMode:false,
       paused:{},proposal:null,nudged4474:false,pendingLimit:null,paneL:false,paneR:false,limit:150000,
       zoom:1,atab:'act',notes:{},vx:0,vy:12,vz:1};

/* ============ nav ============ */
document.querySelectorAll('.ptab').forEach(function(t){
  t.onclick=function(){
    S.p=t.dataset.p;
    document.querySelectorAll('.ptab').forEach(function(x){x.classList.toggle('on',x===t)});
    $('p-tower').classList.toggle('on',S.p==='tower');
    $('p-orch').classList.toggle('on',S.p==='orch');
  };
});
function towerView(v){
  S.tower=v;
  $('tv-status').classList.toggle('on',v==='status');
  $('tv-workflow').classList.toggle('on',v==='workflow');
  $('t-status').classList.toggle('on',v==='status');
  $('t-workflow').classList.toggle('on',v==='workflow');
  if(v==='workflow'&&S.filter==='all')renderVWF();
}
function agentFlow(a){towerView('workflow');wfFilter(a)}
function wfFilter(f){
  S.filter=f;
  document.querySelectorAll('.fch').forEach(function(c){c.classList.toggle('on',c.dataset.f===f)});
  $('wf-all').style.display=f==='all'?'':'none';
  $('wf-single').style.display=f==='all'?'none':'';
  if(f!=='all')renderSingle(f); else renderVWF();
}

/* ============ agents ============ */
var AG={
 mercer:{n:'Mercer',r:'Buying agent',h:94,av:'M',bg:'var(--gradient-brand)',c:'var(--mercer)',
  d:'Owns the supplier lane: lead times, promise dates, vendor data. Acts alone inside LT ≤ 15 days and < $50k exposure.',
  st:[['Detect','Watches the supplier feed and PO promise dates for changes.','EX-4479 · 3 signals from VN-2210','last: EX-4471 caught in 0.8s'],
   ['Assess','Which open orders does the change actually touch?','EX-4479 · checking 47 open POs','last: 41 of 47 slipped'],
   ['Impact','Which customers and install dates are exposed?','—','last: 3 installs at risk'],
   ['Recommend','Options costed: expedite, re-source, or absorb & notify.','—','last: absorb & notify chosen'],
   ['Decide ◇','Policy check: LT ≤15d · <$50k · conf ≥0.85 → act alone, else hold.','policy ✓ within limits','last: acted alone at 0.94'],
   ['Act','Writes lead time + PO dates to Fusion; every write verified.','EX-4471 · 41 PO dates ✓','last: hand-off HO-8831 → Iris'],
   ['Learn','Outcome vs baseline logged; detection tuned.','outcome logged ↻','last: 6.1s vs 3.5-day baseline']]},
 iris:{n:'Iris',r:'Planning agent',h:88,av:'I',bg:'var(--iris)',c:'var(--iris)',
  d:'Owns coverage and requisitions: replans DCs, raises PRs inside your $150k limit, holds anything above it.',
  st:[['Detect','Picks up handoffs and coverage signals.','—','last: HO-8831 accepted 08:14:09'],
   ['Assess','Where does cover break, and when?','EX-4480 · new coverage check','last: 3 SKUs break, day 12–15'],
