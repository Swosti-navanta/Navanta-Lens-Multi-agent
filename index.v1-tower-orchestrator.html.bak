var AGWORK={
 mercer:{head:'Watching 47 open orders on VN-2210',pill:'<span class="pill ok">on it</span>',
   m:[['89','handled'],['7','held'],['1','overridden']],bar:86,barl:'autonomy L2 · 86% to L3',
   ft:'started 4 min ago'},
 iris:{head:'A $214,000 requisition needs you',pill:'<span class="pill warn">input needed</span>',
   m:[['64','handled'],['19','held'],['4','overridden']],bar:52,barl:'autonomy L2 · holding',
   ft:'ready since 08:14'},
 christy:{head:'Credit issued, customer confirming',pill:'<span class="pill info">on track</span>',
   m:[['60','handled'],['8','held'],['1','overridden']],bar:74,barl:'autonomy L3 · widest limits',
   ft:'updated 34s ago'}};
function renderAgCards(){
  var el=$('agCards');if(!el)return;
  el.innerHTML=['mercer','iris','christy'].map(function(k){
    var g=AG[k],w=AGWORK[k],p=S.paused[k];
    var head=p?'Paused — finishing in-flight work':(k==='iris'&&!S.held?'All requisitions cleared':w.head);
    var pill=p?'<span class="pill nu">paused</span>':(k==='iris'&&!S.held?'<span class="pill ok">on it</span>':w.pill);
    var held=k==='iris'?($('iris-held')?$('iris-held').textContent:w.m[1][0]):w.m[1][0];
    return '<button class="agc'+(p?' paused':'')+'" style="--ac:'+g.c+'" id="agc-'+k+'" onclick="agentFlow(\''+k+'\')">'+
      '<span class="tab">'+g.n+' · '+g.r.split(' ')[0]+'</span>'+
      '<div class="cb">'+
        '<h4>'+head+'</h4>'+
        '<span class="stpill">'+pill+'</span>'+
        '<div class="mini">Today</div>'+
        '<div class="mrow"><div><b>'+w.m[0][0]+'</b><span>'+w.m[0][1]+'</span></div>'+
          '<div><b>'+held+'</b><span>held</span></div>'+
          '<div><b>'+w.m[2][0]+'</b><span>'+w.m[2][1]+'</span></div></div>'+
        '<div class="hbar"><i style="width:'+w.bar+'%'+(k==='christy'?';background:var(--gp-green)':'')+'"></i></div>'+
        '<div style="font-size:10.5px;color:var(--text-neutral);margin-bottom:2px">'+w.barl+'</div>'+
        '<div class="ft">'+(p?'paused':w.ft)+
          '<span class="lk" onclick="event.stopPropagation();openLimits(\''+k+'\')">Limits</span>'+
          '<span class="sw'+(p?' off':'')+'" role="switch" aria-checked="'+(!p)+'" tabindex="0" '+
            'onclick="event.stopPropagation();togglePause(\''+k+'\')" id="sw-'+k+'"></span></div>'+
      '</div></button>';
  }).join('');
  makeKeyboardReachable();
}
